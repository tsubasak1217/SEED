<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SEEDScripting</AssemblyName>
    <RootNamespace>SEED.Scripting</RootNamespace>
    <!-- UnmanagedCallersOnly を含む DLL を NativeAOT なしで使うために必要 -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <!-- hostfxr から動的ロードされるため runtimeconfig.json の生成と
         NuGet 依存 DLL（Roslyn 等）の出力ディレクトリコピーを有効化する -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- SEED.UI の既定のテーマ（W2-4。UiTheme.DefaultResourceName と一致させる） -->
    <EmbeddedResource Include="src/Api/UI/Theme/default_theme.json" LogicalName="SEED.UI.default_theme.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- ユーザースクリプト (.cs) のランタイムコンパイルに使用する -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

</Project>
