<!--
    TemplateImportWindow.xaml — テンプレートをプロジェクトへ取り込むダイアログ

    【画面構成】
      上   : ライブラリの場所とコピー先の表示
      左   : 検索ボックス + カテゴリ別のチェックボックス付きツリー
      右   : 選択内容の要約（エントリ数・依存込みファイル数・合計サイズ・衝突一覧）
             と衝突方針（既存ファイルを上書きするか）
      下   : インポート / キャンセル

    【配色】
      他のダイアログ（ComponentSelectorWindow / PackagingWindow）と同じダークテーマ。
      色はここで直接指定する（アプリ共通の暗黙スタイルがあるのは ComboBox のみ）。
-->
<Window x:Class="SEEDEditor.Templates.TemplateImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:SEEDEditor.Controls"
        Title="テンプレートをインポート"
        Width="900" Height="620"
        MinWidth="720" MinHeight="460"
        Background="#1E1E1E"
        Foreground="#CCCCCC"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded">

    <Window.Resources>

        <!-- ツリーの表示 / 非表示（検索の絞り込み）に使う -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- ボタン共通（PackagingWindow と同じ見た目） -->
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="Background"      Value="#3A3A3A"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderBrush"     Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"  Value="#555555"/>
                                <Setter Property="BorderBrush" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#686868"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 実行ボタン（アクセントカラー） -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background"  Value="#1A4A7A"/>
            <Setter Property="BorderBrush" Value="#2A5A8A"/>
            <Setter Property="Foreground"  Value="#FFFFFF"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="MinWidth"    Value="110"/>
        </Style>

        <!-- チェックボックス（既存ダイアログと同じく配色だけ揃える） -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize"   Value="11"/>
        </Style>

        <!-- 見出し -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9FBFDF"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <!-- 補足テキスト -->
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground"    Value="#888888"/>
            <Setter Property="FontSize"      Value="10"/>
            <Setter Property="TextWrapping"  Value="Wrap"/>
        </Style>

        <!-- 要約の 1 行（ラベル + 値） -->
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCDCDC"/>
            <Setter Property="FontSize"   Value="12"/>
        </Style>

        <!--
            ツリー項目（ダーク）。ProjectPanel のフォルダツリーと同じ作りにしてある。
            展開の三角はコントロールの操作部品なので、他のツリーと同じく Path で描く
            （内容を表すアイコンは FileTypeIcons 経由のベクター / PNG を使う）。
        -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="#CCCCCC"/>
            <Setter Property="Padding"     Value="1,2,4,2"/>
            <!-- 展開状態と検索の絞り込みは表示モデル（TemplateTreeNode）が持つ -->
            <Setter Property="IsExpanded"  Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Visibility"
                    Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border x:Name="RowBorder" Grid.Row="0"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Grid.Column="0"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Width="16" Height="16"
                                                  Style="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}"
                                                  Visibility="Hidden">
                                        <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 8,0 Z"
                                              Fill="#888888" Width="8" Height="5"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ToggleButton>
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1"
                                            Margin="16,0,0,0"
                                            Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Expander" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Arrow"     Property="Data"       Value="M 0,4 L 8,4 L 4,0 Z"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected"  Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RowBorder" Property="Background" Value="#22FFFFFF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            ノード 1 行のテンプレート。
            IsThreeState は False のまま bool? を割り当てることで、
            「利用者のクリックは ON/OFF の 2 状態」「一部選択(null)は表示だけ」になる。
        -->
        <HierarchicalDataTemplate x:Key="NodeTemplate" ItemsSource="{Binding Children}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          IsThreeState="False"
                          VerticalAlignment="Center"
                          Margin="0,0,5,0"/>
                <Image Grid.Column="1"
                       Source="{Binding Icon}"
                       Width="14" Height="14"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding DisplayName}"
                           Foreground="#DCDCDC" FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3"
                           Text="{Binding DetailText}"
                           Foreground="#777777" FontSize="10"
                           VerticalAlignment="Center"
                           Margin="8,0,4,0"/>
            </Grid>
        </HierarchicalDataTemplate>

    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 上: ライブラリとコピー先の表示 ───────────────── -->
        <Border Grid.Row="0" Background="#252525" BorderBrush="#3C3C3C" BorderThickness="1"
                CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="エンジンのテンプレートライブラリから、必要なものだけをプロジェクトへコピーします。"
                           Foreground="#AAAAAA" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock x:Name="LblLibraryPath" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                <TextBlock x:Name="LblAssetsPath"  Style="{StaticResource MutedText}"/>
            </StackPanel>
        </Border>

        <!-- ── 中: 左ツリー / 右要約 ───────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="320" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- 左: 検索 + ツリー -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 検索ボックス（ComponentSelectorWindow と同じ作り） -->
                <Border Grid.Row="0" Background="#252525" BorderBrush="#3F3F46" BorderThickness="1"
                        CornerRadius="2" Padding="5,4" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0"
                               Source="pack://application:,,,/resources/icons/common/search.png"
                               Width="13" Height="13"
                               VerticalAlignment="Center" Margin="0,0,5,0"
                               Opacity="0.45"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBox Grid.Column="1" x:Name="TxtSearch"
                                 Background="Transparent" Foreground="#CCCCCC"
                                 CaretBrush="White" BorderThickness="0" FontSize="12"
                                 TextChanged="OnSearchChanged">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  VerticalAlignment="Center"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollBarVisibility="Hidden"/>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- カテゴリ別ツリー -->
                <Border Grid.Row="1" Background="#1A1A1A" BorderBrush="#3C3C3C" BorderThickness="1">
                    <TreeView x:Name="TreeCategories"
                              Background="Transparent" BorderThickness="0"
                              Foreground="#CCCCCC"
                              ItemTemplate="{StaticResource NodeTemplate}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"     Color="Transparent"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"       Color="Transparent"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                        </TreeView.Resources>
                    </TreeView>
                </Border>

                <!-- ツリー下の補助操作 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="BtnClearSelection" Content="選択をすべて解除"
                            Style="{StaticResource DialogButton}" Height="24" Padding="10,0"
                            Click="OnClearSelection"/>
                    <TextBlock x:Name="LblLibraryState" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                          HorizontalAlignment="Stretch"/>

            <!-- 右: 要約 -->
            <Border Grid.Column="2" Background="#232323" BorderBrush="#3C3C3C" BorderThickness="1"
                    CornerRadius="3" Padding="10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 件数の要約 -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="インポート内容" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="LblSelectedCount" Style="{StaticResource SummaryValue}"/>
                        <TextBlock x:Name="LblFileCount"     Style="{StaticResource SummaryValue}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="LblTotalSize"     Style="{StaticResource SummaryValue}" Margin="0,2,0,0"/>
                        <TextBlock Text="依存（参照しているシェーダ・テクスチャ等）を含めた数です。"
                                   Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                        <Border Height="1" Background="#333333" Margin="0,8,0,8"/>
                    </StackPanel>

                    <!-- 衝突一覧・欠落参照 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel x:Name="PanelConflicts" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ctrl:AppIcon IconKey="Icon.Warning" Width="13" Height="13"
                                                  Foreground="#E0B060" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LblConflictHeader"
                                               Foreground="#E0B060" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <ItemsControl x:Name="ListConflicts">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#BBBBBB" FontSize="10"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="PanelMissing" Visibility="Collapsed" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ctrl:AppIcon IconKey="Icon.Error" Width="13" Height="13"
                                                  Foreground="#E08080" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LblMissingHeader"
                                               Foreground="#E08080" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <ItemsControl x:Name="ListMissing">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#BBBBBB" FontSize="10"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- インポート結果（実行後に表示する） -->
                            <StackPanel x:Name="PanelResult" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock Text="インポート結果" Style="{StaticResource SectionHeader}"/>
                                <TextBlock x:Name="LblResult" Foreground="#9FDF9F" FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 衝突方針 -->
                    <StackPanel Grid.Row="2">
                        <Border Height="1" Background="#333333" Margin="0,8,0,8"/>
                        <CheckBox x:Name="ChkOverwrite"
                                  Content="既存ファイルを上書きする"
                                  Checked="OnOverwriteChanged" Unchecked="OnOverwriteChanged"/>
                        <TextBlock x:Name="LblOverwriteHint" Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ── 下: 実行ボタン ───────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="LblStatus" Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnImport" Content="インポート"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="False"
                        Click="OnImport"/>
                <Button x:Name="BtnCancel" Content="キャンセル"
                        Style="{StaticResource DialogButton}"
                        IsCancel="True" Margin="8,0,0,0"
                        Click="OnCancel"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
