<!--
    TemplateActorPickerWindow.xaml — テンプレートアクタを選んでシーンへ追加する小さなツール窓

    【画面構成】
      上   : 追加先（右クリックした場所）と検索欄（入力のたびに部分一致で絞り込む）
      左   : カテゴリの木（「すべて」＋ 2 段。件数は検索語に当たる数）
      右   : 一覧（サムネイルの枠 ＋ 名前 ＋ 説明 ＋ カテゴリと 2D/3D。選択中を強調）
      下   : 状態の行（「追加しました: 名前」など）と「追加」「閉じる」

    【振る舞い】
      モードレス。追加しても閉じないので、続けて次を選べる。
      ダブルクリック・Enter でも追加、Esc で閉じる。

    【配色】
      ダイアログの共通色（Theme/SeedDialogTheme）を x:Static で参照する。
      ボタンは共通書式（Seed.Button.Dialog / DialogPrimary）に寸法だけ足す（docs/editor_ui_style.md）。
      一覧の選択行・ホバー行は既定の ListBoxItem に任せない（選択行の文字が読めなくなるため）。
-->
<Window x:Class="SEEDEditor.Templates.Actors.TemplateActorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:SEEDEditor.Theme"
        xmlns:local="clr-namespace:SEEDEditor.Templates.Actors"
        Title="テンプレートアクタを追加"
        Width="800" Height="560"
        MinWidth="560" MinHeight="380"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Background="{x:Static theme:SeedDialogTheme.Background}"
        Foreground="{x:Static theme:SeedDialogTheme.Text}"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded"
        Closed="OnClosed"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>

        <!-- ボタン共通（見た目はボタン共通書式に従う。寸法だけ足す）-->
        <Style x:Key="DialogButton" TargetType="Button"
               BasedOn="{StaticResource Seed.Button.Dialog}">
            <Setter Property="Height"   Value="28"/>
            <Setter Property="Padding"  Value="16,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- 追加（主操作。アクセント色は共通書式が持つ）-->
        <Style x:Key="PrimaryButton" TargetType="Button"
               BasedOn="{StaticResource Seed.Button.DialogPrimary}">
            <Setter Property="Height"     Value="28"/>
            <Setter Property="Padding"    Value="16,0"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinWidth"   Value="110"/>
        </Style>

        <!-- 補足の文字 -->
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{x:Static theme:SeedDialogTheme.DimText}"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!--
            左の木の行（ダーク）。テンプレートのインポート画面と同じ作りに、
            選択行の強調（一覧の選択行と同じ色）を足したもの。
        -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{x:Static theme:SeedDialogTheme.Text}"/>
            <Setter Property="Padding"    Value="1,3,4,3"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border x:Name="RowBorder" Grid.Row="0"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 折りたたみトグル（App.xaml の共通の三角） -->
                                    <ToggleButton x:Name="Expander" Grid.Column="0"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Style="{StaticResource TreeExpanderToggleStyle}"
                                                  Visibility="Hidden"/>
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1"
                                            Margin="14,0,0,0"
                                            Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Expander" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected"  Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RowBorder" Property="Background"
                                        Value="{x:Static theme:SeedDialogTheme.ListHoverBg}"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background"
                                        Value="{x:Static theme:SeedDialogTheme.ListSelectionBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左の木の 1 行: 名前 ＋ 件数 -->
        <HierarchicalDataTemplate x:Key="CategoryTemplate" ItemsSource="{Binding Children}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="10"
                           Foreground="{x:Static theme:SeedDialogTheme.DimText}"
                           VerticalAlignment="Center" Margin="8,0,2,0"/>
            </Grid>
        </HierarchicalDataTemplate>

        <!-- 一覧の行の見た目（通常・ホバー・選択）。文字色は一覧から継ぐ -->
        <Style x:Key="ActorRowContainer" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ToolTip" Value="{Binding RowToolTip}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="6,4" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- ホバーより選択を後に置く（同時に成立したときは選択色を採る）-->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{x:Static theme:SeedDialogTheme.ListHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{x:Static theme:SeedDialogTheme.ListSelectionBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 一覧の 1 行: サムネイルの枠 ＋ 名前・説明・カテゴリ -->
        <DataTemplate x:Key="ActorRowTemplate" DataType="{x:Type local:TemplateActorListItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- サムネイルの枠（画像が無ければ灰色の板に頭文字）-->
                <Border Grid.Column="0"
                        Width="{x:Static local:TemplateActorPickerWindow.ThumbnailDisplaySize}"
                        Height="{x:Static local:TemplateActorPickerWindow.ThumbnailDisplaySize}"
                        CornerRadius="4" ClipToBounds="True"
                        Background="{x:Static local:TemplateActorPickerWindow.PlaceholderBackground}"
                        ToolTip="{Binding ThumbnailHint}"
                        VerticalAlignment="Top" Margin="0,0,10,0">
                    <Grid>
                        <TextBlock Text="{Binding Initial}"
                                   FontSize="{x:Static local:TemplateActorPickerWindow.PlaceholderInitialFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{x:Static local:TemplateActorPickerWindow.PlaceholderForeground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding PlaceholderVisibility}"/>
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Description}" FontSize="11"
                               Foreground="{x:Static theme:SeedDialogTheme.DimText}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="{x:Static local:TemplateActorPickerWindow.DescriptionMaxHeight}"
                               Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Detail}" FontSize="10"
                               Foreground="{x:Static theme:SeedDialogTheme.DimText}"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 上: 追加先 ─────────────────────────────────── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock DockPanel.Dock="Left" Text="追加先:" Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock x:Name="LblTarget" FontSize="12" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <!-- ── 上: 検索欄（テンプレートのインポート画面と同じ作り）──────── -->
        <Border Grid.Row="1"
                Background="{x:Static theme:SeedDialogTheme.Field}"
                BorderBrush="{x:Static theme:SeedDialogTheme.FieldBorder}" BorderThickness="1"
                CornerRadius="2" Padding="5,4" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0"
                       Source="pack://application:,,,/resources/icons/common/search.png"
                       Width="13" Height="13"
                       VerticalAlignment="Center" Margin="0,0,5,0"
                       Opacity="0.45"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <!-- 検索欄が空のときだけ出す案内（入力を邪魔しないよう当たり判定を持たない）-->
                <TextBlock Grid.Column="1" x:Name="LblSearchHint"
                           Text="名前・説明・検索語で絞り込み（例: ぼたん / slider / グラフ）"
                           Style="{StaticResource MutedText}" FontSize="12"
                           VerticalAlignment="Center" Margin="2,0,0,0"
                           IsHitTestVisible="False"/>
                <TextBox Grid.Column="1" x:Name="TxtSearch"
                         Background="Transparent"
                         Foreground="{x:Static theme:SeedDialogTheme.Text}"
                         CaretBrush="{x:Static theme:SeedDialogTheme.Text}"
                         BorderThickness="0" FontSize="12"
                         ToolTip="名前・説明・検索語・パスの部分一致（大文字小文字・全角半角・かなの区別なし。空白で区切ると全部を含むもの）"
                         TextChanged="OnSearchChanged"
                         PreviewKeyDown="OnSearchPreviewKeyDown">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
            </Grid>
        </Border>

        <!-- ── 中: 左のカテゴリ / 右の一覧 ─────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" MinWidth="140"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{x:Static theme:SeedDialogTheme.Field}"
                    BorderBrush="{x:Static theme:SeedDialogTheme.FieldBorder}" BorderThickness="1">
                <TreeView x:Name="TreeCategories"
                          Background="Transparent" BorderThickness="0"
                          ItemTemplate="{StaticResource CategoryTemplate}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectedItemChanged="OnCategorySelected">
                    <TreeView.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"     Color="Transparent"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"       Color="Transparent"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                    </TreeView.Resources>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                          HorizontalAlignment="Stretch"/>

            <Border Grid.Column="2"
                    Background="{x:Static theme:SeedDialogTheme.Field}"
                    BorderBrush="{x:Static theme:SeedDialogTheme.FieldBorder}" BorderThickness="1">
                <Grid>
                    <ListBox x:Name="ListActors"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{x:Static theme:SeedDialogTheme.Text}"
                             ItemTemplate="{StaticResource ActorRowTemplate}"
                             ItemContainerStyle="{StaticResource ActorRowContainer}"
                             SelectionMode="Single"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             SelectionChanged="OnActorSelectionChanged"
                             MouseDoubleClick="OnActorDoubleClick"
                             PreviewKeyDown="OnListPreviewKeyDown"/>
                    <!-- 一覧が空のときの案内（検索に何も当たらない・カタログが無い）-->
                    <TextBlock x:Name="LblEmpty" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" Margin="16"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ── 下: 状態の行とボタン ───────────────────────────── -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- 状態の行は 1 行に収め、全文はツールチップに出す（コピーしたファイルの一覧などで長くなる）-->
            <TextBlock x:Name="LblStatus" Grid.Column="0" Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" Margin="0,0,10,0"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnAdd" Content="追加"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="False"
                        ToolTipService.ShowOnDisabled="True"
                        Click="OnAdd"/>
                <Button x:Name="BtnClose" Content="閉じる"
                        Style="{StaticResource DialogButton}"
                        Margin="8,0,0,0"
                        Click="OnCloseClicked"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
