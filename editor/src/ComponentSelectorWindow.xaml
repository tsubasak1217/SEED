<Window x:Class="SEEDEditor.ComponentSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="コンポーネントを追加"
        Width="340" Height="380"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Loaded="OnLoaded"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"               Value="#252525"/>
            <Setter Property="Foreground"               Value="#CCCCCC"/>
            <Setter Property="CaretBrush"               Value="White"/>
            <Setter Property="BorderBrush"              Value="#3F3F46"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="6,5"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryHeader" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#888888"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="8,6,8,2"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding"  Value="16,5"/>
            <Setter Property="Cursor"   Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 検索バー（アイコン + TextBox 一体型） -->
        <Border Grid.Row="0" Background="#1E1E1E"
                BorderBrush="#3C3C3C" BorderThickness="0,0,0,1"
                Padding="8,5">
            <Border Background="#252525" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="2"
                    Padding="5,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0"
                           Source="pack://application:,,,/resources/icons/common/search.png"
                           Width="13" Height="13"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"
                           Opacity="0.45"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBox Grid.Column="1" x:Name="TxtSearch"
                             Background="Transparent"
                             Foreground="#CCCCCC"
                             CaretBrush="White"
                             BorderThickness="0"
                             FontSize="12"
                             TextChanged="OnSearchChanged">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Hidden"/>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>
            </Border>
        </Border>

        <!-- コンポーネント一覧 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="CategoryList" Margin="0,4,0,4"/>
        </ScrollViewer>

        <!-- 区切り線 -->
        <Border Grid.Row="2" Background="#333333"/>

        <!-- 名前フィールド -->
        <Grid Grid.Row="3" Margin="8,5,8,4">
            <!-- キー操作（Enter で追加・Esc で閉じる・↑↓ で一覧選択）は
                 ウィンドウの PreviewKeyDown に集約しているため個別ハンドラは持たない。 -->
            <TextBox x:Name="TbName"
                     Style="{StaticResource DarkTextBox}"/>
        </Grid>

        <!-- ボタン行（右寄せ） -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="8,0,8,8">
            <Button x:Name="BtnConfirm"
                    Content="追加"
                    Background="#1A4A7A" Foreground="White"
                    BorderBrush="#2A5A8A"
                    Style="{StaticResource ActionButton}"
                    IsEnabled="False"
                    Click="OnConfirm"/>
            <Button x:Name="BtnCancel"
                    Content="キャンセル"
                    Background="#2A2A2A" Foreground="#AAAAAA"
                    BorderBrush="#444444"
                    Style="{StaticResource ActionButton}"
                    IsCancel="True"
                    Margin="6,0,0,0"
                    Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
