<Window
    x:Class="SEEDEditor.InputMap.InputMapEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="InputMap エディタ"
    Width="900" Height="560"
    MinWidth="600" MinHeight="360"
    Background="#1E1E1E"
    Foreground="#CCCCCC"
    WindowStartupLocation="CenterOwner"
    Loaded="OnLoaded">

    <Window.Resources>

        <!-- ComboBox / ComboBoxItem の配色はアプリ共通のダークテーマ暗黙スタイル（App.xaml）に任せる -->

        <!-- 共通ボタンスタイル -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height"          Value="26"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Background"      Value="#3A3A3A"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderBrush"     Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#686868"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <!-- ─── ツールバー ─────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#252525" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                <TextBlock Text="InputMap エディタ"
                           Foreground="#888888" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="+ アクション追加"
                        Style="{StaticResource ActionBtn}"
                        Margin="0,0,6,0"
                        Click="OnAddAction"/>
                <Button Content="削除"
                        Style="{StaticResource ActionBtn}"
                        Margin="0,0,6,0"
                        Click="OnRemoveAction"
                        x:Name="BtnRemoveAction"
                        IsEnabled="False"/>
            </StackPanel>
        </Border>

        <!-- ─── メインコンテンツ ─────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="140"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左: アクション一覧 -->
            <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#252525">
                        <TextBlock Text="アクション" Foreground="#888888"
                                   FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="8,0"/>
                    </Border>
                    <ListBox x:Name="ActionList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#CCCCCC"
                             FontSize="12"
                             SelectionChanged="OnActionSelectionChanged"/>
                </Grid>
            </Border>

            <!-- スプリッター -->
            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch" Background="#2A2A2A"/>

            <!-- 右: バインディング編集エリア -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- アクション名・型編集ヘッダー -->
                <Border Grid.Row="0" Background="#252525" Padding="12,8"
                        BorderBrush="#333333" BorderThickness="0,0,0,1">
                    <Grid x:Name="ActionHeader" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="アクション名"
                                   Foreground="#888888" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" x:Name="TbActionName"
                                 Background="#2A2A2A" Foreground="#CCCCCC"
                                 BorderBrush="#444444" BorderThickness="1"
                                 Padding="4,2" FontSize="11" CaretBrush="#CCCCCC"
                                 TextChanged="OnActionNameChanged"/>
                        <TextBlock Grid.Column="3" Text="値の型"
                                   Foreground="#888888" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="4" x:Name="CbValueType"
                                  FontSize="11" Height="24"
                                  SelectionChanged="OnValueTypeChanged">
                            <ComboBoxItem Content="Bool（ボタン）"   Tag="Bool"/>
                            <ComboBoxItem Content="Axis1D（1D 軸）"  Tag="Axis1D"/>
                            <ComboBoxItem Content="Axis2D（2D 軸）"  Tag="Axis2D"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- バインディング一覧 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="BindingStack"/>
                </ScrollViewer>

                <!-- 旧: 静的なバインディング追加ボタン。現在は各バインドグループ内へ
                     インラインで「+ バインドを追加」を配置するため常に非表示（要素は
                     RefreshBindingPane が Visibility 参照するため残す）。 -->
                <Border Grid.Row="2" Background="#252525"
                        x:Name="BindingFooter" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- ─── フッター ─────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="#252525" BorderBrush="#333333" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="TbFilePath" Foreground="#555555" FontSize="10"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis"/>
                <Button Content="保存して閉じる"
                        Style="{StaticResource ActionBtn}"
                        Width="110" Margin="0,0,6,0"
                        Click="OnSave"/>
                <Button Content="キャンセル"
                        Style="{StaticResource ActionBtn}"
                        Width="80"
                        Click="OnCancel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
