<UserControl x:Class="SEEDEditor.Panels.AnimationTimeline.DopeSheetPanel"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E"
             ClipToBounds="True">
    <!--
        ドープシート本体。横スクロール可能な Canvas 1 枚に
        ルーラー・トラック行の背景・グリッド線・キーフレーム◆・プレイヘッド・
        ラバーバンド（矩形選択）をすべて手続き的に描画する
        （DopeSheetPanel.xaml.cs の Redraw 参照）。

        横方向のスクロールは ScrollViewer に任せる（HorizontalOffset が唯一の横位置状態。
        ルーラーもキーも同じ Canvas 上にあるため、定義上ずれようがない）。
        縦方向は ScrollViewer を使わず ScrollY で行だけをずらす
        （ルーラーを最上段へ固定したままトラックを送るため）。
    -->
    <ScrollViewer x:Name="Scroller"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled"
                  Background="#1E1E1E"
                  PreviewMouseWheel="OnScrollerPreviewMouseWheel">
        <Canvas x:Name="DrawCanvas"
                Background="#1E1E1E"
                MouseDown="OnCanvasMouseDown"
                MouseMove="OnCanvasMouseMove"
                MouseUp="OnCanvasMouseUp"
                MouseRightButtonDown="OnCanvasMouseRightButtonDown"/>
    </ScrollViewer>
</UserControl>
