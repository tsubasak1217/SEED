<UserControl x:Class="SEEDEditor.Panels.AnimationTimelinePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:timeline="clr-namespace:SEEDEditor.Panels.AnimationTimeline"
             Background="#1E1E1E"
             Focusable="True"
             FocusVisualStyle="{x:Null}">
    <!-- ComboBox / ComboBoxItem の配色はアプリ共通のダークテーマ暗黙スタイル（App.xaml）に任せる -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- ツールバー -->
            <RowDefinition Height="*"/>      <!-- トラックリスト + ドープシート -->
            <RowDefinition Height="Auto"/>   <!-- 値エディタ -->
        </Grid.RowDefinitions>

        <!-- ── ツールバー: クリップ選択・新規/開く/保存・再生プレビュー・duration/loop_mode ── -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="4,3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="クリップ:" Foreground="#999999" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="CmbClip" Width="140" FontSize="11" Height="22"
                          VerticalAlignment="Center"
                          SelectionChanged="OnClipComboSelectionChanged"/>

                <Button x:Name="BtnNewClip" Content="新規" Click="OnNewClip"
                        Background="#404040" Foreground="#CCCCCC" BorderThickness="0"
                        Padding="8,2" FontSize="11" Margin="6,0,0,0" Cursor="Hand"/>
                <Button x:Name="BtnOpenClip" Content="直接開く" Click="OnOpenClip"
                        Background="#404040" Foreground="#CCCCCC" BorderThickness="0"
                        Padding="8,2" FontSize="11" Margin="4,0,0,0" Cursor="Hand"/>
                <Button x:Name="BtnSaveClip" Content="保存" Click="OnSaveClip"
                        Background="#404040" Foreground="#CCCCCC" BorderThickness="0"
                        Padding="8,2" FontSize="11" Margin="4,0,0,0" Cursor="Hand"/>

                <Button x:Name="BtnPlayPause" Content="▶" Click="OnPlayPause"
                        Background="#404040" Foreground="#CCCCCC" BorderThickness="0"
                        Padding="8,2" FontSize="11" Margin="14,0,0,0" Cursor="Hand"
                        ToolTip="Edit モード中のみプレビュー再生できます"/>

                <TextBlock Text="長さ:" Foreground="#999999" FontSize="11"
                           VerticalAlignment="Center" Margin="14,0,4,0"/>
                <TextBox x:Name="TbDuration" Width="52" FontSize="11"
                         Background="#1A1A1A" Foreground="#CCCCCC" BorderBrush="#3F3F46"
                         VerticalAlignment="Center"
                         KeyDown="OnDurationKeyDown" LostFocus="OnDurationLostFocus"/>

                <TextBlock Text="ループ:" Foreground="#999999" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,4,0"/>
                <ComboBox x:Name="CmbLoopMode" Width="90" FontSize="11" Height="22"
                          VerticalAlignment="Center"
                          SelectionChanged="OnLoopModeChanged">
                    <ComboBoxItem Content="once" Tag="once"/>
                    <ComboBoxItem Content="loop" Tag="loop"/>
                    <ComboBoxItem Content="ping_pong" Tag="ping_pong"/>
                </ComboBox>

                <TextBlock x:Name="TbTitleStatus" Text="" Foreground="#E5C07B" FontSize="11"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── 本体: 左トラックリスト + 右ドープシート ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左: トラックリスト -->
            <DockPanel Grid.Column="0" Background="#232323">
                <Border DockPanel.Dock="Top" Background="#2A2A2A" Padding="4,2">
                    <StackPanel>
                        <TextBlock Text="トラック" Foreground="#999999" FontSize="11" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <ComboBox x:Name="CmbNewTrackProperty" Width="150" FontSize="10" Height="20"/>
                            <Button x:Name="BtnAddTrack" Content="+" Click="OnAddTrack"
                                    Background="#404040" Foreground="#CCCCCC" BorderThickness="0"
                                    Width="20" FontSize="11" Margin="2,0,0,0" Cursor="Hand"/>
                        </StackPanel>
                        <TextBox x:Name="TbNewTrackActorPath" Height="18" FontSize="10" Margin="0,2,0,0"
                                 Background="#1A1A1A" Foreground="#CCCCCC" BorderBrush="#3F3F46"
                                 ToolTip="対象アクターへの相対パス（空 = 自分自身）"/>
                    </StackPanel>
                </Border>
                <ListBox x:Name="LstTracks"
                         Background="#232323" BorderThickness="0" Foreground="#CCCCCC"
                         FontSize="11"
                         SelectionChanged="OnTrackListSelectionChanged"
                         KeyDown="OnTrackListKeyDown"/>
            </DockPanel>

            <!-- 右: ドープシート -->
            <timeline:DopeSheetPanel x:Name="DopeSheet" Grid.Column="1"/>

            <!-- クリップ未選択時のガイド表示（Animator 未所持アクター選択時など） -->
            <TextBlock x:Name="TbNoClipHint" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="Animator 付きアクタを選択するか、「直接開く」で .anim を開いてください"
                       Foreground="#777777" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="20"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- ── 値エディタ（選択中キーの time / value / interp）── -->
        <Border Grid.Row="2" Background="#2A2A2A" Padding="6,4"
                BorderBrush="#3A3A3A" BorderThickness="0,1,0,0">
            <StackPanel x:Name="ValueEditorHost" Orientation="Horizontal"/>
        </Border>
    </Grid>
</UserControl>
