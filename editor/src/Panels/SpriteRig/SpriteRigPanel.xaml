<UserControl x:Class="SEEDEditor.Panels.SpriteRigPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:SEEDEditor.Controls"
             Background="#1E1E1E"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             AllowDrop="True"
             Drop="OnPanelDrop"
             DragOver="OnPanelDragOver">
    <UserControl.Resources>
        <!-- 上部ツールバーのボタン共通スタイル（アイコン + テキスト併記） -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 左縦パネルのツール選択トグル共通スタイル -->
        <Style x:Key="ToolToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <!-- 選択中のツールは背景を明るくして一目で分かるようにする -->
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#0E639C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 左縦パネルの見出しラベル -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>

        <!-- 左縦パネルのチェックボックス（暗い背景で読める色に揃える） -->
        <Style x:Key="PanelCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <!-- 左縦パネルの補足説明 -->
        <Style x:Key="PanelHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <!-- 左縦パネルの一覧（ボーンリスト） -->
        <Style x:Key="PanelListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- スライダー横の数値表示 -->
        <Style x:Key="SliderValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 上部: グローバル操作 -->
            <RowDefinition Height="*"/>      <!-- 本体: 左ツールパネル + タブ -->
        </Grid.RowDefinitions>

        <!-- ── 上部ツールバー: ファイル操作と表示操作 ── -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="4,3">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnOpenImage" Style="{StaticResource ToolbarButtonStyle}"
                        Click="OnOpenImage" ToolTip="画像を開いて新しいタブで編集する">
                    <StackPanel Orientation="Horizontal">
                        <ctrl:AppIcon IconKey="Icon.SpriteRig.OpenImage" Width="12" Height="12"/>
                        <TextBlock Text="画像を開く" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnOpenMesh" Style="{StaticResource ToolbarButtonStyle}"
                        Click="OnOpenMesh" ToolTip="既存の .sprite_mesh を開いて再編集する">
                    <StackPanel Orientation="Horizontal">
                        <ctrl:AppIcon IconKey="Icon.File.SpriteMesh" Width="12" Height="12"/>
                        <TextBlock Text="メッシュを開く" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Fill="#3F3F46" Margin="4,2,8,2"/>

                <Button x:Name="BtnSave" Style="{StaticResource ToolbarButtonStyle}"
                        Click="OnSave" ToolTip="画像と同じフォルダへ .sprite_mesh を保存する">
                    <StackPanel Orientation="Horizontal">
                        <ctrl:AppIcon IconKey="Icon.Save" Width="12" Height="12"/>
                        <TextBlock Text="保存" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSaveAs" Style="{StaticResource ToolbarButtonStyle}"
                        Click="OnSaveAs" Content="名前を付けて保存" ToolTip="保存先を選んで .sprite_mesh を書き出す"/>

                <Rectangle Width="1" Fill="#3F3F46" Margin="4,2,8,2"/>

                <Button x:Name="BtnUndo" Style="{StaticResource ToolbarButtonStyle}"
                        Click="OnUndo" ToolTip="元に戻す (Ctrl+Z)">
                    <ctrl:AppIcon IconKey="Icon.Undo" Width="12" Height="12"/>
                </Button>
                <Button x:Name="BtnRedo" Style="{StaticResource ToolbarButtonStyle}"
                        Click="OnRedo" ToolTip="やり直す (Ctrl+Y)">
                    <ctrl:AppIcon IconKey="Icon.Redo" Width="12" Height="12"/>
                </Button>

                <Rectangle Width="1" Fill="#3F3F46" Margin="4,2,8,2"/>

                <ToggleButton x:Name="TogglePixelGrid" Style="{StaticResource ToolToggleStyle}"
                              Margin="0,0,4,0" Click="OnTogglePixelGrid"
                              ToolTip="ピクセルグリッドを表示する（拡大時のみ描画）">
                    <ctrl:AppIcon IconKey="Icon.SpriteRig.PixelGrid" Width="12" Height="12"/>
                </ToggleButton>
                <Button x:Name="BtnZoomFit" Style="{StaticResource ToolbarButtonStyle}"
                        Click="OnZoomFit" ToolTip="画像全体が収まるよう表示を合わせる">
                    <ctrl:AppIcon IconKey="Icon.SpriteRig.ZoomFit" Width="12" Height="12"/>
                </Button>

                <TextBlock x:Name="TbStatus" Text="" Foreground="#8A8A8A" FontSize="11"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── 本体: 左に編集ツール、右にタブ化されたキャンバス ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左縦パネル: 編集モード / ツール / 自動メッシュのパラメータ -->
            <Border Grid.Column="0" Width="204" Background="#252526"
                    BorderBrush="#3A3A3A" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="7,5,7,10">

                        <TextBlock Text="編集モード" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbEditMode" FontSize="11" Height="22"
                                  SelectionChanged="OnEditModeChanged">
                            <ComboBoxItem Content="メッシュ" IsSelected="True"/>
                            <ComboBoxItem Content="ボーン"/>
                            <ComboBoxItem Content="ウェイト"/>
                        </ComboBox>
                        <TextBlock x:Name="TbModeHint" Text="" Foreground="#E5C07B" FontSize="10"
                                   TextWrapping="Wrap" Margin="0,3,0,0" Visibility="Collapsed"/>

                        <!-- ここから下はメッシュ編集モードのときだけ出す -->
                        <StackPanel x:Name="PanelMeshTools">

                        <TextBlock Text="ツール" Style="{StaticResource SectionLabelStyle}"/>
                        <ToggleButton x:Name="ToolSelect" Style="{StaticResource ToolToggleStyle}"
                                      Click="OnToolSelected" IsChecked="True"
                                      ToolTip="頂点をクリックして選択する">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:AppIcon IconKey="Icon.Tool.Select" Width="12" Height="12"/>
                                <TextBlock Text="選択" Margin="6,0,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="ToolDrawPolygon" Style="{StaticResource ToolToggleStyle}"
                                      Click="OnToolSelected"
                                      ToolTip="クリックで輪郭を描く。始点クリックか Enter で閉じる／Esc で取り消し">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:AppIcon IconKey="Icon.SpriteRig.DrawPolygon" Width="12" Height="12"/>
                                <TextBlock Text="ポリゴン描画" Margin="6,0,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="ToolAddVertex" Style="{StaticResource ToolToggleStyle}"
                                      Click="OnToolSelected"
                                      ToolTip="輪郭の辺の上なら分割、領域の内側なら内部点として追加する">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:AppIcon IconKey="Icon.SpriteRig.AddVertex" Width="12" Height="12"/>
                                <TextBlock Text="頂点追加" Margin="6,0,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="ToolMoveVertex" Style="{StaticResource ToolToggleStyle}"
                                      Click="OnToolSelected"
                                      ToolTip="頂点をドラッグして動かす">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:AppIcon IconKey="Icon.Tool.Move" Width="12" Height="12"/>
                                <TextBlock Text="頂点移動" Margin="6,0,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="ToolDeleteVertex" Style="{StaticResource ToolToggleStyle}"
                                      Click="OnToolSelected"
                                      ToolTip="頂点をクリックして削除する（Delete キーでも可）">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:AppIcon IconKey="Icon.Delete" Width="12" Height="12"/>
                                <TextBlock Text="頂点削除" Margin="6,0,0,0"/>
                            </StackPanel>
                        </ToggleButton>

                        <TextBlock Text="自動メッシュ化" Style="{StaticResource SectionLabelStyle}"/>

                        <TextBlock Text="アルファ閾値" Foreground="#999999" FontSize="10"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="SldAlphaThreshold" Width="150" Minimum="1" Maximum="255"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    ValueChanged="OnAutoMeshParameterChanged"/>
                            <TextBlock x:Name="TbAlphaThreshold" Style="{StaticResource SliderValueStyle}"/>
                        </StackPanel>

                        <TextBlock Text="輪郭の簡略化 (px)" Foreground="#999999" FontSize="10" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="SldSimplifyTolerance" Width="150" Minimum="0" Maximum="20"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    ValueChanged="OnAutoMeshParameterChanged"/>
                            <TextBlock x:Name="TbSimplifyTolerance" Style="{StaticResource SliderValueStyle}"/>
                        </StackPanel>

                        <TextBlock Text="内部点の間隔 (px)" Foreground="#999999" FontSize="10" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="SldInteriorSpacing" Width="150" Minimum="0" Maximum="200"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="OnAutoMeshParameterChanged"/>
                            <TextBlock x:Name="TbInteriorSpacing" Style="{StaticResource SliderValueStyle}"/>
                        </StackPanel>

                        <TextBlock Text="島の最小面積 (px²)" Foreground="#999999" FontSize="10" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="SldMinIslandArea" Width="150" Minimum="0" Maximum="2000"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="OnAutoMeshParameterChanged"/>
                            <TextBlock x:Name="TbMinIslandArea" Style="{StaticResource SliderValueStyle}"/>
                        </StackPanel>

                        <Button x:Name="BtnAutoMesh" Style="{StaticResource ToolbarButtonStyle}"
                                Margin="0,7,0,3" HorizontalContentAlignment="Center"
                                Click="OnAutoMesh"
                                ToolTip="アルファから輪郭を抽出してメッシュを作り直す（既存のジオメトリは置き換わる）">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:AppIcon IconKey="Icon.SpriteRig.AutoMesh" Width="12" Height="12"/>
                                <TextBlock Text="自動メッシュ生成" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnRetriangulate" Style="{StaticResource ToolbarButtonStyle}"
                                Margin="0,0,0,3" HorizontalContentAlignment="Center"
                                Click="OnRetriangulate"
                                ToolTip="現在の輪郭と内部点から三角形だけを作り直す">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:AppIcon IconKey="Icon.SpriteRig.Retriangulate" Width="12" Height="12"/>
                                <TextBlock Text="再三角分割" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnClearMesh" Style="{StaticResource ToolbarButtonStyle}"
                                Margin="0,0,0,3" HorizontalContentAlignment="Center"
                                Click="OnClearMesh" Content="メッシュを消去"
                                ToolTip="輪郭と内部点をすべて消す（ボーンは残る）"/>

                        </StackPanel>

                        <!-- ── ボーン編集モード ── -->
                        <StackPanel x:Name="PanelBoneTools" Visibility="Collapsed">

                            <TextBlock Text="ボーンツール" Style="{StaticResource SectionLabelStyle}"/>
                            <ToggleButton x:Name="BoneToolCreate" Style="{StaticResource ToolToggleStyle}"
                                          Click="OnBoneToolSelected" IsChecked="True"
                                          ToolTip="押した位置が根元・離した位置が先端。続けて描くと先端から鎖が伸びる（Esc で連鎖終了）">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:AppIcon IconKey="Icon.SpriteRig.CreateBone" Width="12" Height="12"/>
                                    <TextBlock Text="ボーン作成" Margin="6,0,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="BoneToolSelect" Style="{StaticResource ToolToggleStyle}"
                                          Click="OnBoneToolSelected"
                                          ToolTip="関節をドラッグして移動／骨をクリックして選択（ダブルクリックで名前変更）">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:AppIcon IconKey="Icon.Tool.Select" Width="12" Height="12"/>
                                    <TextBlock Text="選択 / 移動" Margin="6,0,0,0"/>
                                </StackPanel>
                            </ToggleButton>

                            <TextBlock Text="ボーン一覧" Style="{StaticResource SectionLabelStyle}"/>
                            <ListBox x:Name="ListBones" Height="140" Style="{StaticResource PanelListStyle}"
                                     SelectionChanged="OnBoneListSelectionChanged"
                                     MouseDoubleClick="OnBoneListDoubleClick"
                                     ToolTip="階層順に並ぶ。ダブルクリックで名前を編集できる"/>

                            <TextBlock Text="名前" Foreground="#999999" FontSize="10" Margin="0,5,0,0"/>
                            <TextBox x:Name="TxtBoneName" FontSize="11" Height="22"
                                     Background="#1E1E1E" Foreground="#CCCCCC" BorderBrush="#3A3A3A"
                                     KeyDown="OnBoneNameKeyDown" LostFocus="OnBoneNameLostFocus"/>

                            <TextBlock Text="親ボーン" Foreground="#999999" FontSize="10" Margin="0,5,0,0"/>
                            <ComboBox x:Name="CmbBoneParent" FontSize="11" Height="22"
                                      SelectionChanged="OnBoneParentChanged"
                                      ToolTip="ワールド上の姿勢は変えずに階層だけを付け替える"/>

                            <Button x:Name="BtnDeleteBone" Style="{StaticResource ToolbarButtonStyle}"
                                    Margin="0,7,0,0" HorizontalContentAlignment="Center"
                                    Click="OnDeleteBone"
                                    ToolTip="選択中のボーンを削除する（子は親へ付け替わる / Delete キーでも可）">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:AppIcon IconKey="Icon.Delete" Width="12" Height="12"/>
                                    <TextBlock Text="ボーンを削除" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Style="{StaticResource PanelHintStyle}"
                                       Text="ボーン作成: ドラッグで 1 本。離した先端から続けて生やせます。Esc で連鎖終了。"/>
                        </StackPanel>

                        <!-- ── ウェイト編集モード ── -->
                        <StackPanel x:Name="PanelWeightTools" Visibility="Collapsed">

                            <TextBlock Text="対象ボーン" Style="{StaticResource SectionLabelStyle}"/>
                            <ListBox x:Name="ListWeightBones" Height="110" Style="{StaticResource PanelListStyle}"
                                     SelectionChanged="OnWeightBoneSelectionChanged"
                                     ToolTip="ヒートマップとブラシの対象になるボーン"/>

                            <TextBlock Text="自動ウェイト" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="減衰 (p)" Foreground="#999999" FontSize="10"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="SldWeightFalloff" Width="150" Minimum="0.5" Maximum="8"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True"
                                        ValueChanged="OnWeightParameterChanged"/>
                                <TextBlock x:Name="TbWeightFalloff" Style="{StaticResource SliderValueStyle}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkSuppressAcrossContour" Style="{StaticResource PanelCheckBoxStyle}"
                                      Content="輪郭をまたぐ影響を抑える" Click="OnWeightToggleChanged"
                                      ToolTip="頂点とボーンを結ぶ直線がメッシュの外を通る場合、その影響を弱める"/>
                            <CheckBox x:Name="ChkAutoWeightSelectedOnly" Style="{StaticResource PanelCheckBoxStyle}"
                                      Content="選択頂点だけに適用" Click="OnWeightToggleChanged"/>
                            <Button x:Name="BtnAutoWeight" Style="{StaticResource ToolbarButtonStyle}"
                                    Margin="0,7,0,3" HorizontalContentAlignment="Center" Click="OnAutoWeight"
                                    ToolTip="ボーン線分への距離からウェイトを割り当て直す">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:AppIcon IconKey="Icon.SpriteRig.AutoWeight" Width="12" Height="12"/>
                                    <TextBlock Text="自動ウェイト" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnResetWeights" Style="{StaticResource ToolbarButtonStyle}"
                                    Margin="0,0,0,3" HorizontalContentAlignment="Center"
                                    Click="OnResetWeights" Content="ウェイトを初期化"
                                    ToolTip="全頂点をルートボーンへ 1.0 で張り直す"/>

                            <TextBlock Text="ブラシ" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="半径 (px)" Foreground="#999999" FontSize="10"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="SldBrushRadius" Width="150" Minimum="1" Maximum="200"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="OnWeightParameterChanged"/>
                                <TextBlock x:Name="TbBrushRadius" Style="{StaticResource SliderValueStyle}"/>
                            </StackPanel>
                            <TextBlock Text="強さ" Foreground="#999999" FontSize="10" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="SldBrushStrength" Width="150" Minimum="0" Maximum="1"
                                        TickFrequency="0.01" IsSnapToTickEnabled="True"
                                        ValueChanged="OnWeightParameterChanged"/>
                                <TextBlock x:Name="TbBrushStrength" Style="{StaticResource SliderValueStyle}"/>
                            </StackPanel>
                            <TextBlock Text="モード" Foreground="#999999" FontSize="10" Margin="0,4,0,0"/>
                            <ComboBox x:Name="CmbBrushMode" FontSize="11" Height="22"
                                      SelectionChanged="OnBrushModeChanged">
                                <ComboBoxItem Content="加算" IsSelected="True"/>
                                <ComboBoxItem Content="減算"/>
                                <ComboBoxItem Content="置換"/>
                                <ComboBoxItem Content="スムーズ"/>
                            </ComboBox>

                            <TextBlock Text="表示" Style="{StaticResource SectionLabelStyle}"/>
                            <CheckBox x:Name="ChkAllBoneColors" Style="{StaticResource PanelCheckBoxStyle}"
                                      Content="全ボーンを色分け表示" Click="OnWeightToggleChanged"
                                      ToolTip="外すと選択ボーンの影響度ヒートマップ（青 → 赤）になる"/>

                            <TextBlock Text="選択頂点の影響" Style="{StaticResource SectionLabelStyle}"/>
                            <ItemsControl x:Name="ListInfluences"/>

                            <TextBlock Style="{StaticResource PanelHintStyle}"
                                       Text="左ドラッグ = 塗る / Ctrl+左 = ボーンを持ち替え / Shift+左 = 頂点を選択"/>
                        </StackPanel>

                        <TextBlock Text="情報" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="TbMeshInfo" Text="—" Foreground="#CCCCCC" FontSize="10"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右: 画像ごとの編集タブ -->
            <TabControl x:Name="TabsDocuments" Grid.Column="1"
                        Background="#1E1E1E" BorderThickness="0"
                        SelectionChanged="OnTabSelectionChanged"/>

            <!-- タブが 1 つも無いときの案内 -->
            <TextBlock x:Name="TbEmptyHint" Grid.Column="1"
                       Text="「画像を開く」か、プロジェクトパネルの画像を右クリック →「スプライトリグを作成」で始めます。&#x0a;画像をこのパネルへドラッグ＆ドロップしても開けます。"
                       Foreground="#777777" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="20"/>
        </Grid>
    </Grid>
</UserControl>
