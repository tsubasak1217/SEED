<UserControl x:Class="SEEDEditor.Panels.ProjectPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <UserControl.Resources>

        <!-- フォルダツリーの TreeViewItem スタイル（ダーク） -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="#CCCCCC"/>
            <Setter Property="Padding"     Value="1,2,4,2"/>
            <Setter Property="IsExpanded"  Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border x:Name="RowBorder" Grid.Row="0"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Grid.Column="0"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Width="16" Height="16"
                                                  Style="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}"
                                                  Visibility="Hidden">
                                        <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 8,0 Z"
                                              Fill="#888888" Width="8" Height="5"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ToggleButton>
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1"
                                            Margin="16,0,0,0"
                                            Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Expander"  Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Arrow"     Property="Data"       Value="M 0,4 L 8,4 L 4,0 Z"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#3355AAFF"/>
                                <Setter Property="Foreground"                        Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected"  Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RowBorder" Property="Background" Value="#22FFFFFF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" MinWidth="80"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── 左: フォルダツリー ──────────────────────────── -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#252525" BorderBrush="#3C3C3C" BorderThickness="0,0,0,1">
                <TextBlock Text="FOLDERS" Foreground="#666666" FontSize="10" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="8,0"/>
            </Border>

            <TreeView x:Name="FolderTree" Grid.Row="1"
                      Background="#1A1A1A" BorderThickness="0"
                      Foreground="#CCCCCC" FontSize="14"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      SelectedItemChanged="OnFolderTreeSelected">
                <TreeView.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"     Color="Transparent"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"       Color="Transparent"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                </TreeView.Resources>
            </TreeView>
        </Grid>

        <GridSplitter Grid.Column="1" Width="4" Background="#2C2C2C" HorizontalAlignment="Stretch"/>

        <!-- ── 右: ファイルグリッド ───────────────────────── -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ツールバー: 左＝フォルダタブ / 右＝新規作成ボタン -->
            <Border Grid.Row="0" Background="#252525" BorderBrush="#3C3C3C" BorderThickness="0,0,0,1">
                <Grid Margin="5,0">
                    <Grid.ColumnDefinitions>
                        <!-- タブ列（左寄せ・可変幅）。タブが増えたら横スクロールする -->
                        <ColumnDefinition Width="*"/>
                        <!-- 新規作成ボタン列（右寄せ・内容幅） -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- フォルダタブバー（中身は ProjectPanel.Tabs.cs が動的に構築する） -->
                    <ScrollViewer Grid.Column="0"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  VerticalAlignment="Center">
                        <StackPanel x:Name="TabBar" Orientation="Horizontal"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </ScrollViewer>

                    <!-- 新規作成ボタン -->
                    <Button x:Name="BtnCreate" Grid.Column="1"
                            HorizontalAlignment="Right"
                            Height="22" Padding="10,0,8,0"
                            ToolTip="新規作成" Cursor="Hand"
                            Click="OnCreateClick">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"     Value="#1E2D40"/>
                                <Setter Property="Foreground"     Value="#80BBEE"/>
                                <Setter Property="BorderBrush"    Value="#3A6A9A"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="+" FontSize="16" FontWeight="Light"
                                                               Foreground="{TemplateBinding Foreground}"
                                                               Margin="0,-1,4,0"/>
                                                    <TextBlock Text="新規作成" FontSize="11"
                                                               Foreground="{TemplateBinding Foreground}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"  Value="#2A4A6A"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#5599CC"/>
                                                    <Setter Property="Foreground"                  Value="#AADDFF"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1A3A55"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                </Grid>
            </Border>


            <!-- パンくずバー -->
            <Border Grid.Row="1" Background="#252525" BorderBrush="#3C3C3C" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 一階層戻るボタン -->
                    <Button x:Name="BtnBack" Grid.Column="0"
                            Width="26" Height="26"
                            BorderThickness="0" FontSize="13"
                            Cursor="Hand"
                            ToolTip="一階層上へ (マウスバックボタン)"
                            Click="OnBackClick">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#888888"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                                                    <Setter Property="Foreground"                 Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="#3C3C3C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="◀" FontSize="11"/>
                    </Button>

                    <!-- パス表示 -->
                    <ScrollViewer Grid.Column="1"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <TextBlock x:Name="TxtBreadcrumb"
                                   Foreground="#AAAAAA" FontSize="11"
                                   VerticalAlignment="Center" Margin="4,0"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ファイル一覧 -->
            <Grid Grid.Row="2">
                <ScrollViewer x:Name="FileScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="#1E1E1E"
                              Focusable="True">
                    <WrapPanel x:Name="FileGrid" Orientation="Horizontal" Margin="6,6,6,6"/>
                </ScrollViewer>
                <!-- ドラッグ範囲選択の矩形オーバーレイ -->
                <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
