<UserControl x:Class="SEEDEditor.Panels.ProjectPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- フォルダツリー -->
            <ColumnDefinition Width="180" MinWidth="100"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- フォルダツリー (placeholder) -->
        <TreeView Grid.Column="0" Background="#1A1A1A" BorderThickness="0"
                  Foreground="#CCCCCC" FontSize="12">
            <TreeViewItem Header="Assets" IsExpanded="True">
                <TreeViewItem Header="Models"/>
                <TreeViewItem Header="Textures"/>
                <TreeViewItem Header="Scripts"/>
                <TreeViewItem Header="Scenes"/>
            </TreeViewItem>
        </TreeView>

        <GridSplitter Grid.Column="1" Width="3" Background="#3C3C3C" HorizontalAlignment="Stretch"/>

        <!-- アセット一覧 (placeholder) -->
        <Border Grid.Column="2" Background="#1E1E1E">
            <TextBlock Text="(empty)" Foreground="#555555" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
