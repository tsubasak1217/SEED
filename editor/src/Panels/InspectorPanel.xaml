<UserControl x:Class="SEEDEditor.Panels.InspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── アクターヘッダー ── -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46"
                BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!-- アクターのアクティブ切替（Unity の SetActive 相当）。
                         非アクティブは自身と子孫が描画・更新・物理の対象外になる -->
                    <CheckBox x:Name="ActorActiveCheck"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"
                              Visibility="Collapsed"
                              ToolTip="アクターのアクティブ切替（OFF で自身と子孫を無効化）"
                              Checked="OnActorActiveChanged" Unchecked="OnActorActiveChanged"/>
                    <TextBlock x:Name="ActorNameBlock"
                               Text="選択なし"
                               VerticalAlignment="Center"
                               Foreground="#CCCCCC" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock x:Name="ActorModelBlock"
                           Text=""
                           Foreground="#666666" FontSize="11"
                           Margin="0,2,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- ── コンテンツエリア ── -->
        <Grid Grid.Row="1">
            <!-- 未選択オーバーレイ -->
            <TextBlock x:Name="NoSelectionBlock"
                       Text="選択されているオブジェクトがありません"
                       Foreground="#444444" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Margin="16"/>

            <!-- シーンモード: 単一スクロールエリア -->
            <ScrollViewer x:Name="ComponentScroll"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel x:Name="ComponentStack" Margin="0,4,0,4"/>
            </ScrollViewer>

            <!-- アクター編集モード -->
            <Grid x:Name="ActorEditGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="120" MinHeight="40"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*" MinHeight="60"/>
                </Grid.RowDefinitions>

                <!-- コンポーネント一覧（上部・スクロール可能） -->
                <Border Grid.Row="0" Background="#1A1A1A"
                        BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Padding="4,2" Background="#1E1E1E">
                            <Button x:Name="BtnAddComponent"
                                    Content="+ コンポーネントを追加"
                                    BorderThickness="1"
                                    FontSize="11" Padding="8,3"
                                    HorizontalAlignment="Stretch"
                                    Cursor="Hand"
                                    Click="OnAddComponentClicked">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background"  Value="#2A2A2A"/>
                                        <Setter Property="Foreground"  Value="#888888"/>
                                        <Setter Property="BorderBrush" Value="#444444"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="2" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#383838"/>
                                                            <Setter Property="Foreground" Value="#AAAAAA"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ComponentListStack" Margin="0,2"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- スプリッター -->
                <GridSplitter Grid.Row="1"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Height="5" Background="#333333"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              ShowsPreview="False"/>

                <!-- アコーディオン（下部・パラメータ編集） -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AccordionStack" Margin="0,2,0,8"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
