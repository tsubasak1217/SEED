<UserControl x:Class="SEEDEditor.Panels.InspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <!-- 選択中 Actor が無い場合のプレースホルダー -->
            <TextBlock Text="No selection"
                       Foreground="#555555"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,20"/>

            <!-- Transform セクション (placeholder) -->
            <Border Background="#252525" CornerRadius="3" Padding="8,6" Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="Transform" Foreground="#AAAAAA" FontSize="11"
                               FontWeight="Bold" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Pos"   Foreground="#888888" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Rot"   Foreground="#888888" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Scale" Foreground="#888888" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="—" Foreground="#555555" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="—" Foreground="#555555" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="—" Foreground="#555555" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
