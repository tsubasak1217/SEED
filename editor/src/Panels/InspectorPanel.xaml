<UserControl x:Class="SEEDEditor.Panels.InspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── アクターヘッダー ── -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46"
                BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel>
                <!-- 1 行目: 左側にアクターの状態トグル＋名前、右端にインスペクタのロック -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <!-- アクターのアクティブ切替（Unity の SetActive 相当）。
                             非アクティブは自身と子孫が描画・更新・物理の対象外になる -->
                        <CheckBox x:Name="ActorActiveCheck"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"
                                  Visibility="Collapsed"
                                  ToolTip="アクターのアクティブ切替（OFF で自身と子孫を無効化）"
                                  Checked="OnActorActiveChanged" Unchecked="OnActorActiveChanged"/>
                        <!-- アクターの表示切替（Unity の Renderer.enabled 相当）。
                             非表示は自身と子孫の描画だけが止まり、スクリプト・物理は動き続ける。
                             中身（目アイコン）はコードビハインドが VisibilityToggle で差し込む -->
                        <ContentControl x:Name="ActorVisibleToggleHost"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0"
                                        Visibility="Collapsed"/>
                        <TextBlock x:Name="ActorNameBlock"
                                   Text="選択なし"
                                   VerticalAlignment="Center"
                                   Foreground="#CCCCCC" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <!-- インスペクタのロック（鍵アイコン）。ON の間は他のアクターを選んでも
                         表示対象を切り替えない。中身はコードビハインドが差し込む
                         （InspectorPanel.Lock.cs の RefreshInspectorLockToggle）。 -->
                    <ContentControl x:Name="InspectorLockToggleHost"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="ActorModelBlock"
                           Text=""
                           Foreground="#666666" FontSize="11"
                           Margin="0,2,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- ── コンテンツエリア ── -->
        <Grid Grid.Row="1">
            <!-- 未選択オーバーレイ -->
            <TextBlock x:Name="NoSelectionBlock"
                       Text="選択されているオブジェクトがありません"
                       Foreground="#444444" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Margin="16"/>

            <!-- シーンモード: 単一スクロールエリア -->
            <ScrollViewer x:Name="ComponentScroll"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel x:Name="ComponentStack" Margin="0,4,0,4"/>
            </ScrollViewer>

            <!-- アクター編集モード -->
            <Grid x:Name="ActorEditGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="60"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- アコーディオン（コンポーネント一覧を兼ねる。開閉ヘッダーでリネーム・削除・複製を行う） -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AccordionStack" Margin="0,2,0,8"/>
                </ScrollViewer>

                <!-- コンポーネント追加ボタン（下部・スクロール非依存で固定表示） -->
                <Border Grid.Row="1" Padding="4,2" Background="#1E1E1E"
                        BorderBrush="#3F3F46" BorderThickness="0,1,0,0">
                    <!-- 見た目はボタン共通書式（Theme/SeedButtonStyles.xaml）に従う。
                         以前はここに自前テンプレートを持ち、色も個別に決めていた。 -->
                    <Button x:Name="BtnAddComponent"
                            Content="+ コンポーネントを追加"
                            Style="{StaticResource Seed.Button.Outlined}"
                            FontSize="11" Padding="8,3"
                            HorizontalAlignment="Stretch"
                            Click="OnAddComponentClicked"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
