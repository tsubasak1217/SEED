<UserControl x:Class="SEEDEditor.Panels.InspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Actor Header ── -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46"
                BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel>
                <TextBlock x:Name="ActorNameBlock"
                           Text="選択なし"
                           Foreground="#CCCCCC" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock x:Name="ActorModelBlock"
                           Text=""
                           Foreground="#666666" FontSize="11"
                           Margin="0,2,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- ── "No selection" overlay ── -->
        <TextBlock x:Name="NoSelectionBlock"
                   Grid.Row="1"
                   Text="選択されているオブジェクトがありません"
                   Foreground="#444444" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Margin="16"/>

        <!-- ── Component area ── -->
        <ScrollViewer x:Name="ComponentScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
            <StackPanel x:Name="ComponentStack" Margin="0,4,0,4"/>
        </ScrollViewer>
    </Grid>
</UserControl>
