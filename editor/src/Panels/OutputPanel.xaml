<UserControl x:Class="SEEDEditor.Panels.OutputPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ツールバー -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="4,2">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnClear" Content="クリア" Click="OnClear"
                        Background="#404040" Foreground="#CCCCCC"
                        BorderThickness="0" Padding="10,2" FontSize="11"
                        Cursor="Hand"/>
                <Button Content="すべてコピー" Click="OnCopyAll"
                        Background="#404040" Foreground="#CCCCCC"
                        BorderThickness="0" Padding="10,2" FontSize="11"
                        Margin="4,0,0,0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!--
            RichTextBox (読み取り専用): マウス範囲選択・Ctrl+C・右クリックコピーが
            すべてネイティブで動作する。
        -->
        <RichTextBox x:Name="LogBox"
                     Grid.Row="1"
                     Background="#1E1E1E"
                     Foreground="#CCCCCC"
                     FontFamily="Consolas"
                     FontSize="11"
                     BorderThickness="0"
                     IsReadOnly="True"
                     IsDocumentEnabled="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     AcceptsReturn="False"
                     Padding="4,2">
            <RichTextBox.ContextMenu>
                <ContextMenu Background="#2D2D2D" BorderBrush="#555">
                    <MenuItem Header="コピー (Ctrl+C)"  Command="ApplicationCommands.Copy"
                              Foreground="#CCC"/>
                    <Separator/>
                    <MenuItem Header="すべてコピー"      Click="OnCopyAll"
                              Foreground="#CCC"/>
                    <MenuItem Header="クリア"            Click="OnClear"
                              Foreground="#CCC"/>
                </ContextMenu>
            </RichTextBox.ContextMenu>
        </RichTextBox>
    </Grid>
</UserControl>
