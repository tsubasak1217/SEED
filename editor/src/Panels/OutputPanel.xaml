<UserControl x:Class="SEEDEditor.Panels.OutputPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <UserControl.Resources>
        <!-- 出力フィルタ用の暗色 ComboBox（ドロップダウンもダークテーマにする） -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"        Color="#2A2A2A"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}"    Color="#CCCCCC"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"     Color="#1A4A7A"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"   Color="#CCCCCC"/>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="8,4" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A4A7A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ツールバー -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="4,2">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnClear" Content="クリア" Click="OnClear"
                        Background="#404040" Foreground="#CCCCCC"
                        BorderThickness="0" Padding="10,2" FontSize="11"
                        Cursor="Hand"/>
                <Button Content="すべてコピー" Click="OnCopyAll"
                        Background="#404040" Foreground="#CCCCCC"
                        BorderThickness="0" Padding="10,2" FontSize="11"
                        Margin="4,0,0,0" Cursor="Hand"/>

                <!-- 出力ソースのフィルタ（すべて / エンジン / ゲーム） -->
                <TextBlock Text="表示:" Foreground="#999999" FontSize="11"
                           VerticalAlignment="Center" Margin="14,0,4,0"/>
                <ComboBox x:Name="CmbFilter" Width="96" FontSize="11" Height="22"
                          VerticalAlignment="Center"
                          Background="#2A2A2A" Foreground="Black" BorderBrush="#444444"
                          SelectedIndex="0" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="すべて"/>
                    <ComboBoxItem Content="エンジン"/>
                    <ComboBoxItem Content="ゲーム"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!--
            仮想化 ListBox: 各行を 1 アイテムとして表示する。VirtualizingStackPanel により
            画面に見えている数十行だけが実体化されるため、行数や追記頻度に関係なく
            追加・トリム・スクロールが軽量に保たれる（旧 RichTextBox/FlowDocument は
            非仮想化で全ブロックを毎回レイアウトしていたため大量ログで極端に重くなっていた）。
            行選択 + Ctrl+C / コンテキストメニューでコピーできる。
        -->
        <ListBox x:Name="LogList"
                 Grid.Row="1"
                 Background="#1E1E1E"
                 BorderThickness="0"
                 FontFamily="Consolas"
                 FontSize="11"
                 Foreground="#CCCCCC"
                 SelectionMode="Extended"
                 KeyDown="OnListKeyDown"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 VirtualizingStackPanel.ScrollUnit="Pixel"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <!-- 行を詰めて表示し、選択・ホバーの色をダークテーマにする -->
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding"           Value="0"/>
                    <Setter Property="Margin"            Value="0"/>
                    <Setter Property="MinHeight"         Value="0"/>
                    <Setter Property="BorderThickness"   Value="0"/>
                    <Setter Property="Background"        Value="Transparent"/>
                    <Setter Property="Foreground"        Value="{Binding Color}"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        Padding="4,0" SnapsToDevicePixels="True">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#264F78"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}" Foreground="{Binding Color}"
                               TextWrapping="NoWrap" LineHeight="15" LineStackingStrategy="BlockLineHeight"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu Background="#2D2D2D" BorderBrush="#555">
                    <MenuItem Header="コピー (Ctrl+C)"  Click="OnCopySelected"
                              Foreground="#CCC"/>
                    <Separator/>
                    <MenuItem Header="すべてコピー"      Click="OnCopyAll"
                              Foreground="#CCC"/>
                    <MenuItem Header="クリア"            Click="OnClear"
                              Foreground="#CCC"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
    </Grid>
</UserControl>
