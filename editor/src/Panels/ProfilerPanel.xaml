<UserControl x:Class="SEEDEditor.Panels.ProfilerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <!-- ComboBox / ToggleButton の配色はアプリ共通のダークテーマ暗黙スタイル（App.xaml）に任せる -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- ツールバー -->
            <RowDefinition Height="Auto"/> <!-- フレーム時間推移グラフ -->
            <RowDefinition Height="Auto"/> <!-- 列ヘッダー（コード側で構築） -->
            <RowDefinition Height="*"/>    <!-- 階層ツリー本体 -->
        </Grid.RowDefinitions>

        <!-- ツールバー -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="4,2">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="BtnPause" Content="一時停止" Click="OnTogglePause"
                              Background="#404040" Foreground="#CCCCCC"
                              BorderThickness="0" Padding="10,2" FontSize="11"
                              Cursor="Hand"/>

                <TextBlock Text="並び順:" Foreground="#999999" FontSize="11"
                           VerticalAlignment="Center" Margin="14,0,4,0"/>
                <ComboBox x:Name="CmbSort" Width="96" FontSize="11" Height="22"
                          VerticalAlignment="Center"
                          SelectedIndex="0" SelectionChanged="OnSortChanged">
                    <ComboBoxItem Content="実行順"/>
                    <ComboBoxItem Content="合計時間順"/>
                    <ComboBoxItem Content="自己時間順"/>
                </ComboBox>

                <TextBlock x:Name="TxtSummary"
                           Foreground="#AAAAAA" FontSize="11" FontFamily="Consolas"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- フレーム時間推移グラフ（直近サンプルの折れ線 ＋ 60fps ガイドライン） -->
        <Border Grid.Row="1" Background="#181818" BorderBrush="#333333" BorderThickness="0,0,0,1"
                Height="72">
            <Canvas x:Name="GraphCanvas" SizeChanged="OnGraphSizeChanged" ClipToBounds="True"/>
        </Border>

        <!-- 階層ツリーの列ヘッダー（本体行と同じ列幅で Code-Behind が構築する） -->
        <Border x:Name="ColumnHeaderHost" Grid.Row="2"
                Background="#252525" BorderBrush="#3C3C3C" BorderThickness="0,0,0,1"/>

        <!--
            階層ツリー本体。
            横スクロールは無効にしている。有効だと行が「必要な幅」で測られ、
            HorizontalContentAlignment=Stretch が効かず、数値列の右端が階層の深さごとに
            ズレる（列ヘッダーとも一致しなくなる）。
        -->
        <TreeView x:Name="Tree" Grid.Row="3"
                  Background="#1E1E1E" BorderThickness="0"
                  Foreground="#CCCCCC" FontSize="11"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TreeView.Resources>
                <!-- 選択ハイライトをダークテーマの配色に揃える -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"        Color="#264F78"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"    Color="White"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#264F78"/>
            </TreeView.Resources>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="Background"                 Value="Transparent"/>
                    <Setter Property="Padding"                    Value="0,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>

        <!-- 未接続・データ未受信時のプレースホルダ（Tree と同じセルに重ねて最前面表示） -->
        <TextBlock x:Name="TxtPlaceholder" Grid.Row="3"
                   Text="（プロファイラは計測データを待っています）"
                   Foreground="#888888" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
