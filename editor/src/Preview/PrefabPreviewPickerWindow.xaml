<!--
    PrefabPreviewPickerWindow.xaml — プレビューするプレハブを選ぶ小さなモーダル窓（docs/editor_screen_preview.md §1）

    【画面構成】
      上   : 見出し（差し込み先。例「差し込み先: RootStack / Screens（枠つき）」）と検索欄（入力のたびに絞り込む）
      中   : 一覧（「最近使ったもの」の区切り → 「プロジェクトのプレハブ」。1 行 = ファイル名 ＋ フォルダ〈淡色〉）
      下   : 件数と「プレビュー」「キャンセル」

    【振る舞い】
      モーダル（Owner = エディタの主窓）。ダブルクリック・Enter で決定、Esc で閉じる、検索欄で ↓ を押すと一覧へ移る。
      結果は選んだプレハブの仮想パス（キャンセルは null）。一覧と検索は Preview/PrefabPreviewCatalog。

    【配色】
      テンプレートアクタの窓（Templates/Actors/TemplateActorPickerWindow.xaml）の書式に倣う。
      ダイアログの共通色（Theme/SeedDialogTheme）を x:Static で参照し、ボタンは共通書式
      （Seed.Button.Dialog / DialogPrimary）に寸法だけ足す。一覧の選択行・ホバー行は既定の ListBoxItem に任せない。
-->
<Window x:Class="SEEDEditor.Preview.PrefabPreviewPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:SEEDEditor.Theme"
        xmlns:local="clr-namespace:SEEDEditor.Preview"
        Title="プレハブをプレビュー"
        Width="560" Height="520"
        MinWidth="420" MinHeight="320"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Background="{x:Static theme:SeedDialogTheme.Background}"
        Foreground="{x:Static theme:SeedDialogTheme.Text}"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded">

    <Window.Resources>

        <!-- キャンセル（見た目はボタン共通書式に従う。寸法だけ足す）-->
        <Style x:Key="DialogButton" TargetType="Button"
               BasedOn="{StaticResource Seed.Button.Dialog}">
            <Setter Property="Height"   Value="28"/>
            <Setter Property="Padding"  Value="16,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- プレビュー（主操作。アクセント色は共通書式が持つ）-->
        <Style x:Key="PrimaryButton" TargetType="Button"
               BasedOn="{StaticResource Seed.Button.DialogPrimary}">
            <Setter Property="Height"     Value="28"/>
            <Setter Property="Padding"    Value="16,0"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinWidth"   Value="110"/>
        </Style>

        <!-- 補足の文字 -->
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{x:Static theme:SeedDialogTheme.DimText}"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 一覧の行の見た目（通常・ホバー・選択）。文字色は一覧から継ぐ -->
        <Style x:Key="PrefabRowContainer" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ToolTip" Value="{Binding RowToolTip}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="8,4" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- ホバーより選択を後に置く（同時に成立したときは選択色を採る）-->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{x:Static theme:SeedDialogTheme.ListHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{x:Static theme:SeedDialogTheme.ListSelectionBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 一覧の 1 行: ファイル名 ＋ フォルダ（淡色）-->
        <DataTemplate x:Key="PrefabRowTemplate" DataType="{x:Type local:PrefabPreviewPickerRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding FolderText}" FontSize="11"
                           Foreground="{x:Static theme:SeedDialogTheme.DimText}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </Grid>
        </DataTemplate>

        <!-- 区切り（「最近使ったもの」「プロジェクトのプレハブ」）の見出し -->
        <DataTemplate x:Key="SectionHeaderTemplate">
            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{x:Static theme:SeedDialogTheme.DimText}"
                       Margin="6,8,6,2"/>
        </DataTemplate>

    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 上: 見出し（差し込み先）──────────────────────────── -->
        <TextBlock Grid.Row="0" x:Name="LblTarget" FontSize="12"
                   TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

        <!-- ── 上: 検索欄（テンプレートアクタの窓と同じ作り）──────────── -->
        <Border Grid.Row="1"
                Background="{x:Static theme:SeedDialogTheme.Field}"
                BorderBrush="{x:Static theme:SeedDialogTheme.FieldBorder}" BorderThickness="1"
                CornerRadius="2" Padding="5,4" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0"
                       Source="pack://application:,,,/resources/icons/common/search.png"
                       Width="13" Height="13"
                       VerticalAlignment="Center" Margin="0,0,5,0"
                       Opacity="0.45"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <!-- 検索欄が空のときだけ出す案内（入力を邪魔しないよう当たり判定を持たない）-->
                <TextBlock Grid.Column="1" x:Name="LblSearchHint"
                           Text="ファイル名・フォルダで絞り込み（例: dialog / alarms edit）"
                           Style="{StaticResource MutedText}" FontSize="12"
                           VerticalAlignment="Center" Margin="2,0,0,0"
                           IsHitTestVisible="False"/>
                <TextBox Grid.Column="1" x:Name="TxtSearch"
                         Background="Transparent"
                         Foreground="{x:Static theme:SeedDialogTheme.Text}"
                         CaretBrush="{x:Static theme:SeedDialogTheme.Text}"
                         BorderThickness="0" FontSize="12"
                         ToolTip="仮想パス（フォルダ・ファイル名）の部分一致（大文字小文字の区別なし。空白で区切ると全部を含むもの）"
                         TextChanged="OnSearchChanged"
                         PreviewKeyDown="OnSearchPreviewKeyDown">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
            </Grid>
        </Border>

        <!-- ── 中: 一覧（最近使ったもの → プロジェクトのプレハブ）──────────── -->
        <Border Grid.Row="2"
                Background="{x:Static theme:SeedDialogTheme.Field}"
                BorderBrush="{x:Static theme:SeedDialogTheme.FieldBorder}" BorderThickness="1">
            <Grid>
                <ListBox x:Name="ListPrefabs"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{x:Static theme:SeedDialogTheme.Text}"
                         ItemTemplate="{StaticResource PrefabRowTemplate}"
                         ItemContainerStyle="{StaticResource PrefabRowContainer}"
                         SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         SelectionChanged="OnSelectionChanged"
                         MouseDoubleClick="OnListDoubleClick">
                    <ListBox.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource SectionHeaderTemplate}"/>
                    </ListBox.GroupStyle>
                </ListBox>
                <!-- 一覧が空のときの案内（プレハブが無い・検索に何も当たらない・読み込み中）-->
                <TextBlock x:Name="LblEmpty" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Margin="16"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ── 下: 件数とボタン ───────────────────────────────── -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblStatus" Grid.Column="0" Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" Margin="0,0,10,0"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- Enter で決定（IsDefault）・Esc で閉じる（IsCancel）-->
                <Button x:Name="BtnAccept" Content="プレビュー"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        IsEnabled="False"
                        ToolTipService.ShowOnDisabled="True"
                        Click="OnAccept"/>
                <Button x:Name="BtnCancel" Content="キャンセル"
                        Style="{StaticResource DialogButton}"
                        IsCancel="True"
                        Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
