<Window x:Class="SEEDEditor.SceneSettings.SceneSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="シーン設定"
        Width="860" Height="560" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#1E1E1E"
        Loaded="OnLoaded">

    <!-- プロジェクト設定ウィンドウ（ProjectSettingsWindow.xaml）と同じ見た目・構造を踏襲する。
         ただし変更は即時反映のため「保存して閉じる／キャンセル」のフッターは持たない。
         閉じる操作はタイトルバーの × のみ。 -->

    <Window.Resources>

        <!-- ── 設定フィールド テキストボックス スタイル ────────── -->
        <Style x:Key="SettingTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#2A2A2A"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="CaretBrush"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,3"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="RootBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Auto"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- フォーカス時にボーダーをアクセントカラーに変える -->
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="RootBd" Property="BorderBrush" Value="#3399FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 参照ボタン スタイル ──────────────────────────────── -->
        <Style x:Key="BrowseButton" TargetType="Button">
            <Setter Property="Background"      Value="#3A3A3A"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderBrush"     Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#686868"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- メインコンテンツ（左カテゴリツリー + 1px 区切り + 右設定パネル） -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 左: カテゴリパネル（固定幅） -->
            <ColumnDefinition Width="200"/>
            <!-- 縦区切り線 -->
            <ColumnDefinition Width="1"/>
            <!-- 右: 設定パネル（残り全幅） -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左: カテゴリツリー -->
        <Border Grid.Column="0" Background="#252526">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <!-- カテゴリツリーは code-behind で動的構築する -->
                <StackPanel x:Name="CategoryPanel" Margin="0,8,0,8"/>
            </ScrollViewer>
        </Border>

        <!-- 縦区切り線 -->
        <Border Grid.Column="1" Background="#3A3A3A"/>

        <!-- 右: 選択された小項目の設定パネル -->
        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <!-- 設定コンテンツは code-behind で SelectSubItem() が切り替える -->
            <ContentControl x:Name="SettingsContent" Margin="24,24,24,24"/>
        </ScrollViewer>
    </Grid>

</Window>
