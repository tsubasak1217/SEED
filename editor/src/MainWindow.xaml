<Window x:Class="SEEDEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEED Editor" Height="640" Width="960"
        Background="#1E1E1E"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing">

    <Window.Resources>
        <!-- 左ツールパネルのボタンスタイル -->
        <Style x:Key="ToolBtnStyle" TargetType="RadioButton">
            <Setter Property="Width"           Value="34"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Margin"          Value="0,0,0,4"/>
            <Setter Property="Background"      Value="#3C3C3C"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E87820"/>
                                <Setter Property="Foreground"                 Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ツールバー -->
        <ToolBar DockPanel.Dock="Top" Background="#2D2D2D" Padding="4,2">

            <!-- Play -->
            <Button x:Name="BtnPlay" Content="▶  Play" Width="80"
                    Click="OnPlay"
                    Background="#3C8C3C" Foreground="White"
                    BorderThickness="0" Padding="8,4"/>
            <Separator/>

            <!-- Pause / Resume（Play 中のみ有効） -->
            <Button x:Name="BtnPause" Content="⏸  Pause" Width="90"
                    Click="OnPause" IsEnabled="False"
                    Background="#8C7C20" Foreground="White"
                    BorderThickness="0" Padding="8,4"/>
            <Separator/>

            <!-- Stop -->
            <Button x:Name="BtnStop" Content="■  Stop" Width="80"
                    Click="OnStop" IsEnabled="False"
                    Background="#555555" Foreground="White"
                    BorderThickness="0" Padding="8,4"/>

            <Separator/>

            <!-- 設定 -->
            <Button x:Name="BtnSettings" Content="⚙" Width="28"
                    Click="OnSettings"
                    Background="#404040" Foreground="White"
                    BorderThickness="0" Padding="4,4"
                    ToolTip="Settings"/>

            <!-- 設定ポップアップ -->
            <Popup x:Name="SettingsPopup"
                   PlacementTarget="{Binding ElementName=BtnSettings}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="#2D2D2D" BorderBrush="#555555" BorderThickness="1"
                        Padding="12,8" CornerRadius="2">
                    <StackPanel>
                        <TextBlock Text="Play Settings"
                                   Foreground="#AAAAAA" FontSize="11"
                                   Margin="0,0,0,6"/>
                        <CheckBox x:Name="ChkClampCursor"
                                  Content="Play時マウスカーソルをWindowにクランプする"
                                  Foreground="White"
                                  IsChecked="False"
                                  Checked="OnClampCursorChanged"
                                  Unchecked="OnClampCursorChanged"/>
                    </StackPanel>
                </Border>
            </Popup>

            <Separator/>

            <!-- 状態表示ラベル -->
            <TextBlock x:Name="LblState"
                       Text="● EDIT" Foreground="#60C060"
                       VerticalAlignment="Center" Margin="8,0"/>
        </ToolBar>

        <!-- 左ツールパネル（Select / Move / Rotate / Scale） -->
        <Border DockPanel.Dock="Left"
                Background="#252525"
                Width="42"
                Padding="4,8,4,8">
            <StackPanel HorizontalAlignment="Center">
                <RadioButton x:Name="BtnToolSelect"
                             GroupName="EditorTools"
                             IsChecked="True"
                             Style="{StaticResource ToolBtnStyle}"
                             ToolTip="Select (Q)"
                             Click="OnToolSelect">
                    <TextBlock Text="↖" FontSize="16"/>
                </RadioButton>
                <RadioButton x:Name="BtnToolMove"
                             GroupName="EditorTools"
                             Style="{StaticResource ToolBtnStyle}"
                             ToolTip="Move (W)"
                             Click="OnToolMove">
                    <TextBlock Text="⊕" FontSize="16"/>
                </RadioButton>
                <RadioButton x:Name="BtnToolRotate"
                             GroupName="EditorTools"
                             Style="{StaticResource ToolBtnStyle}"
                             ToolTip="Rotate (E)"
                             Click="OnToolRotate">
                    <TextBlock Text="↻" FontSize="16"/>
                </RadioButton>
                <RadioButton x:Name="BtnToolScale"
                             GroupName="EditorTools"
                             Style="{StaticResource ToolBtnStyle}"
                             ToolTip="Scale (R)"
                             Click="OnToolScale">
                    <TextBlock Text="⊞" FontSize="16"/>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- ビューポート領域 -->
        <Border x:Name="ViewportBorder"
                Background="Black"
                Margin="4"/>

    </DockPanel>
</Window>
