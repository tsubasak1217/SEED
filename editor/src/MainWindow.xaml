<Window x:Class="SEEDEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avd="https://github.com/Dirkster99/AvalonDock"
        xmlns:panels="clr-namespace:SEEDEditor.Panels"
        Title="SEED Editor" Height="720" Width="1280"
        Background="#1E1E1E"
        WindowState="Maximized"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing">

    <Window.Resources>

        <!-- ── メニューバー ダークテーマ ───────────────────────── -->
        <Style TargetType="{x:Type Menu}">
            <Setter Property="Background"      Value="#2D2D2D"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="12"/>
        </Style>
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="Background"      Value="#2D2D2D"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background"  Value="#505050"/>
                    <Setter Property="Foreground"  Value="White"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground"  Value="#666666"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type Separator}">
            <Setter Property="Background" Value="#555555"/>
            <Setter Property="Margin"     Value="4,2"/>
        </Style>

        <!-- ── ダーク スクロールバー ─────────────────────────────── -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Width"      Value="8"/>
            <Setter Property="MinWidth"   Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Background="Transparent" BorderThickness="0"
                                                  IsTabStop="False" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBd" Background="#505050"
                                                        CornerRadius="3" Margin="2,1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#707070"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#909090"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Background="Transparent" BorderThickness="0"
                                                  IsTabStop="False" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width"     Value="Auto"/>
                                <Setter Property="Height"    Value="8"/>
                                <Setter Property="MinHeight" Value="8"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Playbar ボタンスタイル -->
        <Style x:Key="PlayBarBtnStyle" TargetType="Button">
            <Setter Property="Width"           Value="36"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- BdBase: ボタン固有の背景色(Play=緑/Stop=赤/Pause=透明) -->
                        <Border x:Name="BdBase"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <!-- BdHover: ホバー/プレス時のオーバーレイ -->
                            <Border x:Name="BdHover" Background="Transparent" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BdHover" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BdHover" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Viewport内ツールバーのボタンスタイル -->
        <Style x:Key="ToolBtnStyle" TargetType="RadioButton">
            <Setter Property="Width"           Value="34"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Margin"          Value="0,0,0,4"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E87820"/>
                                <Setter Property="Foreground"                 Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel>

        <!-- ── メニューバー ──────────────────────────────────────── -->
        <Menu DockPanel.Dock="Top"
              BorderThickness="0,0,0,1" BorderBrush="#3A3A3A">

            <!-- ファイル -->
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="シーンを保存(_S)"
                          InputGestureText="Ctrl+S"
                          Click="OnMenuSaveScene"/>
                <Separator/>
                <MenuItem Header="終了(_X)" Click="OnMenuExit"/>
            </MenuItem>

            <!-- 編集 -->
            <MenuItem Header="編集(_E)">
                <MenuItem Header="元に戻す(_Z)"
                          InputGestureText="Ctrl+Z"
                          Click="OnMenuUndo"/>
                <MenuItem Header="やり直し(_Y)"
                          InputGestureText="Ctrl+Y"
                          Click="OnMenuRedo"/>
                <Separator/>
                <MenuItem Header="コピー(_C)"
                          InputGestureText="Ctrl+C"
                          Click="OnMenuCopy"/>
                <MenuItem Header="貼り付け(_V)"
                          InputGestureText="Ctrl+V"
                          Click="OnMenuPaste"/>
                <Separator/>
                <MenuItem Header="削除(_D)"
                          InputGestureText="Esc"
                          Click="OnMenuDelete"/>
            </MenuItem>

            <!-- 表示 -->
            <MenuItem Header="表示(_V)" SubmenuOpened="OnViewMenuOpened">
                <MenuItem x:Name="MenuItemHierarchy"
                          Header="Hierarchy"
                          IsCheckable="True"
                          Tag="hierarchy"
                          Click="OnTogglePanel"/>
                <MenuItem x:Name="MenuItemInspector"
                          Header="Inspector"
                          IsCheckable="True"
                          Tag="inspector"
                          Click="OnTogglePanel"/>
                <MenuItem x:Name="MenuItemProject"
                          Header="Project"
                          IsCheckable="True"
                          Tag="project"
                          Click="OnTogglePanel"/>
                <MenuItem x:Name="MenuItemOutput"
                          Header="Output"
                          IsCheckable="True"
                          Tag="output"
                          Click="OnTogglePanel"/>
            </MenuItem>

        </Menu>

        <!-- ── 上部ツールバー ────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="#2D2D2D" Height="30"
                BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 中央: 状態ラベル + Play/Stop + Pause + Settings -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="LblState"
                               Text="● EDIT" Foreground="#60C060"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="BtnPlayPause"
                            Style="{StaticResource PlayBarBtnStyle}"
                            Background="#1F4A22"
                            Click="OnPlayPause"
                            ToolTip="Play / Pause / Resume">
                        <Image x:Name="ImgPlayPause"
                               Source="pack://application:,,,/resources/icons/playbar/play.png"
                               Width="18" Height="18"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                    <Button x:Name="BtnStop"
                            Style="{StaticResource PlayBarBtnStyle}"
                            Background="#4A1F1F"
                            Click="OnStop" IsEnabled="False"
                            ToolTip="Stop">
                        <Image Source="pack://application:,,,/resources/icons/playbar/stop.png"
                               Width="18" Height="18"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                    <Button x:Name="BtnSettings" Content="⚙"
                            Width="28" Height="28" Margin="6,0,0,0"
                            Click="OnSettings"
                            Background="#404040" Foreground="#AAAAAA"
                            BorderThickness="0" Padding="4"
                            ToolTip="Settings"/>
                    <Popup x:Name="SettingsPopup"
                           PlacementTarget="{Binding ElementName=BtnSettings}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="#2D2D2D" BorderBrush="#555555" BorderThickness="1"
                                Padding="12,8" CornerRadius="2">
                            <StackPanel>
                                <TextBlock Text="Play Settings"
                                           Foreground="#AAAAAA" FontSize="11"
                                           Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkClampCursor"
                                          Content="Play時マウスカーソルをWindowにクランプする"
                                          Foreground="White"
                                          IsChecked="False"
                                          Checked="OnClampCursorChanged"
                                          Unchecked="OnClampCursorChanged"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ── AvalonDock ドッキングマネージャー ───────────────────── -->
        <avd:DockingManager x:Name="DockManager"
                            Background="#1E1E1E"
                            GridSplitterWidth="4"
                            GridSplitterHeight="4">

            <avd:LayoutRoot>
                <avd:LayoutPanel Orientation="Horizontal">

                    <!-- 左パネル: Hierarchy -->
                    <avd:LayoutAnchorablePane DockWidth="220" DockMinWidth="120">
                        <avd:LayoutAnchorable Title="Hierarchy"
                                              ContentId="hierarchy"
                                              CanClose="False"
                                              CanHide="False"
                                              CanFloat="True">
                            <panels:HierarchyPanel x:Name="PanelHierarchy"/>
                        </avd:LayoutAnchorable>
                    </avd:LayoutAnchorablePane>

                    <!-- 中央: Viewport + 下に Project -->
                    <avd:LayoutPanel Orientation="Vertical">

                        <avd:LayoutDocumentPaneGroup>
                            <avd:LayoutDocumentPane>
                                <avd:LayoutDocument Title="Viewport"
                                                    ContentId="viewport"
                                                    CanClose="False"
                                                    CanFloat="False">

                                    <!--
                                        Airspace 制約 (HwndHost は WPF 要素より常に前面) のため、
                                        ツールストリップと HwndHost を別 Grid 列に分けてオーバーラップを避ける。
                                        視覚的には Viewport パネル内の左端に配置される。
                                    -->
                                    <Grid x:Name="ViewportGrid">
                                        <Grid.ColumnDefinitions>
                                            <!-- ツールストリップ列 -->
                                            <ColumnDefinition Width="44"/>
                                            <!-- Viewport 列 -->
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Viewport HWND (code-behind で ViewportHost を差し込む) -->
                                        <ContentControl Grid.Column="1"
                                                        x:Name="ViewportDocumentContent"
                                                        Background="Black"/>

                                        <!-- 起動中オーバーレイ — FIRST_FRAME 受信まで前面に表示 -->
                                        <Grid x:Name="ViewportLoadingOverlay"
                                              Grid.Column="1"
                                              Panel.ZIndex="5">
                                            <Image Source="pack://application:,,,/resources/images/blueSky_ORE.png"
                                                   Stretch="UniformToFill"/>
                                            <TextBlock x:Name="TxtViewportStatus"
                                                       Text=""
                                                       Foreground="White" FontSize="14"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,12,8">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="Black" BlurRadius="4"
                                                                      ShadowDepth="1" Opacity="0.8"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </Grid>

                                        <!-- ツールストリップ (HwndHost と列が異なるためAirspace問題なし) -->
                                        <Border Grid.Column="0"
                                                Background="#CC1C1C1C"
                                                Padding="4,10,4,10">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Direction="0"
                                                                  BlurRadius="8" Opacity="0.6"
                                                                  ShadowDepth="2"/>
                                            </Border.Effect>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Top">

                                                <RadioButton x:Name="BtnToolSelect"
                                                             GroupName="EditorTools"
                                                             IsChecked="True"
                                                             Style="{StaticResource ToolBtnStyle}"
                                                             ToolTip="Select (Q)"
                                                             Click="OnToolSelect">
                                                    <TextBlock Text="↖" FontSize="16"/>
                                                </RadioButton>

                                                <RadioButton x:Name="BtnToolMove"
                                                             GroupName="EditorTools"
                                                             Style="{StaticResource ToolBtnStyle}"
                                                             ToolTip="Move (W)"
                                                             Click="OnToolMove">
                                                    <TextBlock Text="⊕" FontSize="16"/>
                                                </RadioButton>

                                                <RadioButton x:Name="BtnToolRotate"
                                                             GroupName="EditorTools"
                                                             Style="{StaticResource ToolBtnStyle}"
                                                             ToolTip="Rotate (E)"
                                                             Click="OnToolRotate">
                                                    <TextBlock Text="↻" FontSize="16"/>
                                                </RadioButton>

                                                <RadioButton x:Name="BtnToolScale"
                                                             GroupName="EditorTools"
                                                             Style="{StaticResource ToolBtnStyle}"
                                                             ToolTip="Scale (R)"
                                                             Click="OnToolScale">
                                                    <TextBlock Text="⊞" FontSize="16"/>
                                                </RadioButton>

                                            </StackPanel>
                                        </Border>

                                    </Grid>
                                </avd:LayoutDocument>
                            </avd:LayoutDocumentPane>
                        </avd:LayoutDocumentPaneGroup>

                        <!-- 下部パネル: Project / Output -->
                        <avd:LayoutAnchorablePane DockHeight="180" DockMinHeight="80">
                            <avd:LayoutAnchorable Title="Project"
                                                  ContentId="project"
                                                  CanClose="False"
                                                  CanHide="False"
                                                  CanFloat="True">
                                <panels:ProjectPanel x:Name="PanelProject"/>
                            </avd:LayoutAnchorable>
                            <avd:LayoutAnchorable Title="Output"
                                                  ContentId="output"
                                                  CanClose="False"
                                                  CanHide="False"
                                                  CanFloat="True">
                                <panels:OutputPanel x:Name="PanelOutput"/>
                            </avd:LayoutAnchorable>
                        </avd:LayoutAnchorablePane>

                    </avd:LayoutPanel>

                    <!-- 右パネル: Inspector -->
                    <avd:LayoutAnchorablePane DockWidth="260" DockMinWidth="140">
                        <avd:LayoutAnchorable Title="Inspector"
                                              ContentId="inspector"
                                              CanClose="False"
                                              CanHide="False"
                                              CanFloat="True">
                            <panels:InspectorPanel x:Name="PanelInspector"/>
                        </avd:LayoutAnchorable>
                    </avd:LayoutAnchorablePane>

                </avd:LayoutPanel>
            </avd:LayoutRoot>

        </avd:DockingManager>

    </DockPanel>
</Window>
