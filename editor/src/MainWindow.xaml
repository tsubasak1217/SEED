<Window x:Class="SEEDEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avd="https://github.com/Dirkster99/AvalonDock"
        xmlns:panels="clr-namespace:SEEDEditor.Panels"
        Title="SEED Editor" Height="720" Width="1280"
        Background="#1E1E1E"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing">

    <Window.Resources>

        <!-- Viewport内ツールバーのボタンスタイル -->
        <Style x:Key="ToolBtnStyle" TargetType="RadioButton">
            <Setter Property="Width"           Value="34"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Margin"          Value="0,0,0,4"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E87820"/>
                                <Setter Property="Foreground"                 Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel>

        <!-- ── 上部ツールバー ────────────────────────────────────── -->
        <ToolBar DockPanel.Dock="Top" Background="#2D2D2D" Padding="4,2">

            <Button x:Name="BtnPlay" Content="▶  Play" Width="80"
                    Click="OnPlay"
                    Background="#3C8C3C" Foreground="White"
                    BorderThickness="0" Padding="8,4"/>
            <Separator/>

            <Button x:Name="BtnPause" Content="⏸  Pause" Width="90"
                    Click="OnPause" IsEnabled="False"
                    Background="#8C7C20" Foreground="White"
                    BorderThickness="0" Padding="8,4"/>
            <Separator/>

            <Button x:Name="BtnStop" Content="■  Stop" Width="80"
                    Click="OnStop" IsEnabled="False"
                    Background="#555555" Foreground="White"
                    BorderThickness="0" Padding="8,4"/>
            <Separator/>

            <Button x:Name="BtnSettings" Content="⚙" Width="28"
                    Click="OnSettings"
                    Background="#404040" Foreground="White"
                    BorderThickness="0" Padding="4,4"
                    ToolTip="Settings"/>

            <Popup x:Name="SettingsPopup"
                   PlacementTarget="{Binding ElementName=BtnSettings}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="#2D2D2D" BorderBrush="#555555" BorderThickness="1"
                        Padding="12,8" CornerRadius="2">
                    <StackPanel>
                        <TextBlock Text="Play Settings"
                                   Foreground="#AAAAAA" FontSize="11"
                                   Margin="0,0,0,6"/>
                        <CheckBox x:Name="ChkClampCursor"
                                  Content="Play時マウスカーソルをWindowにクランプする"
                                  Foreground="White"
                                  IsChecked="False"
                                  Checked="OnClampCursorChanged"
                                  Unchecked="OnClampCursorChanged"/>
                    </StackPanel>
                </Border>
            </Popup>

            <Separator/>

            <TextBlock x:Name="LblState"
                       Text="● EDIT" Foreground="#60C060"
                       VerticalAlignment="Center" Margin="8,0"/>
        </ToolBar>

        <!-- ── AvalonDock ドッキングマネージャー ───────────────────── -->
        <avd:DockingManager x:Name="DockManager"
                            Background="#1E1E1E"
                            GridSplitterWidth="4"
                            GridSplitterHeight="4">

            <avd:LayoutRoot>
                <avd:LayoutPanel Orientation="Horizontal">

                    <!-- 左パネル: Hierarchy -->
                    <avd:LayoutAnchorablePane DockWidth="220" DockMinWidth="120">
                        <avd:LayoutAnchorable Title="Hierarchy"
                                              ContentId="hierarchy"
                                              CanClose="False"
                                              CanHide="True"
                                              CanFloat="True">
                            <panels:HierarchyPanel x:Name="PanelHierarchy"/>
                        </avd:LayoutAnchorable>
                    </avd:LayoutAnchorablePane>

                    <!-- 中央: Viewport + 下に Project -->
                    <avd:LayoutPanel Orientation="Vertical">

                        <avd:LayoutDocumentPaneGroup>
                            <avd:LayoutDocumentPane>
                                <avd:LayoutDocument Title="Viewport"
                                                    ContentId="viewport"
                                                    CanClose="False"
                                                    CanFloat="False">

                                    <!--
                                        Airspace 制約 (HwndHost は WPF 要素より常に前面) のため、
                                        ツールストリップと HwndHost を別 Grid 列に分けてオーバーラップを避ける。
                                        視覚的には Viewport パネル内の左端に配置される。
                                    -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- ツールストリップ列 -->
                                            <ColumnDefinition Width="44"/>
                                            <!-- Viewport 列 -->
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Viewport HWND (code-behind で ViewportHost を差し込む) -->
                                        <ContentControl Grid.Column="1"
                                                        x:Name="ViewportDocumentContent"
                                                        Background="Black"/>

                                        <!-- ツールストリップ (HwndHost と列が異なるためAirspace問題なし) -->
                                        <Border Grid.Column="0"
                                                Background="#CC1C1C1C"
                                                Padding="4,10,4,10">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Direction="0"
                                                                  BlurRadius="8" Opacity="0.6"
                                                                  ShadowDepth="2"/>
                                            </Border.Effect>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Top">

                                                <RadioButton x:Name="BtnToolSelect"
                                                             GroupName="EditorTools"
                                                             IsChecked="True"
                                                             Style="{StaticResource ToolBtnStyle}"
                                                             ToolTip="Select (Q)"
                                                             Click="OnToolSelect">
                                                    <TextBlock Text="↖" FontSize="16"/>
                                                </RadioButton>

                                                <RadioButton x:Name="BtnToolMove"
                                                             GroupName="EditorTools"
                                                             Style="{StaticResource ToolBtnStyle}"
                                                             ToolTip="Move (W)"
                                                             Click="OnToolMove">
                                                    <TextBlock Text="⊕" FontSize="16"/>
                                                </RadioButton>

                                                <RadioButton x:Name="BtnToolRotate"
                                                             GroupName="EditorTools"
                                                             Style="{StaticResource ToolBtnStyle}"
                                                             ToolTip="Rotate (E)"
                                                             Click="OnToolRotate">
                                                    <TextBlock Text="↻" FontSize="16"/>
                                                </RadioButton>

                                                <RadioButton x:Name="BtnToolScale"
                                                             GroupName="EditorTools"
                                                             Style="{StaticResource ToolBtnStyle}"
                                                             ToolTip="Scale (R)"
                                                             Click="OnToolScale">
                                                    <TextBlock Text="⊞" FontSize="16"/>
                                                </RadioButton>

                                            </StackPanel>
                                        </Border>

                                    </Grid>
                                </avd:LayoutDocument>
                            </avd:LayoutDocumentPane>
                        </avd:LayoutDocumentPaneGroup>

                        <!-- 下部パネル: Project -->
                        <avd:LayoutAnchorablePane DockHeight="180" DockMinHeight="80">
                            <avd:LayoutAnchorable Title="Project"
                                                  ContentId="project"
                                                  CanClose="False"
                                                  CanHide="True"
                                                  CanFloat="True">
                                <panels:ProjectPanel/>
                            </avd:LayoutAnchorable>
                        </avd:LayoutAnchorablePane>

                    </avd:LayoutPanel>

                    <!-- 右パネル: Inspector -->
                    <avd:LayoutAnchorablePane DockWidth="260" DockMinWidth="140">
                        <avd:LayoutAnchorable Title="Inspector"
                                              ContentId="inspector"
                                              CanClose="False"
                                              CanHide="True"
                                              CanFloat="True">
                            <panels:InspectorPanel/>
                        </avd:LayoutAnchorable>
                    </avd:LayoutAnchorablePane>

                </avd:LayoutPanel>
            </avd:LayoutRoot>

        </avd:DockingManager>

    </DockPanel>
</Window>
