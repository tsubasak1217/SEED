<Window x:Class="SEEDEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avd="https://github.com/Dirkster99/AvalonDock"
        xmlns:panels="clr-namespace:SEEDEditor.Panels"
        xmlns:local="clr-namespace:SEEDEditor"
        Title="SEED Editor" Height="720" Width="1280"
        Background="#1E1E1E"
        WindowState="Maximized"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing"
        AllowDrop="True"
        DragOver="OnViewportDragOver"
        Drop="OnViewportDrop">

    <Window.Resources>

        <!-- ── メニューバー ダークテーマ ───────────────────────── -->
        <Style TargetType="{x:Type Menu}">
            <Setter Property="Background"      Value="#2D2D2D"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="12"/>
        </Style>

        <!-- MenuItem — Visual Studio ダークテーマ準拠
             水平余白は ContentPresenter.Margin="8,0,8,0" で固定 (トリガー依存なし)
             縦余白は Style.Setter Padding="0,6" → Bd.TemplateBinding で全ロール共通 6px -->
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="Background"      Value="#1B1B1C"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- アイコン/チェックマーク列 (Submenu のみ表示)
                                     Width=26 + 1px 右ボーダー = 計 26px
                                     テキスト左端: 26px(icon) + 6px(ContentPresenter.Margin) = 32px
                                     固定色 #1B1B1C: Transparent だと白 chrome が透過する -->
                                <Border x:Name="IconArea"
                                        Grid.Column="0"
                                        Width="26"
                                        Background="#1B1B1C"
                                        BorderBrush="#3F3F46"
                                        BorderThickness="0,0,1,0"
                                        Visibility="Collapsed">
                                    <Border x:Name="CheckBox"
                                            Width="16" Height="16"
                                            BorderBrush="#888888"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                        <Path Data="M 2,6 L 5,9 L 11,2"
                                              Stroke="White" StrokeThickness="1.5"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="False"/>
                                    </Border>
                                </Border>

                                <!-- ヘッダーテキスト
                                     TopLevel: IconArea=Collapsed(0px) + 6px = 6px indent
                                     Submenu : IconArea=26px + 6px = 32px indent (VS 準拠) -->
                                <ContentPresenter x:Name="HeaderContent"
                                                  Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  Margin="6,0,8,0"/>

                                <!-- ショートカットキー (InputGestureText が空/null の場合は Collapsed) -->
                                <TextBlock x:Name="IGT"
                                           Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="#888888"
                                           VerticalAlignment="Center"
                                           Margin="24,0,8,0"
                                           Visibility="Visible"/>

                                <!-- サブメニュー矢印 (塗りつぶし三角形、VS 準拠) -->
                                <Path x:Name="Arrow"
                                      Grid.Column="3"
                                      Data="M 0,0 L 4,3.5 L 0,7 Z"
                                      Fill="#BBBBBB"
                                      Width="8" Margin="4,0,8,0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>

                                <!-- サブメニュー ポップアップ -->
                                <Popup x:Name="PART_Popup"
                                       Grid.Column="1"
                                       IsOpen="{Binding IsSubmenuOpen,
                                           RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Bottom"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="None">
                                    <Border Background="#1B1B1C"
                                            BorderBrush="#454545"
                                            BorderThickness="1">
                                        <ScrollViewer CanContentScroll="True" MaxHeight="600">
                                            <ItemsPresenter
                                                KeyboardNavigation.TabNavigation="Cycle"
                                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- TopLevel: メニューバーに馴染む背景色のみ変更 -->
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            </Trigger>
                            <!-- Submenu: アイコン列を表示するだけ (Margin/Padding 変更不要) -->
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="IconArea" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="IconArea"   Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Arrow"      Property="Visibility" Value="Visible"/>
                                <Setter TargetName="PART_Popup" Property="Placement"  Value="Right"/>
                            </Trigger>
                            <!-- ホバー -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd"       Property="Background" Value="#3E3E40"/>
                                <Setter TargetName="IconArea" Property="Background" Value="#3E3E40"/>
                                <Setter Property="Foreground"                       Value="White"/>
                            </Trigger>
                            <!-- サブメニュー展開中 -->
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Bd"       Property="Background" Value="#3E3E40"/>
                                <Setter TargetName="IconArea" Property="Background" Value="#3E3E40"/>
                            </Trigger>
                            <!-- チェック済み -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- 無効 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                            <!-- InputGestureText が空/null の場合はショートカット列を非表示 (phantom 幅を除去) -->
                            <Trigger Property="InputGestureText" Value="">
                                <Setter TargetName="IGT" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="InputGestureText" Value="{x:Null}">
                                <Setter TargetName="IGT" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ContextMenu: VS ダークテーマ準拠 (#454545 ボーダー、chrome なし) -->
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background"      Value="#1B1B1C"/>
            <Setter Property="BorderBrush"     Value="#454545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="Padding"         Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer CanContentScroll="True" MaxHeight="600">
                                <ItemsPresenter
                                    KeyboardNavigation.TabNavigation="Cycle"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Separator}">
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Margin"     Value="26,2,0,2"/>
            <Setter Property="Height"     Value="1"/>
        </Style>

        <!-- ── ダーク スクロールバー ─────────────────────────────── -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Width"      Value="8"/>
            <Setter Property="MinWidth"   Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Background="Transparent" BorderThickness="0"
                                                  IsTabStop="False" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBd" Background="#505050"
                                                        CornerRadius="3" Margin="2,1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#707070"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#909090"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Background="Transparent" BorderThickness="0"
                                                  IsTabStop="False" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width"     Value="Auto"/>
                                <Setter Property="Height"    Value="8"/>
                                <Setter Property="MinHeight" Value="8"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 上部バー テキストボタン スタイル（プロジェクト設定など）-->
        <Style x:Key="TopBarTextBtnStyle" TargetType="Button">
            <Setter Property="Height"          Value="22"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Background"      Value="#3A3A3A"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#686868"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Playbar ボタンスタイル -->
        <Style x:Key="PlayBarBtnStyle" TargetType="Button">
            <Setter Property="Width"           Value="36"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- BdBase: ボタン固有の背景色(Play=緑/Stop=赤/Pause=透明) -->
                        <Border x:Name="BdBase"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <!-- BdHover: ホバー/プレス時のオーバーレイ -->
                            <Border x:Name="BdHover" Background="Transparent" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BdHover" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BdHover" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Viewport オプションボタンスタイル -->
        <Style x:Key="ViewportOptBtnStyle" TargetType="Button">
            <Setter Property="Width"           Value="34"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ダークスライダースタイル（青フィル）-->
        <Style x:Key="DarkSliderStyle" TargetType="Slider">
            <Setter Property="Foreground"  Value="#61AFEF"/>
            <Setter Property="Background"  Value="#333333"/>
            <Setter Property="Height"      Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#61AFEF" Height="4" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="ThumbEl" Width="12" Height="12" Fill="#61AFEF"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbEl" Property="Fill" Value="#88CCFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#444444" Height="4" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Viewport内ツールバーのボタンスタイル -->
        <Style x:Key="ToolBtnStyle" TargetType="RadioButton">
            <Setter Property="Width"           Value="34"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Margin"          Value="0,0,0,4"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E87820"/>
                                <Setter Property="Foreground"                 Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 数値入力 TextBox スタイル（スライダー横の小型入力欄）-->
        <Style x:Key="NumInputStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background"                        Value="#1A1A1A"/>
            <Setter Property="Foreground"                        Value="White"/>
            <Setter Property="BorderBrush"                       Value="#3F3F46"/>
            <Setter Property="BorderThickness"                   Value="1"/>
            <Setter Property="FontSize"                          Value="11"/>
            <Setter Property="Padding"                           Value="3,1"/>
            <Setter Property="VerticalAlignment"                 Value="Center"/>
            <Setter Property="TextAlignment"                     Value="Right"/>
            <Setter Property="Margin"                            Value="3,0,0,0"/>
            <!-- ImGui 風ドラッグ入力を有効化 -->
            <Setter Property="local:NumericDragBehavior.Enabled" Value="True"/>
        </Style>

        <!-- InspectorPanel から TryFindResource で参照されるスタイル（NumInputStyle を継承）。
             文字列・ファイルパスフィールドにも使われるためドラッグビヘイビアはここでは無効にし、
             数値フィールドはコードで個別に SetEnabled(true) する。 -->
        <Style x:Key="NumericTextBox" TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource NumInputStyle}">
            <Setter Property="local:NumericDragBehavior.Enabled" Value="False"/>
        </Style>

        <!-- ダーク Expander スタイル -->
        <Style x:Key="DarkExpanderStyle" TargetType="{x:Type Expander}">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <DockPanel>
                            <!-- ヘッダーボタン -->
                            <ToggleButton x:Name="HeaderToggle"
                                          DockPanel.Dock="Top"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          Padding="0" Background="Transparent" BorderThickness="0"
                                          HorizontalContentAlignment="Left" Cursor="Hand">
                                <ToggleButton.Style>
                                    <Style TargetType="{x:Type ToggleButton}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                    <Border Background="Transparent"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Arrow" Text="▶"
                                               Foreground="#888888" FontSize="8"
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <ContentPresenter ContentSource="Header"
                                                      TextBlock.Foreground="#AAAAAA"
                                                      TextBlock.FontSize="11"
                                                      TextBlock.FontWeight="Bold"
                                                      VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                            <!-- コンテンツ -->
                            <ContentPresenter x:Name="Content"
                                              DockPanel.Dock="Bottom"
                                              Visibility="Collapsed"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Content" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Arrow"   Property="Text"       Value="▼"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 編集時物理タイムライン Slider スタイル ──────────────── -->
        <!-- DecreaseRepeatButton / IncreaseRepeatButton を定義しないと WPF の Track が
             Thumb 位置を計算できず、Thumb が常に端に貼り付いてしまう。
             両ボタンは Opacity="0" で透明にしてクリック領域だけ確保する。 -->
        <Style x:Key="PhysicsRepeatBtnStyle" TargetType="RepeatButton">
            <Setter Property="Opacity"    Value="0"/>
            <Setter Property="Focusable"  Value="False"/>
            <Setter Property="IsTabStop"  Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PhysicsSliderStyle" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <!-- トラック背景（未再生部分） -->
                            <Border x:Name="TrackBg"
                                    Height="4" CornerRadius="2"
                                    Background="#44FFFFFF"
                                    VerticalAlignment="Center"/>
                            <!-- 再生済み部分（進捗バー）: Width は code-behind で更新する -->
                            <Border x:Name="TrackFill"
                                    Height="4" CornerRadius="2"
                                    Background="#FF44CCFF"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Width="0"/>
                            <!-- Slider トラック本体（DecreaseRepeatButton + Thumb + IncreaseRepeatButton）-->
                            <!-- DecreaseRepeatButton/IncreaseRepeatButton がないと Track が
                                 Thumb 位置を正しく計算できないため必須 -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource PhysicsRepeatBtnStyle}"
                                                  Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Width"  Value="12"/>
                                                <Setter Property="Height" Value="12"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Ellipse x:Name="Dot"
                                                                     Fill="#DDDDDD"
                                                                     Stroke="#888888"
                                                                     StrokeThickness="1"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Dot" Property="Fill" Value="#FFFFFF"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="Dot" Property="Fill" Value="#44CCFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource PhysicsRepeatBtnStyle}"
                                                  Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
    <DockPanel>

        <!-- ── メニューバー ──────────────────────────────────────── -->
        <Menu DockPanel.Dock="Top"
              BorderThickness="0,0,0,1" BorderBrush="#3A3A3A">

            <!-- ファイル -->
            <MenuItem Header="ファイル">
                <MenuItem x:Name="MenuQuickSave"
                          Header="上書き保存"
                          InputGestureText="Ctrl+S"
                          Click="OnMenuQuickSave"/>
                <MenuItem Header="名前を付けて保存..."
                          InputGestureText="Ctrl+Shift+S"
                          Click="OnMenuSaveAs"/>
                <Separator/>
                <MenuItem Header="パッケージ化..." Click="OnOpenPackaging"/>
                <Separator/>
                <MenuItem Header="終了" Click="OnMenuExit"/>
            </MenuItem>

            <!-- 編集 -->
            <MenuItem Header="編集">
                <MenuItem Header="元に戻す"
                          InputGestureText="Ctrl+Z"
                          Click="OnMenuUndo"/>
                <MenuItem Header="やり直し"
                          InputGestureText="Ctrl+Y"
                          Click="OnMenuRedo"/>
                <Separator/>
                <MenuItem Header="コピー"
                          InputGestureText="Ctrl+C"
                          Click="OnMenuCopy"/>
                <MenuItem Header="貼り付け"
                          InputGestureText="Ctrl+V"
                          Click="OnMenuPaste"/>
                <Separator/>
                <MenuItem Header="削除"
                          InputGestureText="Del / Esc"
                          Click="OnMenuDelete"/>
            </MenuItem>

            <!-- 表示 -->
            <MenuItem Header="表示" SubmenuOpened="OnViewMenuOpened">
                <MenuItem x:Name="MenuItemHierarchy"
                          Header="Hierarchy"
                          IsCheckable="True"
                          Tag="hierarchy"
                          Click="OnTogglePanel"/>
                <MenuItem x:Name="MenuItemInspector"
                          Header="Inspector"
                          IsCheckable="True"
                          Tag="inspector"
                          Click="OnTogglePanel"/>
                <MenuItem x:Name="MenuItemProject"
                          Header="Project"
                          IsCheckable="True"
                          Tag="project"
                          Click="OnTogglePanel"/>
                <MenuItem x:Name="MenuItemOutput"
                          Header="Output"
                          IsCheckable="True"
                          Tag="output"
                          Click="OnTogglePanel"/>
            </MenuItem>

        </Menu>

        <!-- ── 上部ツールバー ────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="#2D2D2D" Height="30"
                BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 右端: プロジェクト設定ボタン -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button Content="⚙ プロジェクト設定"
                            Style="{StaticResource TopBarTextBtnStyle}"
                            Click="OnOpenProjectSettings"
                            ToolTip="プロジェクト設定を開く"/>
                </StackPanel>

                <!-- 中央: 状態ラベル + Play/Stop + Pause + Settings -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="LblState"
                               Text="● EDIT" Foreground="#60C060"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="BtnPlayPause"
                            Style="{StaticResource PlayBarBtnStyle}"
                            Background="#1F4A22"
                            Click="OnPlayPause"
                            ToolTip="Play / Pause / Resume">
                        <Image x:Name="ImgPlayPause"
                               Source="pack://application:,,,/resources/icons/playbar/play.png"
                               Width="18" Height="18"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                    <Button x:Name="BtnStop"
                            Style="{StaticResource PlayBarBtnStyle}"
                            Background="#4A1F1F"
                            Click="OnStop" IsEnabled="False"
                            ToolTip="Stop">
                        <Image Source="pack://application:,,,/resources/icons/playbar/stop.png"
                               Width="18" Height="18"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                    <Button x:Name="BtnSettings" Content="⚙"
                            Width="28" Height="28" Margin="6,0,0,0"
                            Click="OnSettings"
                            Background="#404040" Foreground="#AAAAAA"
                            BorderThickness="0" Padding="4"
                            ToolTip="Settings"/>
                    <!-- FPS 表示（ランタイム側の計測値） -->
                    <TextBlock x:Name="TxtFps"
                               Text=""
                               Foreground="#88CCFF"
                               FontSize="11"
                               FontFamily="Consolas"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Visibility="Collapsed"
                               ToolTip="ランタイムFPS（0.5秒更新）"/>
                    <Popup x:Name="SettingsPopup"
                           PlacementTarget="{Binding ElementName=BtnSettings}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="#2D2D2D" BorderBrush="#555555" BorderThickness="1"
                                Padding="12,8" CornerRadius="2">
                            <StackPanel>
                                <TextBlock Text="Play Settings"
                                           Foreground="#AAAAAA" FontSize="11"
                                           Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkPlayFromStartScene"
                                          Content="開始シーンからプレイ"
                                          Foreground="White"
                                          IsChecked="False"
                                          Margin="0,0,0,4"
                                          Checked="OnPlayFromStartSceneChanged"
                                          Unchecked="OnPlayFromStartSceneChanged"
                                          ToolTip="オフ時は現在開いているシーンでプレイします"/>
                                <CheckBox x:Name="ChkClampCursor"
                                          Content="Play時マウスカーソルをWindowにクランプする"
                                          Foreground="White"
                                          IsChecked="False"
                                          Margin="0,0,0,4"
                                          Checked="OnClampCursorChanged"
                                          Unchecked="OnClampCursorChanged"/>
                                <CheckBox x:Name="ChkPlayColliderDraw"
                                          Content="実行時コライダー描画"
                                          Foreground="White"
                                          IsChecked="False"
                                          Checked="OnPlayColliderDrawChanged"
                                          Unchecked="OnPlayColliderDrawChanged"
                                          ToolTip="Play中にコライダーのワイヤーフレームを描画します。衝突中は赤色で表示されます。"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ── AvalonDock ドッキングマネージャー ───────────────────── -->
        <avd:DockingManager x:Name="DockManager"
                            Background="#1E1E1E"
                            GridSplitterWidth="4"
                            GridSplitterHeight="4">

            <avd:LayoutRoot>
                <avd:LayoutPanel Orientation="Horizontal">

                    <!-- 左パネル: Hierarchy -->
                    <avd:LayoutAnchorablePane DockWidth="220" DockMinWidth="120">
                        <avd:LayoutAnchorable Title="Hierarchy"
                                              ContentId="hierarchy"
                                              CanClose="False"
                                              CanHide="False"
                                              CanFloat="True">
                            <panels:HierarchyPanel x:Name="PanelHierarchy"/>
                        </avd:LayoutAnchorable>
                    </avd:LayoutAnchorablePane>

                    <!-- 中央: Viewport + 下に Project -->
                    <avd:LayoutPanel Orientation="Vertical">

                        <avd:LayoutDocumentPaneGroup>
                            <avd:LayoutDocumentPane>
                                <avd:LayoutDocument Title="Viewport"
                                                    ContentId="viewport"
                                                    CanClose="False"
                                                    CanFloat="False">

                                    <!--
                                        Airspace 制約 (HwndHost は WPF 要素より常に前面) のため、
                                        ツールストリップと HwndHost を別 Grid 列に分けてオーバーラップを避ける。
                                        視覚的には Viewport パネル内の左端に配置される。
                                    -->
                                    <Grid x:Name="ViewportGrid">
                                        <Grid.RowDefinitions>
                                            <!-- アクタータブバー行（タブがないときは高さ 0）-->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Viewport 本体 -->
                                            <RowDefinition Height="*"/>
                                            <!-- 編集時物理タイムライン（ツールストリップ列を除いたビューポート列にのみ表示）-->
                                            <RowDefinition x:Name="PhysicsTimelineRow" Height="0"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <!-- ツールストリップ列 -->
                                            <ColumnDefinition Width="44"/>
                                            <!-- Viewport 列 -->
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- ── アクタータブバー（Row 0, 全列スパン）────────────── -->
                                        <Border x:Name="ActorTabBar"
                                                Grid.Row="0" Grid.ColumnSpan="2"
                                                Background="#252526"
                                                BorderBrush="#3A3A3A" BorderThickness="0,0,0,1"
                                                Height="28"
                                                Visibility="Collapsed">
                                            <DockPanel>
                                                <!-- 右端固定: シーンに戻るボタン -->
                                                <Button x:Name="BtnReturnToScene"
                                                        DockPanel.Dock="Right"
                                                        Content="◀ シーンに戻る"
                                                        Height="22"
                                                        Margin="4,3"
                                                        Padding="8,0"
                                                        FontSize="11"
                                                        Foreground="#CCCCCC"
                                                        Background="#3A3A3A"
                                                        BorderBrush="#555555"
                                                        BorderThickness="1"
                                                        Cursor="Hand"
                                                        Visibility="Collapsed"
                                                        Click="OnReturnToScene">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd"
                                                                                Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="3"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsPressed" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#666666"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                    </Button>
                                                <!-- タブ一覧（横スクロール）-->
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                              VerticalScrollBarVisibility="Disabled"
                                                              Focusable="False">
                                                    <StackPanel x:Name="ActorTabsPanel" Orientation="Horizontal"/>
                                                </ScrollViewer>
                                            </DockPanel>
                                        </Border>

                                        <!-- Viewport HWND (code-behind で ViewportHost を差し込む) -->
                                        <ContentControl Grid.Row="1" Grid.Column="1"
                                                        x:Name="ViewportDocumentContent"
                                                        Background="Black"/>

                                        <!-- 起動中オーバーレイ — FIRST_FRAME 受信まで前面に表示 -->
                                        <!-- IsHitTestVisible="False": オーバーレイはクリックを透過させる。
                                             ビューポート列を覆っていても HwndHost やその下の要素が
                                             マウスイベントを受け取れるようにする。 -->
                                        <Grid x:Name="ViewportLoadingOverlay"
                                              Grid.Row="1" Grid.Column="1"
                                              Panel.ZIndex="5"
                                              IsHitTestVisible="False">
                                            <Image Source="pack://application:,,,/resources/images/blueSky_ORE.png"
                                                   Stretch="UniformToFill"/>
                                            <TextBlock x:Name="TxtViewportStatus"
                                                       Text=""
                                                       Foreground="White" FontSize="14"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,12,8">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="Black" BlurRadius="4"
                                                                      ShadowDepth="1" Opacity="0.8"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </Grid>

                                        <!-- ツールストリップ (HwndHost と列が異なるためAirspace問題なし) -->
                                        <Border Grid.Row="1" Grid.Column="0"
                                                Background="#CC1C1C1C"
                                                Padding="4,10,4,10">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Direction="0"
                                                                  BlurRadius="8" Opacity="0.6"
                                                                  ShadowDepth="2"/>
                                            </Border.Effect>
                                            <DockPanel>
                                                <!-- オプションボタン（下端固定）-->
                                                <Button x:Name="BtnViewportOptions"
                                                        DockPanel.Dock="Bottom"
                                                        Style="{StaticResource ViewportOptBtnStyle}"
                                                        ToolTip="Viewport Options"
                                                        Click="OnViewportOptions">
                                                    <TextBlock Text="⚙" FontSize="16"
                                                               Foreground="#AAAAAA"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>
                                                </Button>

                                                <!-- ツールボタン群 -->
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Top">
                                                    <RadioButton x:Name="BtnToolSelect"
                                                                 GroupName="EditorTools"
                                                                 IsChecked="True"
                                                                 Style="{StaticResource ToolBtnStyle}"
                                                                 ToolTip="Select (Q)"
                                                                 Click="OnToolSelect">
                                                        <Image Source="pack://application:,,,/resources/icons/toolbar/select.png"
                                                               Width="20" Height="20"/>
                                                    </RadioButton>

                                                    <RadioButton x:Name="BtnToolMove"
                                                                 GroupName="EditorTools"
                                                                 Style="{StaticResource ToolBtnStyle}"
                                                                 ToolTip="Move (W)"
                                                                 Click="OnToolMove">
                                                        <Image Source="pack://application:,,,/resources/icons/toolbar/translate.png"
                                                               Width="20" Height="20"/>
                                                    </RadioButton>

                                                    <RadioButton x:Name="BtnToolRotate"
                                                                 GroupName="EditorTools"
                                                                 Style="{StaticResource ToolBtnStyle}"
                                                                 ToolTip="Rotate (E)"
                                                                 Click="OnToolRotate">
                                                        <Image Source="pack://application:,,,/resources/icons/toolbar/rotate.png"
                                                               Width="20" Height="20"/>
                                                    </RadioButton>

                                                    <RadioButton x:Name="BtnToolScale"
                                                                 GroupName="EditorTools"
                                                                 Style="{StaticResource ToolBtnStyle}"
                                                                 ToolTip="Scale (R)"
                                                                 Click="OnToolScale">
                                                        <Image Source="pack://application:,,,/resources/icons/toolbar/scale.png"
                                                               Width="20" Height="20"/>
                                                    </RadioButton>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- ── 編集時物理タイムライン（Row 2, Col 1 のみ）── -->
                                        <!-- ツールストリップ列（Col 0）には表示しない。
                                             HwndHost と同じ列に重ならない行に配置するため Airspace 問題なし。 -->
                                        <Border x:Name="PhysicsTimelinePanel"
                                                Grid.Row="2" Grid.Column="1"
                                                Background="#E0141414"
                                                BorderBrush="#55AACCFF"
                                                BorderThickness="0,1,0,0"
                                                Visibility="Collapsed">
                                            <Grid Margin="8,5,8,5">
                                                <Grid.ColumnDefinitions>
                                                    <!-- 再生/停止ボタン -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- 現在時刻 -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- シークバー -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- 総フレーム表示 -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- 適用ボタン -->
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 再生/停止ボタン（▶ / ■） -->
                                                <TextBlock x:Name="TxtPhysicsPlayBtn"
                                                           Grid.Column="0"
                                                           Text="▶"
                                                           Foreground="#CCFFFFFF"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           Cursor="Hand"
                                                           Margin="0,0,8,0"
                                                           ToolTip="再生 / 停止（スペースキー）"
                                                           MouseLeftButtonDown="OnPhysicsTimerClick"/>

                                                <!-- 現在時刻表示 -->
                                                <TextBlock x:Name="TxtPhysicsTimer"
                                                           Grid.Column="1"
                                                           Text="0.00s"
                                                           Foreground="#AAFFFFFF"
                                                           FontSize="11"
                                                           FontFamily="Consolas"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"
                                                           MinWidth="42"/>

                                                <!-- シークバー（Slider） -->
                                                <Slider x:Name="SldPhysicsTimeline"
                                                        Grid.Column="2"
                                                        Minimum="0" Maximum="0" Value="0"
                                                        IsSnapToTickEnabled="True"
                                                        TickFrequency="1"
                                                        SmallChange="1"
                                                        LargeChange="10"
                                                        Style="{StaticResource PhysicsSliderStyle}"
                                                        VerticalAlignment="Center"
                                                        ValueChanged="OnPhysicsSliderValueChanged"/>

                                                <!-- 総フレーム / 総時間表示 -->
                                                <TextBlock x:Name="TxtPhysicsTotalTime"
                                                           Grid.Column="3"
                                                           Text="f0 / f0"
                                                           Foreground="#66FFFFFF"
                                                           FontSize="11"
                                                           FontFamily="Consolas"
                                                           VerticalAlignment="Center"
                                                           Margin="6,0,4,0"/>

                                                <!-- 適用ボタン（現在フレームをフレーム0として確定） -->
                                                <Border x:Name="BtnPhysicsApply"
                                                        Grid.Column="4"
                                                        Width="22" Height="22"
                                                        Background="Transparent"
                                                        BorderBrush="#44FFFFFF"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Cursor="Hand"
                                                        ToolTip="このフレームをスタート状態として適用（履歴をクリアしてフレーム0に設定）"
                                                        MouseLeftButtonDown="OnPhysicsApplyClick">
                                                    <TextBlock Text="✓"
                                                               Foreground="#88FFCC88"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Viewport オプションポップアップ -->
                                        <Popup x:Name="ViewportOptionsPopup"
                                               Grid.Row="1" Grid.Column="0"
                                               PlacementTarget="{Binding ElementName=BtnViewportOptions}"
                                               Placement="Custom"
                                               CustomPopupPlacementCallback="OnViewportPopupPlacement"
                                               StaysOpen="False"
                                               AllowsTransparency="True">
                                            <Border Background="#2A2A2A"
                                                    BorderBrush="#555555"
                                                    BorderThickness="1"
                                                    Padding="12,10"
                                                    CornerRadius="2"
                                                    MinWidth="260">
                                                <StackPanel>

                                                    <!-- ▶ カメラ -->
                                                    <Expander Header="カメラ" IsExpanded="True"
                                                              Style="{StaticResource DarkExpanderStyle}">
                                                        <StackPanel Margin="8,6,0,2">

                                                            <!-- 画角 -->
                                                            <Grid Margin="0,0,0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="52"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="52"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="画角" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center"/>
                                                                <Slider x:Name="SldFov" Grid.Column="1"
                                                                        Style="{StaticResource DarkSliderStyle}"
                                                                        Minimum="10" Maximum="120" Value="45"
                                                                        ValueChanged="OnFovChanged" VerticalAlignment="Center"/>
                                                                <TextBox x:Name="TbFovInput" Grid.Column="2" Text="45"
                                                                         Style="{StaticResource NumInputStyle}"
                                                                         KeyDown="OnSliderNumKeyDown" LostFocus="OnSliderNumLostFocus"/>
                                                            </Grid>

                                                            <!-- 描画距離 -->
                                                            <Grid Margin="0,0,0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="52"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="52"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="描画距離" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center"/>
                                                                <Slider x:Name="SldFar" Grid.Column="1"
                                                                        Style="{StaticResource DarkSliderStyle}"
                                                                        Minimum="100" Maximum="5000" Value="1000"
                                                                        ValueChanged="OnFarChanged" VerticalAlignment="Center"/>
                                                                <TextBox x:Name="TbFarInput" Grid.Column="2" Text="1000"
                                                                         Style="{StaticResource NumInputStyle}"
                                                                         KeyDown="OnSliderNumKeyDown" LostFocus="OnSliderNumLostFocus"/>
                                                            </Grid>

                                                            <!-- 速度 -->
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="52"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="52"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="速度" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center"/>
                                                                <Slider x:Name="SldCamSpeed" Grid.Column="1"
                                                                        Style="{StaticResource DarkSliderStyle}"
                                                                        Minimum="0.1" Maximum="100" Value="5"
                                                                        ValueChanged="OnCamSpeedChanged" VerticalAlignment="Center"/>
                                                                <TextBox x:Name="TbSpeedInput" Grid.Column="2" Text="5.0"
                                                                         Style="{StaticResource NumInputStyle}"
                                                                         KeyDown="OnSliderNumKeyDown" LostFocus="OnSliderNumLostFocus"/>
                                                            </Grid>

                                                            <!-- セパレーター -->
                                                            <Border Height="1" Background="#3A3A3A" Margin="0,0,0,6"/>

                                                            <!-- 位置ラベル行 -->
                                                            <Grid Margin="36,0,0,1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="X" Grid.Column="0" Foreground="#E06C75" FontSize="9" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="Y" Grid.Column="1" Foreground="#98C379" FontSize="9" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="Z" Grid.Column="2" Foreground="#61AFEF" FontSize="9" HorizontalAlignment="Center"/>
                                                            </Grid>
                                                            <!-- 位置入力行 -->
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="36"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="位置" Grid.Column="0" Foreground="#888888" FontSize="10" VerticalAlignment="Center"/>
                                                                <TextBox x:Name="TbCamPx" Grid.Column="1" Text="0"   Margin="1" Style="{StaticResource NumInputStyle}" KeyDown="OnCamFieldKeyDown" LostFocus="OnCamFieldLostFocus"/>
                                                                <TextBox x:Name="TbCamPy" Grid.Column="2" Text="2"   Margin="1" Style="{StaticResource NumInputStyle}" KeyDown="OnCamFieldKeyDown" LostFocus="OnCamFieldLostFocus"/>
                                                                <TextBox x:Name="TbCamPz" Grid.Column="3" Text="-10" Margin="1" Style="{StaticResource NumInputStyle}" KeyDown="OnCamFieldKeyDown" LostFocus="OnCamFieldLostFocus"/>
                                                            </Grid>

                                                            <!-- 回転ラベル行 -->
                                                            <Grid Margin="36,0,0,1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="X°"   Grid.Column="0" Foreground="#CCCCAA" FontSize="9" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="Y°"   Grid.Column="1" Foreground="#CCCCAA" FontSize="9" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="Z°"   Grid.Column="2" Foreground="#CCCCAA" FontSize="9" HorizontalAlignment="Center"/>
                                                            </Grid>
                                                            <!-- 回転入力行（Euler XYZ） -->
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="36"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="回転" Grid.Column="0" Foreground="#888888" FontSize="10" VerticalAlignment="Center"/>
                                                                <TextBox x:Name="TbCamEuX" Grid.Column="1" Text="0" Margin="1" Style="{StaticResource NumInputStyle}" KeyDown="OnCamFieldKeyDown" LostFocus="OnCamFieldLostFocus"/>
                                                                <TextBox x:Name="TbCamEuY" Grid.Column="2" Text="0" Margin="1" Style="{StaticResource NumInputStyle}" KeyDown="OnCamFieldKeyDown" LostFocus="OnCamFieldLostFocus"/>
                                                                <TextBox x:Name="TbCamEuZ" Grid.Column="3" Text="0" Margin="1" Style="{StaticResource NumInputStyle}" KeyDown="OnCamFieldKeyDown" LostFocus="OnCamFieldLostFocus"/>
                                                            </Grid>

                                                        </StackPanel>
                                                    </Expander>

                                                    <!-- ▶ デバッグ描画 -->
                                                    <Expander Header="デバッグ描画" IsExpanded="True"
                                                              Style="{StaticResource DarkExpanderStyle}"
                                                              Margin="0,8,0,0">
                                                        <StackPanel Margin="8,6,0,2">
                                                            <CheckBox x:Name="ChkShowGrid"
                                                                      Content="グリッド表示"
                                                                      Foreground="White" FontSize="11"
                                                                      IsChecked="True"
                                                                      Margin="0,0,0,4"
                                                                      Checked="OnShowGridChanged"
                                                                      Unchecked="OnShowGridChanged"/>
                                                            <CheckBox x:Name="ChkShowAxisGizmo"
                                                                      Content="軸ガイド表示"
                                                                      Foreground="White" FontSize="11"
                                                                      IsChecked="True"
                                                                      Checked="OnShowAxisGizmoChanged"
                                                                      Unchecked="OnShowAxisGizmoChanged"/>
                                                        </StackPanel>
                                                    </Expander>

                                                    <!-- ▶ キャンバス -->
                                                    <Expander Header="キャンバス" IsExpanded="True"
                                                              Style="{StaticResource DarkExpanderStyle}"
                                                              Margin="0,8,0,0">
                                                        <StackPanel Margin="8,6,0,2">
                                                            <CheckBox x:Name="ChkCanvasScreenSpace"
                                                                      Content="キャンバスをスクリーンスペースで表示"
                                                                      Foreground="White" FontSize="11"
                                                                      IsChecked="False"
                                                                      Margin="0,0,0,4"
                                                                      Checked="OnCanvasScreenSpaceChanged"
                                                                      Unchecked="OnCanvasScreenSpaceChanged"/>
                                                        </StackPanel>
                                                    </Expander>

                                                    <!-- ▶ 物理 -->
                                                    <Expander Header="物理" IsExpanded="True"
                                                              Style="{StaticResource DarkExpanderStyle}"
                                                              Margin="0,8,0,0">
                                                        <StackPanel Margin="8,6,0,2">
                                                            <!-- 編集時の物理シミュレーション -->
                                                            <CheckBox x:Name="ChkEditPhysics"
                                                                      Content="編集時の物理シミュレーション"
                                                                      Foreground="White" FontSize="11"
                                                                      IsChecked="False"
                                                                      Margin="0,0,0,4"
                                                                      Checked="OnEditPhysicsChanged"
                                                                      Unchecked="OnEditPhysicsChanged"/>
                                                            <!-- RigidBody サブオプション（編集時物理が有効なときのみ表示） -->
                                                            <StackPanel x:Name="PnlEditPhysicsRigidbody"
                                                                        Visibility="Collapsed"
                                                                        Margin="0,2,0,4">
                                                                <CheckBox x:Name="ChkEditPhysicsRigidbody"
                                                                          Content="RigidBody（重力・ダイナミクスを有効にする）"
                                                                          Foreground="White" FontSize="11"
                                                                          IsChecked="False"
                                                                          Margin="16,0,0,0"
                                                                          Checked="OnEditPhysicsRigidbodyChanged"
                                                                          Unchecked="OnEditPhysicsRigidbodyChanged"/>
                                                            </StackPanel>
                                                            <!-- 区切り線 -->
                                                            <Border Height="1" Background="#444444" Margin="0,4,0,6"/>
                                                            <!-- 編集時の 2D 物理シミュレーション -->
                                                            <CheckBox x:Name="ChkEditPhysics2d"
                                                                      Content="編集時の 2D 物理シミュレーション"
                                                                      Foreground="White" FontSize="11"
                                                                      IsChecked="False"
                                                                      Margin="0,0,0,4"
                                                                      Checked="OnEditPhysics2dChanged"
                                                                      Unchecked="OnEditPhysics2dChanged"/>
                                                            <!-- 2D RigidBody サブオプション（2D 物理が有効なときのみ表示） -->
                                                            <StackPanel x:Name="PnlEditPhysics2dRigidbody"
                                                                        Visibility="Collapsed"
                                                                        Margin="0,2,0,4">
                                                                <CheckBox x:Name="ChkEditPhysics2dRigidbody"
                                                                          Content="RigidBody（重力・ダイナミクスを有効にする）"
                                                                          Foreground="White" FontSize="11"
                                                                          IsChecked="False"
                                                                          Margin="16,0,0,0"
                                                                          Checked="OnEditPhysics2dRigidbodyChanged"
                                                                          Unchecked="OnEditPhysics2dRigidbodyChanged"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Expander>

                                                    <!-- デフォルトに戻す -->
                                                    <Border Height="1" Background="#444444" Margin="0,10,0,8"/>
                                                    <Button Content="デフォルトに戻す"
                                                            Click="OnResetViewportSettings"
                                                            Background="#333333"
                                                            Foreground="#AAAAAA"
                                                            BorderBrush="#555555"
                                                            BorderThickness="1"
                                                            FontSize="11"
                                                            Padding="6,4"
                                                            Cursor="Hand"
                                                            HorizontalAlignment="Right"/>

                                                </StackPanel>
                                            </Border>
                                        </Popup>

                                    </Grid>
                                </avd:LayoutDocument>
                            </avd:LayoutDocumentPane>
                        </avd:LayoutDocumentPaneGroup>

                        <!-- 下部パネル: Project / Output -->
                        <avd:LayoutAnchorablePane DockHeight="180" DockMinHeight="80">
                            <avd:LayoutAnchorable Title="Project"
                                                  ContentId="project"
                                                  CanClose="False"
                                                  CanHide="False"
                                                  CanFloat="True">
                                <panels:ProjectPanel x:Name="PanelProject"/>
                            </avd:LayoutAnchorable>
                            <avd:LayoutAnchorable Title="Output"
                                                  ContentId="output"
                                                  CanClose="False"
                                                  CanHide="False"
                                                  CanFloat="True">
                                <panels:OutputPanel x:Name="PanelOutput"/>
                            </avd:LayoutAnchorable>
                        </avd:LayoutAnchorablePane>

                    </avd:LayoutPanel>

                    <!-- 右パネル: Inspector + AI アシスタント -->
                    <avd:LayoutAnchorablePane DockWidth="300" DockMinWidth="200">
                        <avd:LayoutAnchorable Title="Inspector"
                                              ContentId="inspector"
                                              CanClose="False"
                                              CanHide="False"
                                              CanFloat="True">
                            <panels:InspectorPanel x:Name="PanelInspector"/>
                        </avd:LayoutAnchorable>
                        <avd:LayoutAnchorable Title="AI アシスタント"
                                              ContentId="ai_assistant"
                                              CanClose="False"
                                              CanHide="False"
                                              CanFloat="True">
                            <!-- コンテンツは LoadLayout の LayoutSerializationCallback で設定される -->
                        </avd:LayoutAnchorable>
                    </avd:LayoutAnchorablePane>

                </avd:LayoutPanel>
            </avd:LayoutRoot>

        </avd:DockingManager>

    </DockPanel>

    <!-- ── トースト通知（右下オーバーレイ）──────────────────── -->
    <Border x:Name="ToastBorder"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,24,24"
            Padding="14,8"
            CornerRadius="4"
            Background="#CC1E6B3A"
            BorderBrush="#44AAFFAA"
            BorderThickness="1"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            Panel.ZIndex="999">
        <TextBlock x:Name="ToastText"
                   Text="シーンを保存しました"
                   Foreground="#E0FFFFFF"
                   FontSize="12"/>
    </Border>

    </Grid>
</Window>
