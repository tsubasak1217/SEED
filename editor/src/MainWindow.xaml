<Window x:Class="SEEDEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avd="https://github.com/Dirkster99/AvalonDock"
        xmlns:panels="clr-namespace:SEEDEditor.Panels"
        xmlns:ctrl="clr-namespace:SEEDEditor.Controls"
        xmlns:local="clr-namespace:SEEDEditor"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="SEED Editor" Height="720" Width="1280"
        Background="#1E1E1E"
        WindowState="Maximized"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing"
        AllowDrop="True"
        DragOver="OnViewportDragOver"
        Drop="OnViewportDrop">

    <Window.Resources>

        <!-- ── メニューバー ダークテーマ ───────────────────────── -->
        <Style TargetType="{x:Type Menu}">
            <Setter Property="Background"      Value="#2D2D2D"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="12"/>
        </Style>

        <!-- MenuItem — Visual Studio ダークテーマ準拠
             水平余白は ContentPresenter.Margin="8,0,8,0" で固定 (トリガー依存なし)
             縦余白は Style.Setter Padding="0,6" → Bd.TemplateBinding で全ロール共通 6px -->
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="Background"      Value="#1B1B1C"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- アイコン/チェックマーク列 (Submenu のみ表示)
                                     Width=26 + 1px 右ボーダー = 計 26px
                                     テキスト左端: 26px(icon) + 6px(ContentPresenter.Margin) = 32px
                                     固定色 #1B1B1C: Transparent だと白 chrome が透過する -->
                                <Border x:Name="IconArea"
                                        Grid.Column="0"
                                        Width="26"
                                        Background="#1B1B1C"
                                        BorderBrush="#3F3F46"
                                        BorderThickness="0,0,1,0"
                                        Visibility="Collapsed">
                                    <Border x:Name="CheckBox"
                                            Width="16" Height="16"
                                            BorderBrush="#888888"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                        <Path Data="M 2,6 L 5,9 L 11,2"
                                              Stroke="White" StrokeThickness="1.5"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="False"/>
                                    </Border>
                                </Border>

                                <!-- ヘッダーテキスト
                                     TopLevel: IconArea=Collapsed(0px) + 6px = 6px indent
                                     Submenu : IconArea=26px + 6px = 32px indent (VS 準拠) -->
                                <ContentPresenter x:Name="HeaderContent"
                                                  Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  Margin="6,0,8,0"/>

                                <!-- ショートカットキー (InputGestureText が空/null の場合は Collapsed) -->
                                <TextBlock x:Name="IGT"
                                           Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="#888888"
                                           VerticalAlignment="Center"
                                           Margin="24,0,8,0"
                                           Visibility="Visible"/>

                                <!-- サブメニュー矢印 (塗りつぶし三角形、VS 準拠) -->
                                <Path x:Name="Arrow"
                                      Grid.Column="3"
                                      Data="M 0,0 L 4,3.5 L 0,7 Z"
                                      Fill="#BBBBBB"
                                      Width="8" Margin="4,0,8,0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>

                                <!-- サブメニュー ポップアップ -->
                                <Popup x:Name="PART_Popup"
                                       Grid.Column="1"
                                       IsOpen="{Binding IsSubmenuOpen,
                                           RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Bottom"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="None">
                                    <Border Background="#1B1B1C"
                                            BorderBrush="#454545"
                                            BorderThickness="1">
                                        <ScrollViewer CanContentScroll="True" MaxHeight="600">
                                            <ItemsPresenter
                                                KeyboardNavigation.TabNavigation="Cycle"
                                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- TopLevel: メニューバーに馴染む背景色のみ変更 -->
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            </Trigger>
                            <!-- Submenu: アイコン列を表示するだけ (Margin/Padding 変更不要) -->
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="IconArea" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="IconArea"   Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Arrow"      Property="Visibility" Value="Visible"/>
                                <Setter TargetName="PART_Popup" Property="Placement"  Value="Right"/>
                            </Trigger>
                            <!-- ホバー -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd"       Property="Background" Value="#3E3E40"/>
                                <Setter TargetName="IconArea" Property="Background" Value="#3E3E40"/>
                                <Setter Property="Foreground"                       Value="White"/>
                            </Trigger>
                            <!-- サブメニュー展開中 -->
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Bd"       Property="Background" Value="#3E3E40"/>
                                <Setter TargetName="IconArea" Property="Background" Value="#3E3E40"/>
                            </Trigger>
                            <!-- チェック済み -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- 無効 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                            <!-- InputGestureText が空/null の場合はショートカット列を非表示 (phantom 幅を除去) -->
                            <Trigger Property="InputGestureText" Value="">
                                <Setter TargetName="IGT" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="InputGestureText" Value="{x:Null}">
                                <Setter TargetName="IGT" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ContextMenu: VS ダークテーマ準拠 (#454545 ボーダー、chrome なし) -->
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background"      Value="#1B1B1C"/>
            <Setter Property="BorderBrush"     Value="#454545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="Padding"         Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer CanContentScroll="True" MaxHeight="600">
                                <ItemsPresenter
                                    KeyboardNavigation.TabNavigation="Cycle"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Separator}">
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Margin"     Value="26,2,0,2"/>
            <Setter Property="Height"     Value="1"/>
        </Style>

        <!-- ── ダーク スクロールバー ─────────────────────────────── -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Width"      Value="8"/>
            <Setter Property="MinWidth"   Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Background="Transparent" BorderThickness="0"
                                                  IsTabStop="False" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBd" Background="#505050"
                                                        CornerRadius="3" Margin="2,1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#707070"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#909090"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Background="Transparent" BorderThickness="0"
                                                  IsTabStop="False" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width"     Value="Auto"/>
                                <Setter Property="Height"    Value="8"/>
                                <Setter Property="MinHeight" Value="8"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 上部バー テキストボタン スタイル（プロジェクト設定など）-->
        <Style x:Key="TopBarTextBtnStyle" TargetType="Button">
            <Setter Property="Height"          Value="22"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Background"      Value="#3A3A3A"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#686868"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Playbar ボタンスタイル -->
        <Style x:Key="PlayBarBtnStyle" TargetType="Button">
            <Setter Property="Width"           Value="36"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- BdBase: ボタン固有の背景色(Play=緑/Stop=赤/Pause=透明) -->
                        <Border x:Name="BdBase"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <!-- BdHover: ホバー/プレス時のオーバーレイ -->
                            <Border x:Name="BdHover" Background="Transparent" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BdHover" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BdHover" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Viewport オプションボタンスタイル -->
        <Style x:Key="ViewportOptBtnStyle" TargetType="Button">
            <Setter Property="Width"           Value="34"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ダークスライダースタイル（青フィル）-->
        <Style x:Key="DarkSliderStyle" TargetType="Slider">
            <Setter Property="Foreground"  Value="#61AFEF"/>
            <Setter Property="Background"  Value="#333333"/>
            <Setter Property="Height"      Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#61AFEF" Height="4" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="ThumbEl" Width="12" Height="12" Fill="#61AFEF"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbEl" Property="Fill" Value="#88CCFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#444444" Height="4" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Viewport内ツールバーのボタンスタイル -->
        <Style x:Key="ToolBtnStyle" TargetType="RadioButton">
            <Setter Property="Width"           Value="34"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Margin"          Value="0,0,0,4"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E87820"/>
                                <Setter Property="Foreground"                 Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 地形（terrain）縦パネルの寸法定数 ────────────────────
             縦パネルはビューポート左側（ギズモストリップの右隣）に立つ細長い列。
             マジックナンバーを XAML 中に散らさないよう、幅・アイコンサイズは
             ここへ集約して StaticResource で参照する。 -->
        <!-- 縦パネル全体の幅（枠・パディング込み）-->
        <sys:Double x:Key="TerrainSidePanelWidth">180</sys:Double>
        <!-- 縦パネル内のコントロール幅（パネル幅 − 内側パディング − スクロールバー分）-->
        <sys:Double x:Key="TerrainSideControlWidth">152</sys:Double>
        <!-- ツール選択トグル／アクションボタンに載せるアイコンの一辺 -->
        <sys:Double x:Key="TerrainIconSize">14</sys:Double>

        <!-- 地形ツール選択トグル（アイコン＋テキスト併記の RadioButton）。
             縦パネルに 1 行 1 ツールで積むため、幅は親いっぱいに伸ばし
             中身は左寄せにする。選択状態はアクセント色で表示。-->
        <Style x:Key="TerrainToolBtnStyle" TargetType="RadioButton">
            <Setter Property="Height"                   Value="24"/>
            <Setter Property="Margin"                   Value="0,0,0,3"/>
            <Setter Property="Padding"                  Value="7,0"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="Background"               Value="#3A3A3A"/>
            <Setter Property="Foreground"               Value="#CCCCCC"/>
            <Setter Property="BorderBrush"              Value="#555555"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Cursor"                   Value="Hand"/>
            <Setter Property="HorizontalAlignment"      Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#E87820"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E87820"/>
                                <Setter Property="Foreground"                  Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 地形アクションボタン（初期化 / 保存）。-->
        <Style x:Key="TerrainActionBtnStyle" TargetType="Button">
            <Setter Property="Height"          Value="22"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Background"      Value="#3A3A3A"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderBrush"     Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 地形縦パネルの見出し（「ブラシ」「ツール」などのセクション名）-->
        <Style x:Key="TerrainSideHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"     Value="0,0,0,5"/>
        </Style>

        <!-- 地形縦パネルのパラメータ名ラベル（「半径」「強度」など）-->
        <Style x:Key="TerrainSideCaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#AAAAAA"/>
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 地形縦パネルの数値表示（ラベル行の右端に置く現在値）-->
        <Style x:Key="TerrainSideValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground"          Value="#CCCCCC"/>
            <Setter Property="FontSize"            Value="11"/>
            <Setter Property="FontFamily"          Value="Consolas"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- 数値入力 TextBox スタイル（スライダー横の小型入力欄）-->
        <Style x:Key="NumInputStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background"                        Value="#1A1A1A"/>
            <Setter Property="Foreground"                        Value="White"/>
            <Setter Property="BorderBrush"                       Value="#3F3F46"/>
            <Setter Property="BorderThickness"                   Value="1"/>
            <Setter Property="FontSize"                          Value="11"/>
            <Setter Property="Padding"                           Value="3,1"/>
            <Setter Property="VerticalAlignment"                 Value="Center"/>
            <Setter Property="TextAlignment"                     Value="Right"/>
            <Setter Property="Margin"                            Value="3,0,0,0"/>
            <!-- ImGui 風ドラッグ入力を有効化 -->
            <Setter Property="local:NumericDragBehavior.Enabled" Value="True"/>
        </Style>

        <!-- InspectorPanel から TryFindResource で参照されるスタイル（NumInputStyle を継承）。
             文字列・ファイルパスフィールドにも使われるためドラッグビヘイビアはここでは無効にし、
             数値フィールドはコードで個別に SetEnabled(true) する。 -->
        <Style x:Key="NumericTextBox" TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource NumInputStyle}">
            <Setter Property="local:NumericDragBehavior.Enabled" Value="False"/>
        </Style>

        <!-- ダーク Expander スタイル -->
        <Style x:Key="DarkExpanderStyle" TargetType="{x:Type Expander}">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <DockPanel>
                            <!-- ヘッダーボタン -->
                            <ToggleButton x:Name="HeaderToggle"
                                          DockPanel.Dock="Top"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          Padding="0" Background="Transparent" BorderThickness="0"
                                          HorizontalContentAlignment="Left" Cursor="Hand">
                                <ToggleButton.Style>
                                    <Style TargetType="{x:Type ToggleButton}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                    <Border Background="Transparent"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Arrow" Text="▶"
                                               Foreground="#888888" FontSize="8"
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <ContentPresenter ContentSource="Header"
                                                      TextBlock.Foreground="#AAAAAA"
                                                      TextBlock.FontSize="11"
                                                      TextBlock.FontWeight="Bold"
                                                      VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                            <!-- コンテンツ -->
                            <ContentPresenter x:Name="Content"
                                              DockPanel.Dock="Bottom"
                                              Visibility="Collapsed"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Content" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Arrow"   Property="Text"       Value="▼"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 編集時物理タイムライン Slider スタイル ──────────────── -->
        <!-- DecreaseRepeatButton / IncreaseRepeatButton を定義しないと WPF の Track が
             Thumb 位置を計算できず、Thumb が常に端に貼り付いてしまう。
             両ボタンは Opacity="0" で透明にしてクリック領域だけ確保する。 -->
        <Style x:Key="PhysicsRepeatBtnStyle" TargetType="RepeatButton">
            <Setter Property="Opacity"    Value="0"/>
            <Setter Property="Focusable"  Value="False"/>
            <Setter Property="IsTabStop"  Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PhysicsSliderStyle" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <!-- トラック背景（未再生部分） -->
                            <Border x:Name="TrackBg"
                                    Height="4" CornerRadius="2"
                                    Background="#44FFFFFF"
                                    VerticalAlignment="Center"/>
                            <!-- 再生済み部分（進捗バー）: Width は code-behind で更新する -->
                            <Border x:Name="TrackFill"
                                    Height="4" CornerRadius="2"
                                    Background="#FF44CCFF"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Width="0"/>
                            <!-- Slider トラック本体（DecreaseRepeatButton + Thumb + IncreaseRepeatButton）-->
                            <!-- DecreaseRepeatButton/IncreaseRepeatButton がないと Track が
                                 Thumb 位置を正しく計算できないため必須 -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource PhysicsRepeatBtnStyle}"
                                                  Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Width"  Value="12"/>
                                                <Setter Property="Height" Value="12"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Ellipse x:Name="Dot"
                                                                     Fill="#DDDDDD"
                                                                     Stroke="#888888"
                                                                     StrokeThickness="1"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Dot" Property="Fill" Value="#FFFFFF"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="Dot" Property="Fill" Value="#44CCFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource PhysicsRepeatBtnStyle}"
                                                  Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
    <DockPanel>

        <!-- ── メニューバー ──────────────────────────────────────── -->
        <Menu DockPanel.Dock="Top"
              BorderThickness="0,0,0,1" BorderBrush="#3A3A3A">

            <!-- ファイル -->
            <MenuItem Header="ファイル">
                <MenuItem x:Name="MenuQuickSave"
                          Header="上書き保存"
                          InputGestureText="Ctrl+S"
                          Click="OnMenuQuickSave">
                    <MenuItem.Icon>
                        <ctrl:AppIcon IconKey="Icon.Save" Width="14" Height="14" Foreground="#CCCCCC"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="名前を付けて保存..."
                          InputGestureText="Ctrl+Shift+S"
                          Click="OnMenuSaveAs">
                    <MenuItem.Icon>
                        <ctrl:AppIcon IconKey="Icon.Save" Width="14" Height="14" Foreground="#CCCCCC"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="パッケージ化..." Click="OnOpenPackaging">
                    <MenuItem.Icon>
                        <ctrl:AppIcon IconKey="Icon.Build" Width="14" Height="14" Foreground="#CCCCCC"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="終了" Click="OnMenuExit"/>
            </MenuItem>

            <!-- 編集 -->
            <MenuItem Header="編集">
                <MenuItem Header="元に戻す"
                          InputGestureText="Ctrl+Z"
                          Click="OnMenuUndo">
                    <MenuItem.Icon>
                        <ctrl:AppIcon IconKey="Icon.Undo" Width="14" Height="14" Foreground="#CCCCCC"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="やり直し"
                          InputGestureText="Ctrl+Y"
                          Click="OnMenuRedo">
                    <MenuItem.Icon>
                        <ctrl:AppIcon IconKey="Icon.Redo" Width="14" Height="14" Foreground="#CCCCCC"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="コピー"
                          InputGestureText="Ctrl+C"
                          Click="OnMenuCopy"/>
                <MenuItem Header="貼り付け"
                          InputGestureText="Ctrl+V"
                          Click="OnMenuPaste"/>
                <Separator/>
                <MenuItem Header="削除"
                          InputGestureText="Del / Esc"
                          Click="OnMenuDelete">
                    <MenuItem.Icon>
                        <ctrl:AppIcon IconKey="Icon.Delete" Width="14" Height="14" Foreground="#CCCCCC"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <!-- エディタ全体の環境設定（スクロール係数など。editor_preferences.json に保存） -->
                <MenuItem Header="環境設定..."
                          Click="OnOpenEditorPreferences">
                    <MenuItem.Icon>
                        <ctrl:AppIcon IconKey="Icon.Settings" Width="14" Height="14" Foreground="#CCCCCC"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- 表示（カテゴリごとに入れ子化） -->
            <MenuItem Header="表示" SubmenuOpened="OnViewMenuOpened">
                <!-- パネル: エディタ基本パネル -->
                <MenuItem Header="パネル">
                    <MenuItem x:Name="MenuItemHierarchy"
                              Header="Hierarchy"
                              IsCheckable="True"
                              Tag="hierarchy"
                              Click="OnTogglePanel"/>
                    <MenuItem x:Name="MenuItemInspector"
                              Header="Inspector"
                              IsCheckable="True"
                              Tag="inspector"
                              Click="OnTogglePanel"/>
                    <MenuItem x:Name="MenuItemProject"
                              Header="Project"
                              IsCheckable="True"
                              Tag="project"
                              Click="OnTogglePanel"/>
                    <MenuItem x:Name="MenuItemOutput"
                              Header="Output"
                              IsCheckable="True"
                              Tag="output"
                              Click="OnTogglePanel"/>
                    <MenuItem x:Name="MenuItemAnimationTimeline"
                              Header="アニメーション"
                              IsCheckable="True"
                              Tag="animation_timeline"
                              Click="OnTogglePanel"/>
                    <MenuItem x:Name="MenuItemProfiler"
                              Header="プロファイラ"
                              IsCheckable="True"
                              Tag="profiler"
                              Click="OnTogglePanel"/>
                </MenuItem>
                <!-- スクリプト: スクリプト編集関連ウィンドウ -->
                <MenuItem Header="スクリプト">
                    <MenuItem x:Name="MenuItemScriptEditor"
                              Header="スクリプトエディタ"
                              IsCheckable="True"
                              Click="OnToggleScriptEditor"/>
                    <MenuItem x:Name="MenuItemOpenDocuments"
                              Header="タブ（開いているスクリプト）"
                              IsCheckable="True"
                              Tag="open_documents"
                              Click="OnTogglePanel"/>
                    <MenuItem x:Name="MenuItemErrorList"
                              Header="エラー一覧"
                              IsCheckable="True"
                              Tag="error_list"
                              Click="OnTogglePanel"/>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="デバッグ">
                <!-- 内蔵デバッガは Play 開始時に Play プロセスへ自動アタッチするため、
                     手動アタッチのメニューは不要（ブレークポイントを置くだけで停止する）。 -->
                <MenuItem Header="継続 (F5)"          Click="OnDebugContinue"/>
                <MenuItem Header="ステップオーバー (F10)" Click="OnDebugStepOver"/>
                <MenuItem Header="ステップイン (F11)"    Click="OnDebugStepIn"/>
                <MenuItem Header="ステップアウト (Shift+F11)" Click="OnDebugStepOut"/>
                <MenuItem Header="デタッチ"           Click="OnDebugDetach"/>
                <Separator/>
                <MenuItem Header="Visual Studio でスクリプトをデバッグ"
                          Click="OnAttachVisualStudio"/>
            </MenuItem>

        </Menu>

        <!-- ── 上部ツールバー ────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="#2D2D2D" Height="30"
                BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 右端: プロジェクト設定ボタン -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button Style="{StaticResource TopBarTextBtnStyle}"
                            Click="OnOpenProjectSettings"
                            ToolTip="プロジェクト設定を開く">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ctrl:AppIcon IconKey="Icon.ProjectSettings" Width="14" Height="14"/>
                            <TextBlock Text="プロジェクト設定" Margin="5,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 中央: 状態ラベル + Play/Stop + Pause + Settings -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- 実行状態インジケータ。アイコンと文字列はどちらも
                         MainWindow.Camera.cs の状態遷移から差し替える。
                         色は AppIcon が LblState と同じブラシを共有できないため、
                         状態切替時に両方へ同じブラシを代入している。 -->
                    <ctrl:AppIcon x:Name="IconState" IconKey="Icon.Dirty"
                                  Width="13" Height="13"
                                  VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <TextBlock x:Name="LblState"
                               Text="EDIT" Foreground="#60C060"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="BtnPlayPause"
                            Style="{StaticResource PlayBarBtnStyle}"
                            Background="#1F4A22"
                            Click="OnPlayPause"
                            ToolTip="Play / Pause / Resume">
                        <!-- 再生/一時停止の切替はコード側で Source を差し替える
                             （MainWindow.Camera.cs の状態遷移を参照）。 -->
                        <Image x:Name="ImgPlayPause"
                               Source="pack://application:,,,/resources/icons/playbar/play.png"
                               Width="18" Height="18"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                    <Button x:Name="BtnStop"
                            Style="{StaticResource PlayBarBtnStyle}"
                            Background="#4A1F1F"
                            Click="OnStop" IsEnabled="False"
                            ToolTip="Stop">
                        <Image Source="pack://application:,,,/resources/icons/playbar/stop.png"
                               Width="18" Height="18"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>

                    <!-- デバッグ操作（ブレークポイント停止中のみ表示）:
                         継続(F5) / ステップオーバー(F10) / ステップイン(F11) / ステップアウト(Shift+F11) -->
                    <StackPanel x:Name="DebugStepBar" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="8,0,0,0"
                                Visibility="Collapsed">
                        <Button x:Name="BtnDebugContinue" Style="{StaticResource PlayBarBtnStyle}"
                                Background="#25402A" Click="OnDebugContinue" ToolTip="継続 (F5)">
                            <ctrl:AppIcon IconKey="Icon.Play" Width="15" Height="15" Foreground="#8FE0A0"/>
                        </Button>
                        <Button x:Name="BtnDebugStepOver" Style="{StaticResource PlayBarBtnStyle}"
                                Background="#333333" Click="OnDebugStepOver" ToolTip="ステップオーバー (F10)">
                            <ctrl:AppIcon IconKey="Icon.Debug.StepOver" Width="15" Height="15" Foreground="#DDDDDD"/>
                        </Button>
                        <Button x:Name="BtnDebugStepIn" Style="{StaticResource PlayBarBtnStyle}"
                                Background="#333333" Click="OnDebugStepIn" ToolTip="ステップイン (F11)">
                            <ctrl:AppIcon IconKey="Icon.Debug.StepInto" Width="15" Height="15" Foreground="#DDDDDD"/>
                        </Button>
                        <Button x:Name="BtnDebugStepOut" Style="{StaticResource PlayBarBtnStyle}"
                                Background="#333333" Click="OnDebugStepOut" ToolTip="ステップアウト (Shift+F11)">
                            <ctrl:AppIcon IconKey="Icon.Debug.StepOut" Width="15" Height="15" Foreground="#DDDDDD"/>
                        </Button>
                    </StackPanel>
                    <Button x:Name="BtnSettings"
                            Width="28" Height="28" Margin="6,0,0,0"
                            Click="OnSettings"
                            Background="#404040" Foreground="#AAAAAA"
                            BorderThickness="0" Padding="4"
                            ToolTip="Settings">
                        <ctrl:AppIcon IconKey="Icon.Settings" Width="16" Height="16"/>
                    </Button>
                    <!-- FPS 表示（ランタイム側の計測値） -->
                    <TextBlock x:Name="TxtFps"
                               Text=""
                               Foreground="#88CCFF"
                               FontSize="11"
                               FontFamily="Consolas"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Visibility="Collapsed"
                               ToolTip="ランタイムFPS（0.5秒更新）"/>
                    <Popup x:Name="SettingsPopup"
                           PlacementTarget="{Binding ElementName=BtnSettings}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="#2D2D2D" BorderBrush="#555555" BorderThickness="1"
                                Padding="12,8" CornerRadius="2">
                            <StackPanel>
                                <TextBlock Text="Play Settings"
                                           Foreground="#AAAAAA" FontSize="11"
                                           Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkPlayFromStartScene"
                                          Content="開始シーンからプレイ"
                                          Foreground="White"
                                          IsChecked="False"
                                          Margin="0,0,0,4"
                                          Checked="OnPlayFromStartSceneChanged"
                                          Unchecked="OnPlayFromStartSceneChanged"
                                          ToolTip="オフ時は現在開いているシーンでプレイします"/>
                                <CheckBox x:Name="ChkClampCursor"
                                          Content="Play時マウスカーソルをWindowにクランプする"
                                          Foreground="White"
                                          IsChecked="False"
                                          Margin="0,0,0,4"
                                          Checked="OnClampCursorChanged"
                                          Unchecked="OnClampCursorChanged"/>
                                <CheckBox x:Name="ChkPlayColliderDraw"
                                          Content="実行時コライダー描画"
                                          Foreground="White"
                                          IsChecked="False"
                                          Checked="OnPlayColliderDrawChanged"
                                          Unchecked="OnPlayColliderDrawChanged"
                                          ToolTip="Play中にコライダーのワイヤーフレームを描画します。衝突中は赤色で表示されます。"/>
                                <CheckBox x:Name="ChkWindowPlay"
                                          Content="ウィンドウを出してプレイ（別プロセス）"
                                          Foreground="White"
                                          IsChecked="False"
                                          Margin="0,4,0,0"
                                          Checked="OnWindowPlayChanged"
                                          Unchecked="OnWindowPlayChanged"
                                          ToolTip="オン時は別プロセスの独立ウィンドウでPlayします。オフ（既定）時は別プロセスを起動せず、シーンパネルのランタイムをその場でPlay化します（埋め込みインプレースPlay）。地形・散布・GPUを作り直さないため即座に再生できます。"/>
                                <CheckBox x:Name="ChkPlayShaderHotReload"
                                          Content="Play中もシェーダをホットリロード"
                                          Foreground="White"
                                          IsChecked="True"
                                          Margin="0,4,0,0"
                                          Checked="OnPlayShaderHotReloadChanged"
                                          Unchecked="OnPlayShaderHotReloadChanged"
                                          ToolTip="オン（既定）時は、Play中に .wgsl シェーディングアセットを保存すると約1秒以内に再コンパイルされて反映されます（保存したフレームだけヒッチします）。Play中の WGSL 赤下線検証も有効になります。オフにするとPlay開始時点のシェーダを使い続けます。"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ── AvalonDock ドッキングマネージャー ───────────────────── -->
        <avd:DockingManager x:Name="DockManager"
                            Background="#1E1E1E"
                            GridSplitterWidth="4"
                            GridSplitterHeight="4">

            <avd:LayoutRoot>
                <avd:LayoutPanel Orientation="Horizontal">

                    <!-- 左パネル: Hierarchy + 開いているタブ一覧 -->
                    <avd:LayoutAnchorablePane DockWidth="220" DockMinWidth="120">
                        <avd:LayoutAnchorable Title="Hierarchy"
                                              ContentId="hierarchy"
                                              CanClose="False"
                                              CanHide="False"
                                              CanFloat="True">
                            <panels:HierarchyPanel x:Name="PanelHierarchy"/>
                        </avd:LayoutAnchorable>
                        <avd:LayoutAnchorable Title="タブ"
                                              ContentId="open_documents"
                                              CanClose="False"
                                              CanHide="False"
                                              CanFloat="True">
                            <!-- コンテンツは LoadLayout の LayoutSerializationCallback で設定される -->
                        </avd:LayoutAnchorable>
                    </avd:LayoutAnchorablePane>

                    <!-- 中央: Viewport + 下に Project -->
                    <avd:LayoutPanel Orientation="Vertical">

                        <avd:LayoutDocumentPaneGroup>
                            <avd:LayoutDocumentPane>
                                <!-- 表示タイトルのみ「シーン」へ変更。ContentId は保存済み layout.xml
                                     との互換のため "viewport" のまま維持する -->
                                <avd:LayoutDocument Title="シーン"
                                                    ContentId="viewport"
                                                    CanClose="False"
                                                    CanFloat="False">

                                    <!--
                                        Airspace 制約 (HwndHost は WPF 要素より常に前面) のため、
                                        ツールストリップと HwndHost を別 Grid 列に分けてオーバーラップを避ける。
                                        視覚的には Viewport パネル内の左端に配置される。
                                    -->
                                    <Grid x:Name="ViewportGrid">
                                        <Grid.RowDefinitions>
                                            <!-- アクタータブバー行（タブがないときは高さ 0）-->
                                            <RowDefinition Height="Auto"/>
                                            <!-- 地形（terrain）ツールバー行。terrain モード時のみ内容が表示される（既定は Collapsed で高さ 0）-->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Viewport 本体 -->
                                            <RowDefinition Height="*"/>
                                            <!-- 編集時物理タイムライン（ツールストリップ列を除いたビューポート列にのみ表示）-->
                                            <RowDefinition x:Name="PhysicsTimelineRow" Height="0"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <!-- ツールストリップ列（SRT ギズモ）-->
                                            <ColumnDefinition Width="44"/>
                                            <!-- 地形（terrain）縦パネル列。terrain モード時のみ中身が Visible になり、
                                                 Collapsed のときは Auto 幅が 0 に潰れてビューポートを侵食しない。 -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Viewport 列 -->
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- ── シーン/アクタータブバー（Row 0, 全列スパン）────────
                                             左端に固定シーンタブ（ワールド/ビューポート）を常設するため
                                             常時表示する（タブ生成は MainWindow.SceneTabs.cs / FileOps.cs） -->
                                        <Border x:Name="ActorTabBar"
                                                Grid.Row="0" Grid.ColumnSpan="3"
                                                Background="#252526"
                                                BorderBrush="#3A3A3A" BorderThickness="0,0,0,1"
                                                Height="28"
                                                Visibility="Visible">
                                            <DockPanel>
                                                <!-- 左端固定: シーン編集モード（common / terrain）。
                                                     Blender のモード切替のイメージ。terrain を選ぶと下段に地形ツールバーが現れ、
                                                     シーンビュー上の左ドラッグが地形ブラシになる（選択/ギズモは無効化）。
                                                     common は従来どおりの選択・ギズモ編集。既定は common。 -->
                                                <ComboBox x:Name="CmbSceneMode"
                                                          DockPanel.Dock="Left"
                                                          Width="110" Height="22"
                                                          Margin="6,3,4,3"
                                                          FontSize="11"
                                                          VerticalAlignment="Center"
                                                          SelectedIndex="0"
                                                          ToolTip="シーン編集モード（common＝通常編集 / terrain＝地形ブラシ編集）"
                                                          SelectionChanged="OnSceneModeChanged">
                                                    <ComboBoxItem Content="common"  Tag="common"/>
                                                    <ComboBoxItem Content="terrain" Tag="terrain"/>
                                                </ComboBox>
                                                <!-- 右端固定: シーンビュー表示モード（通常3種 ＋ G-Buffer デバッグ表示）。
                                                     シーン設定ウィンドウ（歯車ボタン）へ一度移したが、切り替え頻度が高く
                                                     2手以内で触れる必要があるため、ツールバー上へ直接戻した項目。

                                                     エディタのシーンビュー（デバッグカメラ）だけに効き、ゲームカメラの
                                                     プレビュー小窓・Play の見た目には影響しない（ランタイム側でゲート）。
                                                     Tag は SET_POST_FX の "view_mode" フィールド値をそのまま保持する。
                                                     セッション内のみ有効（永続化なし）＝既定は毎起動「ライティングON」。
                                                     .scene の settings 節にもランタイム側スキーマにも含めない
                                                     （G-Buffer デバッグ表示のまま保存される事故を防ぐため）。

                                                     「G-Buffer: 〜」は Deferred の G-Buffer を生値のまま表示するデバッグ用。
                                                     ランタイム側は Deferred を維持したままライティングパスだけを可視化パスへ
                                                     差し替える（unlit のように Deferred を落とすと G-Buffer 自体が焼かれず
                                                     矛盾するため）。Tag 文字列はランタイムの view_mode.rs の
                                                     GBUFFER_DEBUG_CHANNEL_TABLE と 1:1 で一致させること。 -->
                                                <ComboBox x:Name="CmbViewMode"
                                                          DockPanel.Dock="Right"
                                                          Width="190" Height="22"
                                                          Margin="4,3"
                                                          FontSize="11"
                                                          VerticalAlignment="Center"
                                                          SelectedIndex="0"
                                                          ToolTip="シーンビューの表示モード（G-Bufferデバッグ表示を含む）"
                                                          SelectionChanged="OnViewModeChanged">
                                                    <ComboBoxItem Content="ライティングON" Tag="lit"/>
                                                    <ComboBoxItem Content="ライティングOFF" Tag="unlit"/>
                                                    <ComboBoxItem Content="ワイヤーフレーム" Tag="wireframe"/>
                                                    <!-- 以下は G-Buffer デバッグ表示（Deferred 有効時のみ意味を持つ）。
                                                         区切り線は IsEnabled=False にして矢印キー移動の対象から外す（選択されると
                                                         SelectedItem が ComboBoxItem でなくなり lit へフォールバックするため）。
                                                         なお IsEnabled=False だけでは WPF のテキスト検索（typeahead）は防げず、
                                                         "S" キー（カメラ後退）でこの Separator が選ばれて表示モードが lit へ
                                                         戻る不具合があった。現在は App.xaml の ComboBox 暗黙スタイルが適用する
                                                         Controls/ComboBoxKeyGuard がキーボード経由の選択変更ごと抑止している
                                                         （このツールバー上のコンボにも暗黙スタイル経由で自動適用される）。 -->
                                                    <Separator IsEnabled="False"/>
                                                    <ComboBoxItem Content="G-Buffer: ベースカラー"   Tag="gbuffer_base_color"/>
                                                    <ComboBoxItem Content="G-Buffer: オクルージョン" Tag="gbuffer_occlusion"/>
                                                    <ComboBoxItem Content="G-Buffer: 法線"           Tag="gbuffer_normal"/>
                                                    <ComboBoxItem Content="G-Buffer: ラフネス"       Tag="gbuffer_roughness"/>
                                                    <ComboBoxItem Content="G-Buffer: メタリック"     Tag="gbuffer_metallic"/>
                                                    <ComboBoxItem Content="G-Buffer: 透過"           Tag="gbuffer_transmission"/>
                                                    <ComboBoxItem Content="G-Buffer: エミッシブ"     Tag="gbuffer_emissive"/>
                                                    <ComboBoxItem Content="G-Buffer: 深度"           Tag="gbuffer_depth"/>
                                                    <ComboBoxItem Content="G-Buffer: 速度"           Tag="gbuffer_velocity"/>
                                                    <ComboBoxItem Content="G-Buffer: レンダータグ"   Tag="gbuffer_render_tag"/>
                                                    <ComboBoxItem Content="G-Buffer: ユーザーデータ" Tag="gbuffer_user_data"/>
                                                </ComboBox>

                                                <!-- 右端固定: デバッグカメラ 2D(正射)⇄3D(透視) トグル -->
                                                <Button x:Name="Btn2DCamToggle"
                                                        DockPanel.Dock="Right"
                                                        Content="2D"
                                                        Width="36" Height="22"
                                                        Margin="4,3"
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="#CCCCCC"
                                                        Background="#3A3A3A"
                                                        BorderBrush="#555555"
                                                        BorderThickness="1"
                                                        Cursor="Hand"
                                                        ToolTip="デバッグカメラを 2D（正射投影）⇄ 3D（透視投影）で切り替え"
                                                        Click="On2DCamToggleClicked">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd"
                                                                                Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="3"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsPressed" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#666666"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <!-- Btn2DCamToggle の左隣固定: グリッド表示トグル。
                                                     セッション限りの非永続項目（既定 ON）。SHOW_GRID IPC を直接送り、
                                                     .scene の settings 節へは保存しない（切り替え頻度が高く、
                                                     シーンをダーティにすべき設定ではないため）。 -->
                                                <Button x:Name="BtnGridToggle"
                                                        DockPanel.Dock="Right"
                                                        Content="グリッド"
                                                        Width="52" Height="22"
                                                        Margin="4,3"
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Foreground="#CCCCCC"
                                                        Background="#3A3A3A"
                                                        BorderBrush="#555555"
                                                        BorderThickness="1"
                                                        Cursor="Hand"
                                                        ToolTip="シーンビューの地面グリッド表示を切り替え（このセッション限り・保存されません）"
                                                        Click="OnGridToggleClicked">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd"
                                                                                Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="3"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsPressed" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#666666"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <!-- BtnGridToggle の左隣固定: 軸ガイド（画面隅の XYZ ギズモ）表示トグル。
                                                     グリッドと同じくセッション限りの非永続項目（既定 ON）。 -->
                                                <Button x:Name="BtnAxisGizmoToggle"
                                                        DockPanel.Dock="Right"
                                                        Content="軸"
                                                        Width="30" Height="22"
                                                        Margin="4,3"
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Foreground="#CCCCCC"
                                                        Background="#3A3A3A"
                                                        BorderBrush="#555555"
                                                        BorderThickness="1"
                                                        Cursor="Hand"
                                                        ToolTip="画面隅の XYZ 軸ガイド表示を切り替え（このセッション限り・保存されません）"
                                                        Click="OnAxisGizmoToggleClicked">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd"
                                                                                Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="3"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsPressed" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#666666"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <!-- 上記トグルの左隣固定: ギズモ座標系（World/Local）トグル -->
                                                <Button x:Name="BtnGizmoSpaceToggle"
                                                        DockPanel.Dock="Right"
                                                        Content="World"
                                                        Width="42" Height="22"
                                                        Margin="4,3"
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Foreground="#CCCCCC"
                                                        Background="#3A3A3A"
                                                        BorderBrush="#555555"
                                                        BorderThickness="1"
                                                        Cursor="Hand"
                                                        ToolTip="移動/回転/スケールギズモの座標系を World（ワールド軸）⇄ Local（選択アクターのローカル軸）で切り替え"
                                                        Click="OnGizmoSpaceToggleClicked">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd"
                                                                                Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="3"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsPressed" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#666666"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <!-- 右端固定: シーンに戻るボタン -->
                                                <Button x:Name="BtnReturnToScene"
                                                        DockPanel.Dock="Right"
                                                        Height="22"
                                                        Margin="4,3"
                                                        Padding="8,0"
                                                        FontSize="11"
                                                        Foreground="#CCCCCC"
                                                        Background="#3A3A3A"
                                                        BorderBrush="#555555"
                                                        BorderThickness="1"
                                                        Cursor="Hand"
                                                        Visibility="Collapsed"
                                                        Click="OnReturnToScene">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ctrl:AppIcon IconKey="Icon.Back" Width="13" Height="13"/>
                                                        <TextBlock Text="シーンに戻る" Margin="4,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd"
                                                                                Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="3"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsPressed" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#666666"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                    </Button>
                                                <!-- タブ一覧（横スクロール）-->
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                              VerticalScrollBarVisibility="Disabled"
                                                              Focusable="False">
                                                    <StackPanel x:Name="ActorTabsPanel" Orientation="Horizontal"/>
                                                </ScrollViewer>
                                            </DockPanel>
                                        </Border>

                                        <!-- ── 地形（terrain）グローバル操作バー（Row 1, 全列スパン）────────
                                             CmbSceneMode が terrain のときだけ Visible になる。
                                             HwndHost（ビューポート）とは別の行に置くため Airspace 問題なし。

                                             ここに残すのは「地形アセット全体に効くグローバル操作」だけ:
                                             初期化 / 保存 / ハイトマップ読込 / 設定 / ステータス表示。
                                             ブラシパラメータとツール選択は左の縦パネル（TerrainSidePanel）へ移した。 -->
                                        <Border x:Name="TerrainToolbar"
                                                Grid.Row="1" Grid.ColumnSpan="3"
                                                Background="#252526"
                                                BorderBrush="#3A3A3A" BorderThickness="0,0,0,1"
                                                Padding="6,4"
                                                Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                <!-- 地形の初期化（平地を作り直す）-->
                                                <Button x:Name="BtnTerrainInit"
                                                        Style="{StaticResource TerrainActionBtnStyle}"
                                                        ToolTip="地形設定で指定したチャンク構成（既定 4×4 チャンク）で平地を生成する（既存の地形は作り直される）"
                                                        Click="OnTerrainInit">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ctrl:AppIcon IconKey="Icon.Reset"
                                                                      Width="{StaticResource TerrainIconSize}"
                                                                      Height="{StaticResource TerrainIconSize}"/>
                                                        <TextBlock Text="地形を初期化" Margin="4,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- 地形の保存（全チャンクの .tvox 書き出し）-->
                                                <Button x:Name="BtnTerrainSave"
                                                        Style="{StaticResource TerrainActionBtnStyle}"
                                                        ToolTip="全チャンクの密度データ（.tvox）を保存する"
                                                        Click="OnTerrainSave">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ctrl:AppIcon IconKey="Icon.Save"
                                                                      Width="{StaticResource TerrainIconSize}"
                                                                      Height="{StaticResource TerrainIconSize}"/>
                                                        <TextBlock Text="地形を保存" Margin="4,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Border Width="1" Background="#3A3A3A" Margin="8,2"/>

                                                <!-- ハイトマップ読込（高さスケール入力＋読込ボタン）-->
                                                <TextBlock Text="高さ" Foreground="#AAAAAA" FontSize="11"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="TxtTerrainHeightScale" Text="10"
                                                         Width="36" VerticalAlignment="Center"
                                                         FontFamily="Consolas" FontSize="11"
                                                         Margin="0,0,6,0"
                                                         ToolTip="ハイトマップ最大高さ(m)"/>
                                                <Button x:Name="BtnTerrainHeightmap"
                                                        Style="{StaticResource TerrainActionBtnStyle}"
                                                        ToolTip="画像（グレースケール高さマップ）から、地形設定で指定したチャンク構成で地形を生成する"
                                                        Click="OnTerrainHeightmap">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ctrl:AppIcon IconKey="Icon.Terrain.Heightmap"
                                                                      Width="{StaticResource TerrainIconSize}"
                                                                      Height="{StaticResource TerrainIconSize}"/>
                                                        <TextBlock Text="ハイトマップ読込" Margin="4,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Border Width="1" Background="#3A3A3A" Margin="8,2"/>

                                                <!-- 地形設定ウィンドウ（レイヤ定義などをまとめて編集する別ウィンドウ）-->
                                                <Button x:Name="BtnTerrainSettings"
                                                        Style="{StaticResource TerrainActionBtnStyle}"
                                                        ToolTip="地形設定ウィンドウを開く（レイヤ定義の編集・ブラシ設定）"
                                                        Click="OnTerrainSettings">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ctrl:AppIcon IconKey="Icon.Settings"
                                                                      Width="{StaticResource TerrainIconSize}"
                                                                      Height="{StaticResource TerrainIconSize}"/>
                                                        <TextBlock Text="設定" Margin="4,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- ステータス表示（初期化/保存/ブラシの結果）-->
                                                <TextBlock x:Name="TxtTerrainStatus" Text=""
                                                           Foreground="#88CC88" FontSize="11"
                                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- ── 地形（terrain）縦パネル（Row 2, Col 1）────────────────
                                             ギズモ縦ストリップ（Col 0）のすぐ右隣に立つ細長いパネル。
                                             HwndHost（Col 2）とは列が異なるため Airspace 問題なし。
                                             CmbSceneMode が terrain のときだけ Visible になり、
                                             それ以外では Collapsed → Auto 幅列が 0 に潰れる。

                                             上段 = ブラシパラメータ（半径・強度・ツール別サブパネル）
                                             下段 = 地形ツール選択（アイコン＋テキストの縦並びトグル）
                                             低解像度でも溢れないよう全体を ScrollViewer に入れる。 -->
                                        <Border x:Name="TerrainSidePanel"
                                                Grid.Row="2" Grid.Column="1"
                                                Width="{StaticResource TerrainSidePanelWidth}"
                                                Background="#CC1C1C1C"
                                                BorderBrush="#3A3A3A" BorderThickness="0,0,1,0"
                                                Visibility="Collapsed">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Focusable="False">
                                                <StackPanel Margin="8,10,8,10">

                                                    <!-- ── 上段: ブラシパラメータ ───────────────── -->
                                                    <TextBlock Text="ブラシ"
                                                               Style="{StaticResource TerrainSideHeaderStyle}"/>

                                                    <!-- ブラシ半径（0.5〜8m）。全ツール共通。 -->
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock Text="半径" DockPanel.Dock="Left"
                                                                   Style="{StaticResource TerrainSideCaptionStyle}"/>
                                                        <TextBlock x:Name="TxtTerrainRadius" Text="3.0m"
                                                                   Style="{StaticResource TerrainSideValueStyle}"/>
                                                    </DockPanel>
                                                    <Slider x:Name="SldTerrainRadius"
                                                            Width="{StaticResource TerrainSideControlWidth}"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,2,0,8"
                                                            Minimum="0.5" Maximum="8" Value="3"
                                                            ToolTip="ブラシ半径（メートル）"/>

                                                    <!-- ブラシ強度（0〜1）。
                                                         散布ツール選択時は意味を持たないため、パネルごと隠す
                                                         （OnTerrainToolChanged が Visibility を切り替える）。 -->
                                                    <StackPanel x:Name="TerrainStrengthPanel">
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock Text="強度" DockPanel.Dock="Left"
                                                                       Style="{StaticResource TerrainSideCaptionStyle}"/>
                                                            <TextBlock x:Name="TxtTerrainStrength" Text="0.50"
                                                                       Style="{StaticResource TerrainSideValueStyle}"/>
                                                        </DockPanel>
                                                        <Slider x:Name="SldTerrainStrength"
                                                                Width="{StaticResource TerrainSideControlWidth}"
                                                                HorizontalAlignment="Left"
                                                                Margin="0,2,0,8"
                                                                Minimum="0" Maximum="1" Value="0.5"
                                                                ToolTip="ブラシ強度（0〜1）"/>
                                                    </StackPanel>

                                                    <!-- レイヤ選択（ペイントツール選択時のみ表示）。
                                                         項目は assets/terrain/layers.json から動的生成
                                                         （RefreshTerrainLayerCombo）。レイヤ総数は自由なので
                                                         XAML に固定項目は置かない。 -->
                                                    <StackPanel x:Name="TerrainLayerPanel"
                                                                Visibility="Collapsed">
                                                        <TextBlock Text="レイヤ"
                                                                   Style="{StaticResource TerrainSideCaptionStyle}"/>
                                                        <ComboBox x:Name="CmbTerrainLayer"
                                                                  Width="{StaticResource TerrainSideControlWidth}"
                                                                  HorizontalAlignment="Left"
                                                                  Margin="0,2,0,8"
                                                                  FontSize="11"
                                                                  ToolTip="塗る対象の地形レイヤ（layers.json の並び順）"/>
                                                    </StackPanel>

                                                    <!-- プロップ選択＋密度＋消去モード（散布ツール選択時のみ表示）。
                                                         項目は assets/terrain/props.json の並びに対応する。 -->
                                                    <StackPanel x:Name="TerrainScatterPanel"
                                                                Visibility="Collapsed">
                                                        <TextBlock Text="プロップ"
                                                                   Style="{StaticResource TerrainSideCaptionStyle}"/>
                                                        <!-- 項目は props.json から動的に生成する（RefreshTerrainPropCombo）。 -->
                                                        <ComboBox x:Name="CmbTerrainProp"
                                                                  Width="{StaticResource TerrainSideControlWidth}"
                                                                  HorizontalAlignment="Left"
                                                                  Margin="0,2,0,6"
                                                                  FontSize="11"
                                                                  ToolTip="撒く対象のプロップ（props.json の並び順）"/>

                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock Text="密度" DockPanel.Dock="Left"
                                                                       Style="{StaticResource TerrainSideCaptionStyle}"/>
                                                            <TextBlock x:Name="TxtTerrainDensity" Text="4.0"
                                                                       Style="{StaticResource TerrainSideValueStyle}"/>
                                                        </DockPanel>
                                                        <Slider x:Name="SldTerrainDensity"
                                                                Width="{StaticResource TerrainSideControlWidth}"
                                                                HorizontalAlignment="Left"
                                                                Margin="0,2,0,6"
                                                                Minimum="0.1" Maximum="32" Value="4"
                                                                ToolTip="ブラシ 1 回あたりの散布密度（点/m²）"/>

                                                        <CheckBox x:Name="ChkTerrainScatterErase"
                                                                  Content="消去" Foreground="#CCCCCC" FontSize="11"
                                                                  Margin="0,0,0,8"
                                                                  ToolTip="ONにすると、撒くかわりにブラシ範囲のプロップを消す"/>
                                                    </StackPanel>

                                                    <!-- 素材選択＋目標量＋消去モード（カバーツール選択時のみ表示）。
                                                         項目は assets/terrain/cover_materials.json の並びに対応する。
                                                         消去モード時は素材・目標量が無意味になるため、
                                                         UpdateTerrainCoverParamVisibility が個別に隠す。 -->
                                                    <StackPanel x:Name="TerrainCoverPanel"
                                                                Visibility="Collapsed">
                                                        <TextBlock x:Name="LblTerrainCoverMaterial" Text="素材"
                                                                   Style="{StaticResource TerrainSideCaptionStyle}"/>
                                                        <!-- 項目は cover_materials.json から動的に生成する
                                                             （RefreshTerrainCoverMaterialCombo）。 -->
                                                        <ComboBox x:Name="CmbTerrainCoverMaterial"
                                                                  Width="{StaticResource TerrainSideControlWidth}"
                                                                  HorizontalAlignment="Left"
                                                                  Margin="0,2,0,6"
                                                                  FontSize="11"
                                                                  ToolTip="敷く素材（cover_materials.json の並び順）。消去時は使われない"/>

                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock x:Name="LblTerrainCoverAmount" Text="目標量"
                                                                       DockPanel.Dock="Left"
                                                                       Style="{StaticResource TerrainSideCaptionStyle}"/>
                                                            <TextBlock x:Name="TxtTerrainCoverAmount" Text="1.00"
                                                                       Style="{StaticResource TerrainSideValueStyle}"/>
                                                        </DockPanel>
                                                        <Slider x:Name="SldTerrainCoverAmount"
                                                                Width="{StaticResource TerrainSideControlWidth}"
                                                                HorizontalAlignment="Left"
                                                                Margin="0,2,0,6"
                                                                Minimum="0" Maximum="1" Value="1"
                                                                ToolTip="敷く厚み（0〜1。1 = 満量）。なぞった場所はこの量へ収束する"/>

                                                        <CheckBox x:Name="ChkTerrainCoverErase"
                                                                  Content="消去" Foreground="#CCCCCC" FontSize="11"
                                                                  Margin="0,0,0,8"
                                                                  IsChecked="True"
                                                                  ToolTip="ONにすると、敷くかわりにブラシ範囲のカバー（雪・落ち葉・轍）を消す"
                                                                  Checked="OnTerrainCoverEraseChanged"
                                                                  Unchecked="OnTerrainCoverEraseChanged"/>
                                                    </StackPanel>

                                                    <!-- 上段（ブラシ）と下段（ツール選択）の区切り線 -->
                                                    <Border Height="1" Background="#3A3A3A" Margin="0,2,0,10"/>

                                                    <!-- ── 下段: 地形ツール選択 ─────────────────
                                                         1 行 = [アイコン][ラベル] の縦並びトグル。
                                                         選択状態は TerrainToolBtnStyle がアクセント色で表示する。 -->
                                                    <TextBlock Text="地形ツール"
                                                               Style="{StaticResource TerrainSideHeaderStyle}"/>

                                                    <RadioButton x:Name="BtnTerrainRaise"
                                                                 GroupName="TerrainTools"
                                                                 Style="{StaticResource TerrainToolBtnStyle}"
                                                                 IsChecked="True"
                                                                 ToolTip="盛る（地面を隆起させる）"
                                                                 Checked="OnTerrainToolChanged">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ctrl:AppIcon IconKey="Icon.Terrain.Raise"
                                                                          Width="{StaticResource TerrainIconSize}"
                                                                          Height="{StaticResource TerrainIconSize}"/>
                                                            <TextBlock Text="盛る" Margin="6,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </RadioButton>

                                                    <RadioButton x:Name="BtnTerrainCarve"
                                                                 GroupName="TerrainTools"
                                                                 Style="{StaticResource TerrainToolBtnStyle}"
                                                                 ToolTip="掘る（地面を削って洞窟を作る）"
                                                                 Checked="OnTerrainToolChanged">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ctrl:AppIcon IconKey="Icon.Terrain.Carve"
                                                                          Width="{StaticResource TerrainIconSize}"
                                                                          Height="{StaticResource TerrainIconSize}"/>
                                                            <TextBlock Text="掘る" Margin="6,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </RadioButton>

                                                    <RadioButton x:Name="BtnTerrainSmooth"
                                                                 GroupName="TerrainTools"
                                                                 Style="{StaticResource TerrainToolBtnStyle}"
                                                                 ToolTip="均す（周囲の平均へならす）"
                                                                 Checked="OnTerrainToolChanged">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ctrl:AppIcon IconKey="Icon.Terrain.Smooth"
                                                                          Width="{StaticResource TerrainIconSize}"
                                                                          Height="{StaticResource TerrainIconSize}"/>
                                                            <TextBlock Text="均す" Margin="6,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </RadioButton>

                                                    <RadioButton x:Name="BtnTerrainFlatten"
                                                                 GroupName="TerrainTools"
                                                                 Style="{StaticResource TerrainToolBtnStyle}"
                                                                 ToolTip="平坦化（ブラシ中心の高さへそろえる）"
                                                                 Checked="OnTerrainToolChanged">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ctrl:AppIcon IconKey="Icon.Terrain.Flatten"
                                                                          Width="{StaticResource TerrainIconSize}"
                                                                          Height="{StaticResource TerrainIconSize}"/>
                                                            <TextBlock Text="平坦化" Margin="6,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </RadioButton>

                                                    <!-- レイヤペイント（Terrain T2）。密度は変えずレイヤ重みだけを塗る。 -->
                                                    <RadioButton x:Name="BtnTerrainPaint"
                                                                 GroupName="TerrainTools"
                                                                 Style="{StaticResource TerrainToolBtnStyle}"
                                                                 ToolTip="ペイント（地形マテリアルレイヤを手で塗る。形状は変えない）"
                                                                 Checked="OnTerrainToolChanged">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ctrl:AppIcon IconKey="Icon.Terrain.Paint"
                                                                          Width="{StaticResource TerrainIconSize}"
                                                                          Height="{StaticResource TerrainIconSize}"/>
                                                            <TextBlock Text="ペイント" Margin="6,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </RadioButton>

                                                    <!-- 散布（Terrain T3）。地形の形状もレイヤも変えず、プロップを撒く／消す。 -->
                                                    <RadioButton x:Name="BtnTerrainScatter"
                                                                 GroupName="TerrainTools"
                                                                 Style="{StaticResource TerrainToolBtnStyle}"
                                                                 ToolTip="散布（草・木などのプロップを手で撒く。形状もレイヤも変えない）"
                                                                 Checked="OnTerrainToolChanged">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ctrl:AppIcon IconKey="Icon.Terrain.Scatter"
                                                                          Width="{StaticResource TerrainIconSize}"
                                                                          Height="{StaticResource TerrainIconSize}"/>
                                                            <TextBlock Text="散布" Margin="6,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </RadioButton>

                                                    <!-- カバー（I3.1 の地表カバー場）。積もった雪・落ち葉を手で消す／敷く。 -->
                                                    <RadioButton x:Name="BtnTerrainCover"
                                                                 GroupName="TerrainTools"
                                                                 Style="{StaticResource TerrainToolBtnStyle}"
                                                                 ToolTip="カバー（積もった雪・落ち葉を手で消す／敷く。形状もレイヤも変えない）"
                                                                 Checked="OnTerrainToolChanged">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ctrl:AppIcon IconKey="Icon.Terrain.Cover"
                                                                          Width="{StaticResource TerrainIconSize}"
                                                                          Height="{StaticResource TerrainIconSize}"/>
                                                            <TextBlock Text="カバー" Margin="6,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </RadioButton>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>

                                        <!-- Viewport HWND (code-behind で ViewportHost を差し込む) -->
                                        <ContentControl Grid.Row="2" Grid.Column="2"
                                                        x:Name="ViewportDocumentContent"
                                                        Background="Black"/>

                                        <!-- 起動中オーバーレイ — FIRST_FRAME 受信まで前面に表示 -->
                                        <!-- IsHitTestVisible="False": オーバーレイはクリックを透過させる。
                                             ビューポート列を覆っていても HwndHost やその下の要素が
                                             マウスイベントを受け取れるようにする。 -->
                                        <Grid x:Name="ViewportLoadingOverlay"
                                              Grid.Row="2" Grid.Column="2"
                                              Panel.ZIndex="5"
                                              IsHitTestVisible="False">
                                            <Image Source="pack://application:,,,/resources/images/blueSky_ORE.png"
                                                   Stretch="UniformToFill"/>
                                            <TextBlock x:Name="TxtViewportStatus"
                                                       Text=""
                                                       Foreground="White" FontSize="14"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,12,8">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="Black" BlurRadius="4"
                                                                      ShadowDepth="1" Opacity="0.8"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </Grid>

                                        <!-- ツールストリップ (HwndHost と列が異なるためAirspace問題なし) -->
                                        <Border Grid.Row="2" Grid.Column="0"
                                                Background="#CC1C1C1C"
                                                Padding="4,10,4,10">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Direction="0"
                                                                  BlurRadius="8" Opacity="0.6"
                                                                  ShadowDepth="2"/>
                                            </Border.Effect>
                                            <DockPanel>
                                                <!-- オプションボタン（下端固定）-->
                                                <Button x:Name="BtnViewportOptions"
                                                        DockPanel.Dock="Bottom"
                                                        Style="{StaticResource ViewportOptBtnStyle}"
                                                        ToolTip="Viewport Options"
                                                        Click="OnViewportOptions">
                                                    <ctrl:AppIcon IconKey="Icon.Settings"
                                                                  Width="16" Height="16"
                                                                  Foreground="#AAAAAA"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Center"/>
                                                </Button>

                                                <!-- ツールボタン群 -->
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Top">
                                                    <RadioButton x:Name="BtnToolSelect"
                                                                 GroupName="EditorTools"
                                                                 IsChecked="True"
                                                                 Style="{StaticResource ToolBtnStyle}"
                                                                 ToolTip="Select (Q)"
                                                                 Click="OnToolSelect">
                                                        <Image Source="pack://application:,,,/resources/icons/toolbar/select.png"
                                                               Width="20" Height="20"/>
                                                    </RadioButton>

                                                    <RadioButton x:Name="BtnToolMove"
                                                                 GroupName="EditorTools"
                                                                 Style="{StaticResource ToolBtnStyle}"
                                                                 ToolTip="Move (W)"
                                                                 Click="OnToolMove">
                                                        <Image Source="pack://application:,,,/resources/icons/toolbar/translate.png"
                                                               Width="20" Height="20"/>
                                                    </RadioButton>

                                                    <RadioButton x:Name="BtnToolRotate"
                                                                 GroupName="EditorTools"
                                                                 Style="{StaticResource ToolBtnStyle}"
                                                                 ToolTip="Rotate (E)"
                                                                 Click="OnToolRotate">
                                                        <Image Source="pack://application:,,,/resources/icons/toolbar/rotate.png"
                                                               Width="20" Height="20"/>
                                                    </RadioButton>

                                                    <RadioButton x:Name="BtnToolScale"
                                                                 GroupName="EditorTools"
                                                                 Style="{StaticResource ToolBtnStyle}"
                                                                 ToolTip="Scale (R)"
                                                                 Click="OnToolScale">
                                                        <Image Source="pack://application:,,,/resources/icons/toolbar/scale.png"
                                                               Width="20" Height="20"/>
                                                    </RadioButton>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- ── 編集時物理タイムライン（Row 3, Viewport 列のみ）── -->
                                        <!-- ツールストリップ列（Col 0）・地形縦パネル列（Col 1）には表示しない。
                                             HwndHost と同じ列に重ならない行に配置するため Airspace 問題なし。 -->
                                        <Border x:Name="PhysicsTimelinePanel"
                                                Grid.Row="3" Grid.Column="2"
                                                Background="#E0141414"
                                                BorderBrush="#55AACCFF"
                                                BorderThickness="0,1,0,0"
                                                Visibility="Collapsed">
                                            <Grid Margin="8,5,8,5">
                                                <Grid.ColumnDefinitions>
                                                    <!-- 再生/停止ボタン -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- 現在時刻 -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- シークバー -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- 総フレーム表示 -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- 適用ボタン -->
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 再生/停止ボタン。IconKey はコード側（MainWindow.Physics.cs）で
                                                     Icon.Play / Icon.Stop に差し替える。 -->
                                                <ctrl:AppIcon x:Name="TxtPhysicsPlayBtn"
                                                              Grid.Column="0"
                                                              IconKey="Icon.Play"
                                                              Width="14" Height="14"
                                                              Foreground="#CCFFFFFF"
                                                              VerticalAlignment="Center"
                                                              Cursor="Hand"
                                                              Margin="0,0,8,0"
                                                              ToolTip="再生 / 停止（スペースキー）"
                                                              MouseLeftButtonDown="OnPhysicsTimerClick"/>

                                                <!-- 現在時刻表示 -->
                                                <TextBlock x:Name="TxtPhysicsTimer"
                                                           Grid.Column="1"
                                                           Text="0.00s"
                                                           Foreground="#AAFFFFFF"
                                                           FontSize="11"
                                                           FontFamily="Consolas"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"
                                                           MinWidth="42"/>

                                                <!-- シークバー（Slider） -->
                                                <Slider x:Name="SldPhysicsTimeline"
                                                        Grid.Column="2"
                                                        Minimum="0" Maximum="0" Value="0"
                                                        IsSnapToTickEnabled="True"
                                                        TickFrequency="1"
                                                        SmallChange="1"
                                                        LargeChange="10"
                                                        Style="{StaticResource PhysicsSliderStyle}"
                                                        VerticalAlignment="Center"
                                                        ValueChanged="OnPhysicsSliderValueChanged"/>

                                                <!-- 総フレーム / 総時間表示 -->
                                                <TextBlock x:Name="TxtPhysicsTotalTime"
                                                           Grid.Column="3"
                                                           Text="f0 / f0"
                                                           Foreground="#66FFFFFF"
                                                           FontSize="11"
                                                           FontFamily="Consolas"
                                                           VerticalAlignment="Center"
                                                           Margin="6,0,4,0"/>

                                                <!-- 適用ボタン（現在フレームをフレーム0として確定） -->
                                                <Border x:Name="BtnPhysicsApply"
                                                        Grid.Column="4"
                                                        Width="22" Height="22"
                                                        Background="Transparent"
                                                        BorderBrush="#44FFFFFF"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Cursor="Hand"
                                                        ToolTip="このフレームをスタート状態として適用（履歴をクリアしてフレーム0に設定）"
                                                        MouseLeftButtonDown="OnPhysicsApplyClick">
                                                    <ctrl:AppIcon IconKey="Icon.Apply"
                                                                  Width="13" Height="13"
                                                                  Foreground="#88FFCC88"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                    </Grid>
                                </avd:LayoutDocument>

                                <!-- 内蔵スクリプトエディタ（.cs をダブルクリックで開く） -->
                                <avd:LayoutDocument Title="Script"
                                                    ContentId="script_editor"
                                                    CanClose="False"
                                                    CanFloat="True">
                                    <panels:ScriptEditorPanel x:Name="PanelScriptEditor"/>
                                </avd:LayoutDocument>
                            </avd:LayoutDocumentPane>
                        </avd:LayoutDocumentPaneGroup>

                        <!-- 下部パネル: Project / Output -->
                        <avd:LayoutAnchorablePane DockHeight="180" DockMinHeight="80">
                            <avd:LayoutAnchorable Title="Project"
                                                  ContentId="project"
                                                  CanClose="False"
                                                  CanHide="False"
                                                  CanFloat="True">
                                <panels:ProjectPanel x:Name="PanelProject"/>
                            </avd:LayoutAnchorable>
                            <avd:LayoutAnchorable Title="Output"
                                                  ContentId="output"
                                                  CanClose="False"
                                                  CanHide="False"
                                                  CanFloat="True">
                                <panels:OutputPanel x:Name="PanelOutput"/>
                            </avd:LayoutAnchorable>
                            <!-- キーフレームアニメーション編集パネル（.anim のドープシート編集） -->
                            <avd:LayoutAnchorable Title="アニメーション"
                                                  ContentId="animation_timeline"
                                                  CanClose="False"
                                                  CanHide="True"
                                                  CanFloat="True">
                                <panels:AnimationTimelinePanel x:Name="PanelAnimationTimeline"/>
                            </avd:LayoutAnchorable>
                            <avd:LayoutAnchorable Title="エラー一覧"
                                                  ContentId="error_list"
                                                  CanClose="False"
                                                  CanHide="False"
                                                  CanFloat="True">
                                <!-- コンテンツは LoadLayout の LayoutSerializationCallback で設定される -->
                            </avd:LayoutAnchorable>
                            <!-- ランタイムのフレームプロファイラ計測結果を表示するパネル -->
                            <avd:LayoutAnchorable Title="プロファイラ"
                                                  ContentId="profiler"
                                                  CanClose="False"
                                                  CanHide="True"
                                                  CanFloat="True">
                                <panels:ProfilerPanel x:Name="PanelProfiler"/>
                            </avd:LayoutAnchorable>
                        </avd:LayoutAnchorablePane>

                    </avd:LayoutPanel>

                    <!-- 右パネル: Inspector + AI アシスタント -->
                    <avd:LayoutAnchorablePane DockWidth="300" DockMinWidth="200">
                        <avd:LayoutAnchorable Title="Inspector"
                                              ContentId="inspector"
                                              CanClose="False"
                                              CanHide="False"
                                              CanFloat="True">
                            <panels:InspectorPanel x:Name="PanelInspector"/>
                        </avd:LayoutAnchorable>
                        <avd:LayoutAnchorable Title="AI アシスタント"
                                              ContentId="ai_assistant"
                                              CanClose="False"
                                              CanHide="False"
                                              CanFloat="True">
                            <!-- コンテンツは LoadLayout の LayoutSerializationCallback で設定される -->
                        </avd:LayoutAnchorable>
                    </avd:LayoutAnchorablePane>

                </avd:LayoutPanel>
            </avd:LayoutRoot>

        </avd:DockingManager>

    </DockPanel>

    <!-- ── トースト通知（右下オーバーレイ）──────────────────── -->
    <Border x:Name="ToastBorder"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,24,24"
            Padding="14,8"
            CornerRadius="4"
            Background="#CC1E6B3A"
            BorderBrush="#44AAFFAA"
            BorderThickness="1"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            Panel.ZIndex="999">
        <TextBlock x:Name="ToastText"
                   Text="シーンを保存しました"
                   Foreground="#E0FFFFFF"
                   FontSize="12"/>
    </Border>

    </Grid>
</Window>
