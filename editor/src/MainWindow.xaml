<Window x:Class="SEEDEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEED Editor" Height="600" Width="900"
        Background="#1E1E1E"
        Closing="OnWindowClosing">
    <DockPanel>

        <!-- ツールバー -->
        <ToolBar DockPanel.Dock="Top" Background="#2D2D2D" Padding="4,2">
            <Button x:Name="BtnPlay" Content="▶  Play" Width="80"
                    Click="OnPlay"
                    Background="#3C8C3C" Foreground="White" BorderThickness="0" Padding="8,4"/>
            <Separator/>
            <Button x:Name="BtnStop" Content="■  Stop" Width="80"
                    Click="OnStop" IsEnabled="False"
                    Background="#555555" Foreground="White" BorderThickness="0" Padding="8,4"/>
        </ToolBar>

        <!-- ビューポート領域 -->
        <Border x:Name="ViewportBorder"
                Background="Black"
                Margin="4"/>

    </DockPanel>
</Window>
