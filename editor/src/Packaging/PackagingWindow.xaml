<Window
    x:Class="SEEDEditor.Packaging.PackagingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:SEEDEditor.Controls"
    Title="パッケージ化"
    Width="800" Height="560"
    MinWidth="640" MinHeight="400"
    Background="#1E1E1E"
    Foreground="#CCCCCC"
    WindowStartupLocation="CenterOwner"
    Loaded="OnLoaded">

    <Window.Resources>

        <!-- ボタン共通スタイル -->
        <Style x:Key="PkgBtn" TargetType="Button">
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Background"      Value="#3A3A3A"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderBrush"     Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled"   Value="False">
                                <Setter Property="Foreground"   Value="#555555"/>
                                <Setter Property="BorderBrush"  Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#686868"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ビルドボタン（アクセントカラー） -->
        <Style x:Key="BuildBtn" TargetType="Button" BasedOn="{StaticResource PkgBtn}">
            <Setter Property="Background"  Value="#1A5A1A"/>
            <Setter Property="BorderBrush" Value="#2A7A2A"/>
            <Setter Property="Foreground"  Value="#AAFFAA"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Width"       Value="130"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background"  Value="#252525"/>
                                <Setter Property="BorderBrush" Value="#333333"/>
                                <Setter Property="Foreground"  Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#226A22"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A7A1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 設定項目の説明ラベル -->
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#888888"/>
            <Setter Property="FontSize"          Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,8,0"/>
            <Setter Property="Width"             Value="100"/>
        </Style>

        <!-- テキストボックス -->
        <Style x:Key="SettingTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#2A2A2A"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderBrush"     Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="4,2"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="CaretBrush"      Value="#CCCCCC"/>
            <Setter Property="Height"          Value="24"/>
        </Style>

        <!-- コンボボックス（配色はアプリ共通のダークテーマ暗黙スタイルを継承し、寸法のみ指定） -->
        <Style x:Key="SettingCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height"   Value="24"/>
        </Style>

        <!-- 参照ボタン -->
        <Style x:Key="BrowseBtn" TargetType="Button" BasedOn="{StaticResource PkgBtn}">
            <Setter Property="Content"  Value="..."/>
            <Setter Property="Width"    Value="28"/>
            <Setter Property="Height"   Value="24"/>
            <Setter Property="Padding"  Value="0"/>
        </Style>

        <!-- プラットフォーム選択行 -->
        <Style x:Key="PlatformItem" TargetType="Border">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

        <!-- ドロップダウンの配色はアプリ共通のダークテーマ暗黙スタイル（App.xaml）に任せる -->

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- ログエリア -->
            <RowDefinition Height="4"/>
            <RowDefinition Height="150"/>
            <!-- フッター -->
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- ─── 上部: プラットフォーム選択 ＋ 設定 ────────────────── -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="160"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左: プラットフォーム一覧 -->
            <Border Grid.Column="0" Background="#1A1A1A"
                    BorderBrush="#333333" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#252525">
                        <TextBlock Text="ターゲットプラットフォーム"
                                   Foreground="#888888" FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="8,0"/>
                    </Border>
                    <StackPanel x:Name="PlatformList" Grid.Row="1"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch" Background="#2A2A2A"/>

            <!-- 右: 設定エリア -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SettingsPane" Margin="16,12,16,12"/>
            </ScrollViewer>
        </Grid>

        <!-- ─── スプリッター ───────────────────────────────────────── -->
        <GridSplitter Grid.Row="1" Height="4"
                      HorizontalAlignment="Stretch" Background="#2A2A2A"/>

        <!-- ─── ビルドログ ─────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="#111111"
                BorderBrush="#2A2A2A" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#1A1A1A">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock Text="ビルドログ" Foreground="#888888" FontSize="10" FontWeight="Bold"/>
                        <Button Content="クリア" Style="{StaticResource PkgBtn}"
                                Height="16" Padding="6,0" Margin="12,0,0,0"
                                FontSize="9" Click="OnClearLog"/>
                    </StackPanel>
                </Border>
                <ScrollViewer x:Name="LogScroll" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="#CCCCCC"
                               TextWrapping="NoWrap"
                               Margin="8,4"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ─── フッター ───────────────────────────────────────────── -->
        <Border Grid.Row="3" Background="#252525"
                BorderBrush="#333333" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 進捗バー -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ProgressBar x:Name="BuildProgress"
                                 Height="6" Minimum="0" Maximum="100" Value="0"
                                 Foreground="#33AA33" Background="#2A2A2A"
                                 BorderBrush="#3A3A3A"
                                 Visibility="Collapsed"/>
                    <TextBlock x:Name="StatusText"
                               Text="プラットフォームを選択してビルドを開始してください"
                               Foreground="#666666" FontSize="10"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- ビルドボタン -->
                <Button Grid.Column="1"
                        x:Name="BtnBuild"
                        Style="{StaticResource BuildBtn}"
                        IsEnabled="False"
                        Click="OnBuild">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ctrl:AppIcon IconKey="Icon.Build" Width="15" Height="15"/>
                        <TextBlock Text="ビルド開始" Margin="7,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
