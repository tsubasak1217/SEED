<Window x:Class="SEEDEditor.Terrain.TerrainSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:SEEDEditor.Controls"
        Title="地形設定"
        Height="620" Width="880"
        MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="#DDDDDD"
        FontSize="12">

    <!--
        地形設定ウィンドウ。
        タブ構成にしてあるのは将来の拡張（ブラシテクスチャ・散布設定など）を
        「タブを 1 枚足すだけ」で受けられるようにするため。
        タブごとの中身は独立しており、レイヤタブは layers.json を直接編集する。
    -->

    <Window.Resources>
        <!-- ツールボタン共通スタイル（追加/複製/削除/並べ替え）。 -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#333333"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderBrush"     Value="#454545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="Margin"          Value="0,0,4,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#666666"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- セクション見出し。 -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7FB4E0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"     Value="0,10,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="#1E1E1E" BorderBrush="#3A3A3A">

            <!-- ── 地形タブ: チャンク構成（chunk_config.json）の編集 ─────────
                 中身はコードビハインド（RebuildTerrainConfigPanel）で組み立てる。
                 レイヤタブと同じく、フィールド追加時に XAML を触らずに済むようにするため。 -->
            <TabItem Header="地形">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanelTerrainConfig" Margin="12"/>
                </ScrollViewer>
            </TabItem>

            <!-- ── レイヤタブ: layers.json の編集 ───────────────────────── -->
            <TabItem Header="レイヤ">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左: レイヤ一覧＋操作ボタン。並び順がレイヤ番号かつ優先度評価順になる。 -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="レイヤ一覧（上から順にレイヤ番号 0, 1, 2 …）"
                                   Foreground="#999999" TextWrapping="Wrap" Margin="0,0,0,4"/>

                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button x:Name="BtnAddLayer"       Style="{StaticResource ToolButtonStyle}"
                                    Content="追加"   ToolTip="新しいレイヤを末尾に追加する"
                                    Click="OnAddLayer"/>
                            <Button x:Name="BtnDuplicateLayer" Style="{StaticResource ToolButtonStyle}"
                                    Content="複製"   ToolTip="選択中のレイヤを複製する"
                                    Click="OnDuplicateLayer"/>
                            <Button x:Name="BtnRemoveLayer"    Style="{StaticResource ToolButtonStyle}"
                                    Content="削除"   ToolTip="選択中のレイヤを削除する（最低 1 枚は残る）"
                                    Click="OnRemoveLayer"/>
                            <Button x:Name="BtnMoveLayerUp"    Style="{StaticResource ToolButtonStyle}"
                                    ToolTip="1 つ上へ移動（レイヤ番号が変わる）"
                                    Click="OnMoveLayerUp">
                                <ctrl:AppIcon IconKey="Icon.MoveUp" Width="11" Height="11"/>
                            </Button>
                            <Button x:Name="BtnMoveLayerDown"  Style="{StaticResource ToolButtonStyle}"
                                    ToolTip="1 つ下へ移動（レイヤ番号が変わる）"
                                    Click="OnMoveLayerDown">
                                <ctrl:AppIcon IconKey="Icon.MoveDown" Width="11" Height="11"/>
                            </Button>
                        </WrapPanel>

                        <ListBox x:Name="LstLayers"
                                 Background="#252526" Foreground="#DDDDDD"
                                 BorderBrush="#3A3A3A" BorderThickness="1"
                                 SelectionChanged="OnLayerSelectionChanged"/>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                  Background="#2D2D30"/>

                    <!-- 右: 選択レイヤのプロパティ。中身はコードビハインドで組み立てる
                         （フィールドが増えても XAML を編集せずに済む＆型ごとの行生成を関数化できる）。 -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PanelLayerProperties" Margin="8,0,4,0"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ── 散布タブ: props.json の編集（Terrain T3）─────────────────
                 プロップ（草・木などの散布物）定義の一覧と、選択プロップの
                 パラメータ編集（草／風／散布／ルール）。右ペインの中身は
                 レイヤタブと同じくコードビハインドで組み立てる
                 （kind による条件付き表示をコードで一元管理するため）。 -->
            <TabItem Header="散布">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左: プロップ一覧＋操作ボタン。並び順が props.json の並び（prop 添字）になる。 -->
                    <DockPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="プロップ一覧（草・木などの散布物）"
                                   Foreground="#999999" TextWrapping="Wrap" Margin="0,0,0,4"/>

                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button x:Name="BtnAddProp"       Style="{StaticResource ToolButtonStyle}"
                                    Content="追加"   ToolTip="新しいプロップを末尾に追加する"
                                    Click="OnAddProp"/>
                            <Button x:Name="BtnDuplicateProp" Style="{StaticResource ToolButtonStyle}"
                                    Content="複製"   ToolTip="選択中のプロップを複製する"
                                    Click="OnDuplicateProp"/>
                            <Button x:Name="BtnRemoveProp"    Style="{StaticResource ToolButtonStyle}"
                                    Content="削除"   ToolTip="選択中のプロップを削除する（最低 1 種は残る）"
                                    Click="OnRemoveProp"/>
                            <Button x:Name="BtnMovePropUp"    Style="{StaticResource ToolButtonStyle}"
                                    ToolTip="1 つ上へ移動"
                                    Click="OnMovePropUp">
                                <ctrl:AppIcon IconKey="Icon.MoveUp" Width="11" Height="11"/>
                            </Button>
                            <Button x:Name="BtnMovePropDown"  Style="{StaticResource ToolButtonStyle}"
                                    ToolTip="1 つ下へ移動"
                                    Click="OnMovePropDown">
                                <ctrl:AppIcon IconKey="Icon.MoveDown" Width="11" Height="11"/>
                            </Button>
                        </WrapPanel>

                        <ListBox x:Name="LstProps"
                                 Background="#252526" Foreground="#DDDDDD"
                                 BorderBrush="#3A3A3A" BorderThickness="1"
                                 SelectionChanged="OnPropSelectionChanged"/>
                    </DockPanel>

                    <GridSplitter Grid.Row="0" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                  Background="#2D2D30"/>

                    <!-- 右: 選択プロップのプロパティ（kind に応じて表示項目が変わる）。 -->
                    <ScrollViewer Grid.Row="0" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PanelPropProperties" Margin="8,0,4,0"/>
                    </ScrollViewer>

                    <!-- 下: ルールによる再散布。シードを固定すれば同じ配置を再現できる。 -->
                    <Border Grid.Row="1" Grid.ColumnSpan="3"
                            Background="#252526" BorderBrush="#3A3A3A" BorderThickness="1"
                            Padding="6" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="対象" Foreground="#AAAAAA"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="CmbScatterTarget" Width="150" VerticalAlignment="Center"
                                      ToolTip="再散布するプロップ（すべて＝全プロップを一括で撒き直す）">
                                <ComboBoxItem Content="選択中のプロップ" IsSelected="True" Tag="selected"/>
                                <ComboBoxItem Content="すべて" Tag="all"/>
                            </ComboBox>

                            <TextBlock Text="シード" Foreground="#AAAAAA"
                                       VerticalAlignment="Center" Margin="12,0,4,0"/>
                            <TextBox x:Name="TxtScatterSeed" Text="0"
                                     Width="120" VerticalAlignment="Center"
                                     Background="#1A1A1A" Foreground="#DDDDDD"
                                     BorderBrush="#3F3F46" BorderThickness="1"
                                     FontFamily="Consolas" Padding="3,1"
                                     ToolTip="乱数シード（同じ値なら同じ配置になる）"/>
                            <Button x:Name="BtnScatterRandomSeed" Style="{StaticResource ToolButtonStyle}"
                                    Content="ランダム" Margin="4,0,0,0"
                                    ToolTip="新しいシードを生成する"
                                    Click="OnScatterRandomSeed"/>

                            <Button x:Name="BtnScatterRules" Style="{StaticResource ToolButtonStyle}"
                                    Content="ルールで再散布" Padding="14,4" Margin="12,0,0,0"
                                    ToolTip="TERRAIN_SCATTER_RULES を送り、ルールに従って全チャンクを撒き直す（手ペイントした散布は失われる）"
                                    Click="OnScatterRules"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ── ブラシタブ: ブラシ共通設定（形状マスク）───────────────
                 中身は TerrainSettingsWindow.Brush.cs が動的に組み立てる
                 （ファイル参照行はインスペクタと共通の FileRefBuilder を使うため、
                  XAML では器だけを用意して C# 側から差し込む）。 -->
            <TabItem Header="ブラシ">
                <StackPanel x:Name="BrushTabPanel" Margin="12"/>
            </TabItem>
        </TabControl>

        <!-- ── フッタ: 状態表示と確定ボタン ──────────────────────────── -->
        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock x:Name="TxtStatus" DockPanel.Dock="Left"
                       Foreground="#888888" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnApply" Style="{StaticResource ToolButtonStyle}"
                        Content="保存して適用" Padding="14,4"
                        ToolTip="layers.json へ保存し、ランタイムへ再読込を指示する（ウィンドウは閉じない）"
                        Click="OnApply"/>
                <Button x:Name="BtnClose" Style="{StaticResource ToolButtonStyle}"
                        Content="閉じる" Padding="14,4" Margin="0"
                        ToolTip="ウィンドウを閉じる（未保存の変更は破棄される）"
                        Click="OnCloseClicked"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
