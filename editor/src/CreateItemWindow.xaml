<Window x:Class="SEEDEditor.CreateItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新規作成"
        Width="390"
        SizeToContent="Height"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Loaded="OnLoaded"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <Style x:Key="ItemRowStyle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="#CCCCCC"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Padding"                    Value="0"/>
            <!-- キーボード選択の見た目は下の IsKeyboardFocused トリガーで表現するため、
                 WPF 既定の点線フォーカス枠は消す（二重表示を避ける）。 -->
            <Setter Property="FocusVisualStyle"            Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="5,2,5,2"
                                Padding="14,10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 上下キーでの選択（キーボードフォーカス）を明示する。
                                 ホバーと同じ配色 + 枠線で「Enter で決定される行」を示す。 -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#2A4A6A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5599DD"/>
                                <Setter Property="Foreground"                  Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A4A6A"/>
                                <Setter Property="Foreground"                 Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E3A55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel>

        <!-- ヘッダー -->
        <Border Background="#252525" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1"
                Padding="14,9">
            <TextBlock Text="作成するアイテムを選択してください"
                       Foreground="#888888" FontSize="12"/>
        </Border>

        <!-- アイテム一覧（上下キーでの選択対象。コードから子 Button を順に辿る） -->
        <StackPanel x:Name="ItemsPanel" Margin="0,6,0,10">

            <Button Style="{StaticResource ItemRowStyle}" Click="OnCreateActor3D">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/resources/icons/folderview/actor.png"
                           Width="34" Height="34"
                           Margin="0,0,14,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Actor (3D)"
                                   Foreground="#DDDDDD" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="空の 3D アクターファイルを作成"
                                   Foreground="#777777" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource ItemRowStyle}" Click="OnCreateActor2D">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/resources/icons/folderview/actor.png"
                           Width="34" Height="34"
                           Margin="0,0,14,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Actor (2D)"
                                   Foreground="#DDDDDD" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="空の 2D アクターファイルを作成（CanvasTransform）"
                                   Foreground="#777777" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource ItemRowStyle}" Click="OnCreateScript">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/resources/icons/folderview/script.png"
                           Width="34" Height="34"
                           Margin="0,0,14,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Script"
                                   Foreground="#DDDDDD" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="C# スクリプトファイルを作成"
                                   Foreground="#777777" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource ItemRowStyle}" Click="OnCreateScene">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/resources/icons/folderview/scene.png"
                           Width="34" Height="34"
                           Margin="0,0,14,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Scene"
                                   Foreground="#DDDDDD" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="空のシーンファイル (.scene) を作成"
                                   Foreground="#777777" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource ItemRowStyle}" Click="OnCreateMaterial">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/resources/icons/folderview/image.png"
                           Width="34" Height="34"
                           Margin="0,0,14,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Material"
                                   Foreground="#DDDDDD" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="既定 PBR のマテリアルファイル (.mat) を作成"
                                   Foreground="#777777" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource ItemRowStyle}" Click="OnCreateShader">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/resources/icons/folderview/script.png"
                           Width="34" Height="34"
                           Margin="0,0,14,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Shader"
                                   Foreground="#DDDDDD" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="シェーディングアセット (.wgsl) を作成"
                                   Foreground="#777777" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource ItemRowStyle}" Click="OnCreatePostFX">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/resources/icons/folderview/image.png"
                           Width="34" Height="34"
                           Margin="0,0,14,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Post Effect"
                                   Foreground="#DDDDDD" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="ポストエフェクトファイル (.postfx) を作成"
                                   Foreground="#777777" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Button>

        </StackPanel>

    </StackPanel>
</Window>
