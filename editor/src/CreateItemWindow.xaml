<Window x:Class="SEEDEditor.CreateItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新規作成"
        Width="390"
        SizeToContent="Height"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Loaded="OnLoaded">

    <Window.Resources>
        <Style x:Key="ItemRowStyle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="#CCCCCC"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Padding"                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Margin="5,2,5,2"
                                Padding="14,10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A4A6A"/>
                                <Setter Property="Foreground"                 Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E3A55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel>

        <!-- ヘッダー -->
        <Border Background="#252525" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1"
                Padding="14,9">
            <TextBlock Text="作成するアイテムを選択してください"
                       Foreground="#888888" FontSize="12"/>
        </Border>

        <!-- アイテム一覧 -->
        <StackPanel Margin="0,6,0,10">

            <Button Style="{StaticResource ItemRowStyle}" Click="OnCreateActor3D">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/resources/icons/folderview/actor.png"
                           Width="34" Height="34"
                           Margin="0,0,14,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Actor (3D)"
                                   Foreground="#DDDDDD" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="空の 3D アクターファイルを作成"
                                   Foreground="#777777" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource ItemRowStyle}" Click="OnCreateActor2D">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/resources/icons/folderview/actor.png"
                           Width="34" Height="34"
                           Margin="0,0,14,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Actor (2D)"
                                   Foreground="#DDDDDD" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="空の 2D アクターファイルを作成（CanvasTransform）"
                                   Foreground="#777777" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource ItemRowStyle}" Click="OnCreateScript">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/resources/icons/folderview/script.png"
                           Width="34" Height="34"
                           Margin="0,0,14,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Script"
                                   Foreground="#DDDDDD" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="C# スクリプトファイルを作成"
                                   Foreground="#777777" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Button>

        </StackPanel>

    </StackPanel>
</Window>
