<Window x:Class="SEEDEditor.ProjectSettings.ProjectSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="プロジェクト設定"
        Width="860" Height="560" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#1E1E1E"
        Loaded="OnLoaded">

    <Window.Resources>

        <!-- ── アクションボタン（保存・キャンセル）スタイル ─────── -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding"  Value="16,6"/>
            <Setter Property="Cursor"   Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 設定フィールド テキストボックス スタイル ────────── -->
        <Style x:Key="SettingTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#2A2A2A"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="CaretBrush"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="RootBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Auto"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- フォーカス時にボーダーをアクセントカラーに変える -->
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="RootBd" Property="BorderBrush" Value="#3399FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 参照ボタン スタイル ──────────────────────────────── -->
        <Style x:Key="BrowseButton" TargetType="Button">
            <Setter Property="Background"      Value="#3A3A3A"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderBrush"     Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#686868"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- メインコンテンツ（左カテゴリ + 右設定パネル）-->
            <RowDefinition Height="*"/>
            <!-- フッター区切り線 -->
            <RowDefinition Height="1"/>
            <!-- フッター（保存/キャンセルボタン）-->
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <!-- ── メインコンテンツ ─────────────────────────────────── -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- 左: カテゴリパネル（固定幅） -->
                <ColumnDefinition Width="200"/>
                <!-- 縦区切り線 -->
                <ColumnDefinition Width="1"/>
                <!-- 右: 設定パネル（残り全幅） -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左: カテゴリツリー -->
            <Border Grid.Column="0" Background="#252526">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <!-- カテゴリツリーは code-behind で動的構築する -->
                    <StackPanel x:Name="CategoryPanel" Margin="0,8,0,8"/>
                </ScrollViewer>
            </Border>

            <!-- 縦区切り線 -->
            <Border Grid.Column="1" Background="#3A3A3A"/>

            <!-- 右: 選択された小項目の設定パネル -->
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <!-- 設定コンテンツは code-behind で SelectSubItem() が切り替える -->
                <ContentControl x:Name="SettingsContent" Margin="24,24,24,24"/>
            </ScrollViewer>
        </Grid>

        <!-- フッター区切り線 -->
        <Border Grid.Row="1" Background="#3A3A3A"/>

        <!-- ── フッター ──────────────────────────────────────────── -->
        <Grid Grid.Row="2" Background="#252526">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <Button x:Name="BtnSave"
                        Content="保存して閉じる"
                        Background="#1A4A7A"
                        Foreground="White"
                        BorderBrush="#2A5A8A"
                        Style="{StaticResource ActionButton}"
                        Click="OnSave"/>
                <Button Content="キャンセル"
                        Background="#2A2A2A"
                        Foreground="#AAAAAA"
                        BorderBrush="#444444"
                        IsCancel="True"
                        Style="{StaticResource ActionButton}"
                        Margin="8,0,0,0"
                        Click="OnCancel"/>
            </StackPanel>
        </Grid>
    </Grid>

</Window>
