<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- SDK のデフォルト Page グロブを無効化し、src/ を明示指定する -->
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- src/ 配下の App.xaml を ApplicationDefinition として明示指定する。     -->
    <!-- SDK のデフォルトグロブはプロジェクトルートの App.xaml を想定しているため、 -->
    <!-- サブディレクトリに移動した場合は Page 扱いになってしまうので上書きする。   -->
    <ApplicationDefinition Remove="App.xaml" />
    <ApplicationDefinition Include="src\App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>

    <!-- src/ 配下の残りの XAML を Page として登録する。 -->
    <Page Include="src\**\*.xaml" Exclude="src\App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>

    <!-- アイコン資産置き場（resources/icons/）にあるベクターアイコン辞書。       -->
    <!-- EnableDefaultPageItems=false で既定グロブを切っているため、src/ の外に   -->
    <!-- ある XAML はここで明示的に Page 登録しないとビルド出力に入らない。       -->
    <Page Include="resources\icons\*.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <!-- WPF の _wpftmp 内部プロジェクトが SeedMcpServer サブディレクトリの     -->
  <!-- obj/ 生成ファイルを拾って属性重複エラーになるのを防ぐ。               -->
  <ItemGroup>
    <Compile  Remove="SeedMcpServer\**" />
    <EmbeddedResource Remove="SeedMcpServer\**" />
    <None     Remove="SeedMcpServer\**" />
    <Content  Remove="SeedMcpServer\**" />
    <Page     Remove="SeedMcpServer\**" />
  </ItemGroup>

  <!-- アルゴリズム単体テスト（editor/tests/）は独立したコンソールプロジェクトなので、  -->
  <!-- 既定グロブで本体へ取り込まれないように除外する（Main の重複を防ぐ）。          -->
  <ItemGroup>
    <Compile  Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None     Remove="tests\**" />
    <Content  Remove="tests\**" />
    <Page     Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" Version="4.74.0" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.74.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <!-- Ctrl+K,D のコード整形（Formatter）に必要 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
    <!-- IntelliSense 補完（CompletionService）と F12 定義ジャンプに必要 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="4.8.0" />
    <!-- スクリプトエディタのシンタックスハイライト用テキストエディタコントロール -->
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
  </ItemGroup>

  <ItemGroup>
    <!-- ユーザースクリプトの基底クラス（SEED.Scripting.ScriptComponent）と
         SerializeField 属性をランタイムと共有するための参照 -->
    <ProjectReference Include="..\scripting\SEEDScripting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="resources\icons\**\*.png"/>
    <Resource Include="resources\images\**\*.png"/>
  </ItemGroup>

  <!-- スクリプトエディタの追加シンタックスハイライト定義（AvalonEdit xshd）。 -->
  <!-- 既定のリソース名はディレクトリ構成に依存して長くなるため、コード側        -->
  <!-- （WgslHighlighting.ResourceName）と一致する短い LogicalName を明示する。  -->
  <ItemGroup>
    <EmbeddedResource Include="src\Panels\ScriptEditor\Syntax\Wgsl.xshd">
      <LogicalName>SEEDEditor.Wgsl.xshd</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- スクリプト API リファレンス（AI インライン補完の正典）を出力ディレクトリへコピーし、 -->
  <!-- 実行時に ScriptApiReference が確実に読み込めるようにする。                          -->
  <ItemGroup>
    <Content Include="..\docs\scripting_api.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>scripting_api.md</Link>
    </Content>
  </ItemGroup>

  <!-- SeedMcpServer をメインビルド後に独立してビルドし、出力を同じディレクトリへコピーする。 -->
  <!-- ProjectReference を使わないことで WPF の _wpftmp 中間プロジェクトとの衝突を回避する。 -->
  <Target Name="BuildAndCopySeedMcpServer" AfterTargets="Build" Condition="'$(CI)'!='true'">
    <!-- SeedMcpServer 自身をビルドする（restore も内部で自動実行される）-->
    <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)\SeedMcpServer\SeedMcpServer.csproj&quot; -c $(Configuration)"
          StandardOutputImportance="low"
          StandardErrorImportance="normal" />
    <!-- ビルド結果を SEEDEditor.exe と同じディレクトリへ全ファイルコピーする。        -->
    <!-- .exe だけでなく .dll / .runtimeconfig.json / .deps.json も必須。           -->
    <!-- これらが揃っていないと AppHost (.exe) がランタイムを起動できず MCP が失敗する。 -->
    <ItemGroup>
      <_SeedMcpServerFiles Include="$(MSBuildProjectDirectory)\SeedMcpServer\bin\$(Configuration)\net9.0\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_SeedMcpServerFiles)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
