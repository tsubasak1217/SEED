<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- SDK のデフォルト Page グロブを無効化し、src/ を明示指定する -->
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- src/ 配下の App.xaml を ApplicationDefinition として明示指定する。     -->
    <!-- SDK のデフォルトグロブはプロジェクトルートの App.xaml を想定しているため、 -->
    <!-- サブディレクトリに移動した場合は Page 扱いになってしまうので上書きする。   -->
    <ApplicationDefinition Remove="App.xaml" />
    <ApplicationDefinition Include="src\App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>

    <!-- src/ 配下の残りの XAML を Page として登録する。 -->
    <Page Include="src\**\*.xaml" Exclude="src\App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" Version="4.74.0" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.74.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="resources\icons\**\*.png"/>
    <Resource Include="resources\images\**\*.png"/>
  </ItemGroup>

  <!-- llama-server.exe と依存 DLL をビルド出力ディレクトリへコピーする -->
  <ItemGroup>
    <Content Include="src\AI\LocalLlm\llama-server.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>llama-server.exe</Link>
    </Content>
    <!-- llama.cpp Vulkan 版の依存 DLL（出力ディレクトリ直下にフラットコピー） -->
    <Content Include="src\AI\LocalLlm\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
