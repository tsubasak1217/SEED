<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SEED.UI の一覧（ListView）とスワイプの操作（SwipeActions）の純粋な計算の単体テスト（W2-3）。

    ScriptEntityHandleTests / ComponentCatalogTests と同じ方針:
      1. 外部パッケージ（xunit 等）に依存させず、素のコンソールアプリ + 自前アサート
         → NuGet の追加取得なしで `dotnet run` だけで回せる
      2. SEEDScripting 本体（ランタイム FFI に依存）を参照せず、対象ソースをリンクで取り込む
         → 並びの計算・使い回しの割り当て・スワイプの判定がエンジンの API に依存し始めた瞬間に
           本テストがビルドできなくなる（＝純粋な計算として分けてあることの検知器）

    確かめること: 行の先頭の位置・全体の長さ・位置から行・見える行の範囲（固定の長さと行ごと・間隔と余白）、
    行を窓に見せる位置、使い回しの割り当て（外れた行を先に使う・付いたままの行は動かさない・足りなければ作る数を返す・
    ランダムなスクロールで 1 行 1 スロットの不変条件）、スワイプの開く・閉じるの判定と動きの曲線。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SEEDEditor.Tests.UiListView</RootNamespace>
    <AssemblyName>UiListViewTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- テスト対象（SEED.UI の純粋な計算） -->
    <Compile Include="..\..\..\scripting\src\Api\UI\ListViewLayout.cs">
      <Link>Linked\ListViewLayout.cs</Link>
    </Compile>
    <Compile Include="..\..\..\scripting\src\Api\UI\ListViewRecycler.cs">
      <Link>Linked\ListViewRecycler.cs</Link>
    </Compile>
    <Compile Include="..\..\..\scripting\src\Api\UI\SwipeMath.cs">
      <Link>Linked\SwipeMath.cs</Link>
    </Compile>
    <!-- テストランナーは SpriteRigTests のものを共有する（同じ仕組みを二重に持たない） -->
    <Compile Include="..\SpriteRigTests\TestHarness.cs">
      <Link>Linked\TestHarness.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
