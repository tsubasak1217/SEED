<Project Sdk="Microsoft.NET.Sdk">

  <!--
    自動再読込ポリシー（AutoReloadPolicy）の単体テスト。

    対象:
      - Decide                : 状態 × 種別 × 設定 → 適用 / 保留 / 破棄
      - DecideOnReturnToEdit  : Play 停止時に保留分を適用してよいか
      - IsPlaying             : Play / Pause を「実行中」として扱うこと
      - DecidePrefabExternalChange / PrefabWatchPaths / PrefabExternalChangeTracker
                              : プレハブの外部変更の判定表・監視の対象・デバウンスと自己書き込みの除外
                                （PrefabAutoReloadTests.cs）

    AiSafetyTests / ScriptEntityHandleTests と同じ流儀:
      - xunit 等の外部パッケージを足さず、素のコンソールアプリ + 自前アサートで回す
      - SEEDEditor 本体（WPF / WinExe）は参照せず、WPF 非依存のファイルだけをリンクで取り込む
        （AutoReloadPolicy が WPF・ランタイム型を使い始めたらビルドが壊れ、
          それが「判定ロジックが純粋であること」の検知器になる）

    実行方法: dotnet run (project=editor/tests/AutoReloadPolicyTests)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SEEDEditor.Tests.AutoReloadPolicy</RootNamespace>
    <AssemblyName>AutoReloadPolicyTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- テスト対象（WPF 非依存の純粋な判定ロジック） -->
    <Compile Include="..\..\src\Reload\AutoReloadPolicy.cs">
      <Link>Linked\Reload\AutoReloadPolicy.cs</Link>
    </Compile>
    <!-- プレハブの外部変更の取り込み（docs/editor_auto_reload.md §7.1）: 監視の対象のパスと、
         デバウンス・自己書き込みの除外の追跡器（どちらも WPF・ファイルシステム非依存） -->
    <Compile Include="..\..\src\Reload\PrefabWatchPaths.cs">
      <Link>Linked\Reload\PrefabWatchPaths.cs</Link>
    </Compile>
    <Compile Include="..\..\src\Reload\PrefabExternalChangeTracker.cs">
      <Link>Linked\Reload\PrefabExternalChangeTracker.cs</Link>
    </Compile>
    <!-- 監視の開始時の覚え込み（覚えてよいファイルの選び方。読み取りの関数を差し替えて試す。2 回目のレビュー #15） -->
    <Compile Include="..\..\src\Reload\PrefabKnownHashSeeder.cs">
      <Link>Linked\Reload\PrefabKnownHashSeeder.cs</Link>
    </Compile>
    <!-- 覚え込みが使う内容のハッシュ（監視の判定と同じ関数。本物のフォルダで読み取りを通すテストに使う） -->
    <Compile Include="..\..\src\Reload\FileContentHash.cs">
      <Link>Linked\Reload\FileContentHash.cs</Link>
    </Compile>
    <!-- テストランナーは SpriteRigTests のものを共有する（同じ仕組みを二重に持たない） -->
    <Compile Include="..\SpriteRigTests\TestHarness.cs">
      <Link>Linked\TestHarness.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
