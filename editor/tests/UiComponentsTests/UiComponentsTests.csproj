<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SEED.UI の基本の部品（W2-4）の「状態 → 見た目」と値の計算の単体テスト。

    UiListViewTests と同じ方針:
      1. 外部パッケージ（xunit 等）に依存させず、素のコンソールアプリ + 自前アサート（SpriteRigTests の TestHarness を共有）
      2. SEEDScripting 本体（ランタイム FFI に依存）を参照せず、対象ソースをリンクで取り込む
         → 見た目の決め方・値の計算がエンジンの API に依存し始めた瞬間に本テストがビルドできなくなる
           （＝部品のスクリプトから純粋な計算として分けてあることの検知器）

    確かめること: テーマの JSON の読み方（グループの平坦化・sRGB → 線形・説明の鍵を読まない・壊れた JSON・代わりのテーマ）、
    既定のテーマが部品の読むトークンをすべて持つこと、ボタン・スイッチ・チェックボックス・選択の項目の見た目（押下・無効・選択）、
    スライダの値（段階・範囲・指の位置）、数値欄（増減・文字の解釈・長押しの連続の間隔）、進捗、選択の状態（1 つ・外せる・複数・選べない）、
    動き（UiTween の途中の行き先の変更）。
    W2-5: ホイールの行の見た目（距離 → 位置・縮み・拡大・濃さ。Flutter の円柱の投影の行列と照合）と逆算（タップ）、循環の添字（負・大きな値）と
    近い向きの行・真ん中の周へ戻す判定、位置 ↔ 行、選べる行の探し方、12/24 時間の変換と午前/午後の連動、分の刻みの丸め。
    W2-7: 動きの曲線、画面の出入りの置き方、画面のスタックの積み下ろしと落ち着いた状態（見せる・隠す・手放す）、タブごとのスタックと戻る、
    戻るの段の順序（128 通りの状態で 1 回ずつ押す）、ダイアログのボタン・結果・本文の行の見積もり、シートの段と閉じる判定・幕の濃さ、
    ドラッグで閉じる判定、トーストの並びと時間、フォーカスの範囲と移り方、重なりのレイヤーの帯、タブの見た目。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SEEDEditor.Tests.UiComponents</RootNamespace>
    <AssemblyName>UiComponentsTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 色の型（純粋な値型） -->
    <Compile Include="..\..\..\scripting\src\Api\Color.cs">
      <Link>Linked\Color.cs</Link>
    </Compile>
    <Compile Include="..\..\..\scripting\src\Api\Mathf.cs">
      <Link>Linked\Mathf.cs</Link>
    </Compile>
    <Compile Include="..\..\..\scripting\src\Api\Vector2.cs">
      <Link>Linked\Vector2.cs</Link>
    </Compile>
    <Compile Include="..\..\..\scripting\src\Api\Vector3.cs">
      <Link>Linked\Vector3.cs</Link>
    </Compile>
    <!-- テスト対象（SEED.UI のテーマ・見た目・値の計算） -->
    <Compile Include="..\..\..\scripting\src\Api\UI\Theme\UiTokens.cs">
      <Link>Linked\UiTokens.cs</Link>
    </Compile>
    <Compile Include="..\..\..\scripting\src\Api\UI\Theme\UiThemeData.cs">
      <Link>Linked\UiThemeData.cs</Link>
    </Compile>
    <Compile Include="..\..\..\scripting\src\Api\UI\Theme\UiColorMath.cs">
      <Link>Linked\UiColorMath.cs</Link>
    </Compile>
    <Compile Include="..\..\..\scripting\src\Api\UI\Looks\*.cs">
      <Link>Linked\Looks\%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\..\..\scripting\src\Api\UI\SwipeMath.cs">
      <Link>Linked\SwipeMath.cs</Link>
    </Compile>
    <!-- W2-5: ホイールの純粋な計算（行の曲面の見た目・循環の添字と位置・時刻の 12/24 時間と連動と分の刻み） -->
    <Compile Include="..\..\..\scripting\src\Api\UI\Wheel\*.cs">
      <Link>Linked\Wheel\%(Filename)%(Extension)</Link>
    </Compile>
    <!-- W2-7: 画面の組み立ての純粋な計算（出入りの置き方・スタック・タブ・戻るの段・ダイアログ・シート・トースト・フォーカス・レイヤー） -->
    <Compile Include="..\..\..\scripting\src\Api\UI\Navigation\Model\*.cs">
      <Link>Linked\Navigation\%(Filename)%(Extension)</Link>
    </Compile>
    <!-- 既定のテーマのデータ（SEEDScripting に埋め込むものと同じファイル）を出力へ写す -->
    <None Include="..\..\..\scripting\src\Api\UI\Theme\default_theme.json">
      <Link>default_theme.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- テストランナーは SpriteRigTests のものを共有する（同じ仕組みを二重に持たない） -->
    <Compile Include="..\SpriteRigTests\TestHarness.cs">
      <Link>Linked\TestHarness.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
