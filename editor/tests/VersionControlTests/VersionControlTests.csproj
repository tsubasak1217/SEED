<Project Sdk="Microsoft.NET.Sdk">

  <!--
    バージョン管理（Lore）中核層の単体テスト。

    ProjectSystemTests / AssetsRootProbeTests と同じ流儀:
      - xunit 等を足さず、素のコンソールアプリ + 自前アサート（SpriteRigTests/TestHarness.cs）で回す
      - SEEDEditor 本体（WPF / WinExe）は参照せず、必要なファイルだけをリンクで取り込む

    テストは 2 段構え:
      1. 純粋ロジック（既定で常に実行）
         ILoreBackend に偽物（FakeLoreBackend）を差し、Lore も実サーバも無しで
         判断ロジックを固定する。ここが本体。
      2. 実サーバ結合（環境変数 SEED_LORE_TEST_SERVER があるときだけ実行）
         一時フォルダに loreserver を起動し、本物の LoreNativeBackend を通す。

    2 のために LoreVcs を参照している。RuntimeIdentifier=win-x64 が無いと
    ネイティブ lorelib.dll が出力に入らず DllNotFoundException になる。
    （本体 editor/SEEDEditor.csproj と違い、テストは出力パスが深くなっても困らないので
      AppendRuntimeIdentifierToOutputPath は既定のままにしてある）

    実行方法（XML コメント内に連続ハイフンは書けないので [DD] を "‐‐" と読み替える）:
      dotnet run [DD]project editor/tests/VersionControlTests
          … 純粋ロジックのみ
      $env:SEED_LORE_TEST_SERVER=1; dotnet run [DD]project editor/tests/VersionControlTests
          … 実サーバ結合も実行
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SEEDEditor.Tests.VersionControl</RootNamespace>
    <AssemblyName>VersionControlTests</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LoreVcs" Version="0.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- ── 設定・文言・パス変換（WPF / LoreVcs 非依存）── -->
