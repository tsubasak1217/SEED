<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SEED.Localization（多言語。scripting/src/Api/Localization/。正典 docs/localization.md）の純粋な部分の単体テスト。

    UiComponentsTests と同じ方針:
      1. 外部パッケージ（xunit 等）に依存させず、素のコンソールアプリ + 自前アサート（SpriteRigTests の TestHarness を共有）
      2. SEEDScripting 本体（ランタイム FFI に依存）を参照せず、純粋な部分（Localization/Model/*.cs）をリンクで取り込む
         → 表の読み込み・差し込み・複数形・探す順・欠けの方針・保存のキーがエンジンの API（Assets・SaveData・Debug）に
           依存し始めた瞬間に本テストがビルドできなくなる（＝読み込み元と保存先を差し替えられることの検知器）

    確かめること: JSON の平たん化（入れ子・配列・説明の鍵・null・数・複数形のまとまり・重なり・壊れた JSON）、言語の一覧
    （既定・fallback・重なり・言語の引き当て・探す順の輪）、差し込み（{name}・{0}・{name:書式}・{{ }}・Text の記法を残す）、
    複数形の規則（ja・en・fr・ru・pl・cs・ar・he・pt と pt-PT・負の数）、本体（探す順・欠けの方針・キーごとに 1 回の警告・
    起動の言語の決まり方・保存のキー l10n.language・端末に合わせる・書き換えの検知・置き場）、数と日付の書式、
    Invariant の環境（Android の CoreCLR と同じ。子のプロセスを DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 で走らせる）、
    templates/locale の表（キーと差し込みが言語の間でそろう）と、テンプレートの取り込み（editor/src/Templates）で
    assets/locale へ入ること（取り込んだ表を本体で読めること）。

    実行方法: dotnet run（project = editor/tests/LocalizationTests。XML のコメントにハイフン 2 つを書けないので引数の名前は省く）
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SEEDEditor.Tests.Localization</RootNamespace>
    <AssemblyName>LocalizationTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- テスト対象: 多言語の純粋な部分（エンジンの API を使わない。L10n・スクリプト・当てる先は実行中だけのもの） -->
    <Compile Include="..\..\..\scripting\src\Api\Localization\Model\*.cs">
      <Link>Linked\Localization\%(Filename)%(Extension)</Link>
    </Compile>

    <!-- テンプレートの取り込み（editor/src/Templates の UI に依らない部分。TemplateImportTests と同じ組み合わせ） -->
    <Compile Include="..\..\src\Packaging\Collect\PackagingRules.cs;..\..\src\Packaging\Collect\AssetPathUtil.cs;..\..\src\Packaging\Collect\AssetPackagingSettings.cs;..\..\src\Packaging\Collect\AssetReferenceScanner.cs;..\..\src\Packaging\Collect\CSharpCommentSpans.cs;..\..\src\Packaging\Collect\AssetCollectionResult.cs;..\..\src\Packaging\Collect\AssetCollector.cs">
      <Link>Linked\Packaging\%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\..\src\Templates\TemplateCategoryNames.cs;..\..\src\Templates\TemplateEntry.cs;..\..\src\Templates\TemplateLibrary.cs;..\..\src\Templates\TemplateLibraryMetadata.cs;..\..\src\Templates\TemplateImportPlan.cs;..\..\src\Templates\TemplateImporter.cs">
      <Link>Linked\Templates\%(Filename)%(Extension)</Link>
    </Compile>

    <!-- テストランナーは SpriteRigTests のものを共有する（同じ仕組みを二重に持たない） -->
    <Compile Include="..\SpriteRigTests\TestHarness.cs">
      <Link>Linked\TestHarness.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
