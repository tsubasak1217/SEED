<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ヒエラルキーツリー差分更新（HierarchyTreeSync）の単体テスト。

    守りたい不変条件:
      同期後、位置 i の UI 項目は必ず nodes[i] に束ね直されている。
      これが崩れると「ヒエラルキーで A をクリックすると B がインスペクタに出る」
      という不具合になる（行が古い DFS ID を握ったまま残るため）。

    AiSafetyTests / SpriteRigTests と同じ流儀:
      外部パッケージを足さず、素のコンソールアプリ + 自前アサートで回す。
      SEEDEditor 本体（WPF / WinExe）は参照せず、WPF 非依存のファイルだけをリンクで取り込む
      （HierarchyTreeSync.cs が WPF 型を使い始めたらここでビルドが壊れ、設計崩れの検知器になる）。

    実行方法: dotnet run （project=editor/tests/HierarchySyncTests）
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SEEDEditor.Tests.HierarchySync</RootNamespace>
    <AssemblyName>HierarchySyncTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- テスト対象（WPF 非依存の純粋ロジック） -->
    <Compile Include="..\..\src\Panels\Hierarchy\HierarchyTreeSync.cs">
      <Link>Linked\Panels\Hierarchy\HierarchyTreeSync.cs</Link>
    </Compile>
    <!-- テストランナー（SpriteRigTests と共用） -->
    <Compile Include="..\SpriteRigTests\TestHarness.cs">
      <Link>Linked\TestHarness.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
