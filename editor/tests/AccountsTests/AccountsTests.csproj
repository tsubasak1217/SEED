<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SEED アカウント（editor/src/Accounts/）の単体テスト。

    VersionControlTests / ProjectSystemTests と同じ流儀:
      - xunit 等を足さず、素のコンソールアプリ + 自前アサート（SpriteRigTests/TestHarness.cs）
      - SEEDEditor 本体（WPF / WinExe）は参照せず、必要なファイルだけをリンクで取り込む

    既定では実サーバは要らない。発行窓口は HttpListener で立てた偽物（FakeAuthGateway）で、
    本番ポート（41337 / 41339 / 41350）には一切触れない。

    環境変数 SEED_ACCOUNTS_TEST_SERVER があるときだけ、実サーバとの結合テスト
    （ServerIntegrationTests / AccountsServerFixture）も走る。そちらは
    tools/seed-loreserver の debug ビルドを Lore 41357 / 41359、窓口 41361 で起動する。
    詳しくは docs/editor_accounts.md の 4.0 節。

    TargetFramework が net9.0-windows なのは DPAPI（ProtectedData）を使うため。
    net9.0 のままだと [SupportedOSPlatform("windows")] の呼び出しが CA1416 になる。
    WPF は使わない（UseWPF を立てない）。

    LoreVcs を参照しているのは LoreNativeBackend をリンクしているため
    （トークンがあるとき共通引数の Identity が空になることを、実際のバックエンドで確かめる）。
    Lore の呼び出しそのものは行わないが、RuntimeIdentifier が無いと
    ネイティブ lorelib.dll が出力に入らず、将来テストを足したときに落ちるので付けておく。

    実行方法（XML コメント内に連続ハイフンは書けないので [DD] を "‐‐" と読み替える）:
      dotnet run [DD]project editor/tests/AccountsTests
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SEEDEditor.Tests.Accounts</RootNamespace>
    <AssemblyName>AccountsTests</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LoreVcs" Version="0.9.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="4.7.0" />
  </ItemGroup>

