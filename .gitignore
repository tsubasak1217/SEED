# =========================
# 派生データキャッシュ（モデル/テクスチャの BC 圧縮・即ロード形式）
# assets 外・{project}/cache に生成される。元ファイルから再生成可能なため追跡しない。
# =========================
/cache/

# =========================
# ログ・一時ファイル
# =========================
*.log
*.tmp
*.temp

# =========================
# その他
# =========================
*.bak
*.swp
*~

# =========================
# エディタ設定
# =========================
editor/settings/
# netcoredbg デバッガのバイナリ（サイズ大・各自配置）
/tools/netcoredbg/

# ランタイムのモデルキャッシュ（生成物。コミット禁止）
runtime/cache/

# アセット: テキスト系(シーン/JSON/anim/sprite_mesh等)は追跡する。
# 重いバイナリ(画像/モデル/音声/キャッシュ)のみ除外(実体は D:\SEED_assets、junction参照)
runtime/assets/**/*.png
runtime/assets/**/*.jpg
runtime/assets/**/*.jpeg
runtime/assets/**/*.tga
runtime/assets/**/*.bmp
runtime/assets/**/*.gif
runtime/assets/**/*.hdr
runtime/assets/**/*.exr
runtime/assets/**/*.webp
runtime/assets/**/*.dds
runtime/assets/**/*.ktx2
runtime/assets/**/*.glb
runtime/assets/**/*.gltf
runtime/assets/**/*.bin
runtime/assets/**/*.fbx
runtime/assets/**/*.obj
runtime/assets/**/*.max
runtime/assets/**/*.usda
runtime/assets/**/*.smd1
runtime/assets/**/*.smdl
runtime/assets/**/*.wav
runtime/assets/**/*.mp3
runtime/assets/**/*.ogg
runtime/assets/**/*.flac
runtime/assets/**/*.tcover
runtime/assets/**/*.tvox
runtime/assets/project_settings.json
runtime/assets/**/*.blend
runtime/assets/**/*.zip

# =========================
# プロジェクト（projects/<Name>/）とテンプレートライブラリ（templates/）
#   テキスト系（.seedproj / scene / actor / anim / json / cs / wgsl 等）は追跡する。
#   重いバイナリ（画像/モデル/音声/地形ボクセル/フォント/アーカイブ）は除外（実体はローカルのみ）。
#   実行時・パッケージ化の生成物（cache/ save/ logs/ build/）は追跡しない。
# =========================
projects/**/*.png
projects/**/*.jpg
projects/**/*.jpeg
projects/**/*.tga
projects/**/*.bmp
projects/**/*.gif
projects/**/*.hdr
projects/**/*.exr
projects/**/*.webp
projects/**/*.dds
