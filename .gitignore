# =========================
# 派生データキャッシュ（モデル/テクスチャの BC 圧縮・即ロード形式）
# assets 外・{project}/cache に生成される。元ファイルから再生成可能なため追跡しない。
# =========================
/cache/

# =========================
# ログ・一時ファイル
# =========================
*.log
*.tmp
*.temp

# =========================
# その他
# =========================
*.bak
*.swp
*~

# =========================
# エディタ設定
# =========================
editor/settings/
# netcoredbg デバッガのバイナリ（サイズ大・各自配置）
/tools/netcoredbg/

# =========================
# プロジェクト（projects/<Name>/）とテンプレートライブラリ（templates/）
#   テキスト系（.seedproj / scene / actor / anim / json / cs / wgsl 等）は追跡する。
#   重いバイナリ（画像/モデル/音声/地形ボクセル/フォント/アーカイブ）は除外（実体はローカルのみ）。
#   実行時・パッケージ化の生成物（cache/ save/ logs/ build/）は追跡しない。
# =========================
projects/**/*.png
projects/**/*.jpg
projects/**/*.jpeg
projects/**/*.tga
projects/**/*.bmp
projects/**/*.gif
projects/**/*.hdr
projects/**/*.exr
projects/**/*.webp
projects/**/*.dds
projects/**/*.ktx2
projects/**/*.glb
projects/**/*.gltf
projects/**/*.bin
projects/**/*.fbx
projects/**/*.obj
projects/**/*.max
projects/**/*.usda
projects/**/*.smd1
projects/**/*.smdl
projects/**/*.wav
projects/**/*.mp3
projects/**/*.ogg
projects/**/*.flac
projects/**/*.tcover
projects/**/*.tvox
projects/**/*.blend
projects/**/*.blend1
