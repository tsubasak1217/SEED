CMakeFiles/
CMakeCache.txt
cmake-build-*/
compile_commands.json

# =========================
# Rust
# =========================
target/

# =========================
# 派生データキャッシュ（モデル/テクスチャの BC 圧縮・即ロード形式）
# assets 外・{project}/cache に生成される。元ファイルから再生成可能なため追跡しない。
# =========================
/cache/

# =========================
# ログ・一時ファイル
# =========================
*.log
*.tmp
*.temp

# =========================
# その他
# =========================
*.bak
*.swp
*~

# =========================
# エディタ設定
# =========================
editor/settings/
# netcoredbg デバッガのバイナリ（サイズ大・各自配置）
/tools/netcoredbg/

# =========================
# ゲームプロジェクト（<Name>.seedproj + assets/ + plugins/）はこのリポジトリの外で管理する
#   （例: D:\SEED_projects\WarashibeFishing。バージョン管理はエンジンとは別系統 = Lore を予定。
#   docs/project_system.md「既存ゲームの移行記録」参照）。
#   誤ってリポジトリ内に作られたプロジェクトを追跡しないよう projects/ は丸ごと除外する。
# =========================
projects/

# =========================
# テンプレートライブラリ（templates/）
#   テキスト系（scene / actor / anim / json / cs / wgsl 等）は追跡する。
#   重いバイナリ（画像/モデル/音声/地形ボクセル/フォント/アーカイブ）は除外（実体はローカルのみ）。
# =========================
templates/**/*.png
templates/**/*.jpg
templates/**/*.jpeg
templates/**/*.tga
templates/**/*.bmp
templates/**/*.gif
templates/**/*.hdr
templates/**/*.exr
templates/**/*.webp
templates/**/*.dds
templates/**/*.ktx2
templates/**/*.glb
templates/**/*.gltf
templates/**/*.bin
templates/**/*.fbx
templates/**/*.obj
templates/**/*.max
templates/**/*.usda
templates/**/*.smd1
templates/**/*.smdl
templates/**/*.wav
templates/**/*.mp3
templates/**/*.ogg
templates/**/*.flac
templates/**/*.tcover
templates/**/*.tvox
templates/**/*.blend
templates/**/*.blend1
templates/**/*.zip
templates/**/*.ttf
templates/**/*.otf

# =========================
# セーブデータ（ゲーム進行の永続化。開発者ごとのローカル状態なので追跡しない）
# エディタ Play 時の保存先は projects/<Name>/save/save.json（save/path.rs の規約。上の projects/*/save/ で除外）
# =========================
*.json.tmp

# =========================
# シーン保存の安全機構（データ損失対策）
#   .backup/  … 上書き保存の直前に退避した .scene / .actor などの世代バックアップ
#   *.lock    … エディタが開いているシーンを示すロック（プロセス固有・共有しない）
#   *.tmp     … 原子的置換の途中ファイル（正常時は残らない）
# =========================
.backup/
*.scene.lock
*.scene.tmp
*.actor.tmp
