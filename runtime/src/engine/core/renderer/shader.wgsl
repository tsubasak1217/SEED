// ============================================================
// shader.wgsl  —  単純三角形の描画シェーダ
//
// このシェーダはハードコードされた3頂点の位置データを使って
// 単色の三角形をクリップ空間に描画する。
// 頂点バッファは使用せず、vertex_index で配列を参照する。
// ============================================================

// ------------------------------------------------------------
// 頂点位置テーブル（クリップ空間座標、NDC）
//
// wgpu / WebGPU のクリップ空間は以下の仕様:
//   X: -1.0（左）〜 +1.0（右）
//   Y: -1.0（下）〜 +1.0（上）
//   Z:  0.0（近）〜 +1.0（遠）
//
// 各頂点の配置:
//   [0] ( 0.0,  0.5)  → 上中央
//   [1] (-0.5, -0.5)  → 左下
//   [2] ( 0.5, -0.5)  → 右下
//
// `var<private>` はシェーダステージ内でのみ参照されるプライベート変数。
// ------------------------------------------------------------
var<private> POSITIONS: array<vec2<f32>, 3> = array<vec2<f32>, 3>(
    vec2<f32>( 0.0,  0.5),
    vec2<f32>( 0.5, -0.5),
    vec2<f32>(-0.5, -0.5),
);

// ------------------------------------------------------------
// 頂点シェーダ: vs_main
//
// CPU 側の `render_pass.draw(0..3, 0..1)` により
// vertex_index = 0, 1, 2 の順で 3 回呼び出される。
//
// @builtin(vertex_index): GPU が自動的に供給する頂点インデックス。
//   頂点バッファを使わない場合もこの組み込み値で位置配列を参照できる。
//
// 戻り値 @builtin(position):
//   クリップ空間の同次座標 vec4<f32>(x, y, z, w)。
//   z = 0.0（奥行きなし）、w = 1.0（遠近除算なし）を指定する。
// ------------------------------------------------------------
@vertex
fn vs_main(@builtin(vertex_index) in_vertex_index: u32) -> @builtin(position) vec4<f32> {
    let pos = POSITIONS[in_vertex_index];
    // z=0.0（深度バッファ最前面）、w=1.0（遠近変換なし）
    return vec4<f32>(pos, 0.0, 1.0);
}

// ------------------------------------------------------------
// フラグメントシェーダ: fs_main
//
// ラスタライザが生成した各フラグメント（ピクセル候補）に対して呼ばれる。
// 現在は全ピクセルを固定色（オレンジ系）で塗りつぶす。
//
// @location(0): 出力先のカラーアタッチメントスロット 0（Surface テクスチャ）。
//
// 出力色 RGBA:
//   R=1.0, G=0.5, B=0.2, A=1.0  →  オレンジ色（不透明）
//   ※ sRGB サーフェス使用時は GPU が自動的にリニア→sRGB 変換を行う。
// ------------------------------------------------------------
@fragment
fn fs_main() -> @location(0) vec4<f32> {
    return vec4<f32>(1.0, 0.5, 0.2, 1.0);
}
