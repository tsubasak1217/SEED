// ============================================================
//  fullscreen.wgsl — フルスクリーン三角形 頂点シェーダ（ポスト共通）
//
//  頂点バッファ不要。@builtin(vertex_index) から画面全体を覆う 1 枚の
//  大三角形（3 頂点）を生成する。全ポストプロセスパス（トーンマップ・
//  ビネット等）が共通で連結して使う。
//
//  出力 uv は左上原点 [0,1]（画面上端 = uv.y 0）。
// ============================================================

/// フルスクリーンパスの頂点出力。
struct FsOut {
    @builtin(position) clip_pos: vec4<f32>,
    @location(0)       uv:       vec2<f32>,
}

/// 3 頂点で画面全体を覆う大三角形を生成する。
///   vi=0 → uv(0,0) clip(-1, 1)   （左上）
///   vi=1 → uv(2,0) clip( 3, 1)   （右方外）
///   vi=2 → uv(0,2) clip(-1,-3)   （下方外）
/// 交差部分（画面矩形）だけがラスタライズされる。
@vertex
fn fs_vs(@builtin(vertex_index) vi: u32) -> FsOut {
    var out: FsOut;
    // uv.x: 0,2,0 / uv.y: 0,0,2
    let x = f32((vi << 1u) & 2u);
    let y = f32(vi & 2u);
    out.uv = vec2<f32>(x, y);
    // clip: uv*2-1、Y を反転して uv.y=0 を画面上端（clip.y=+1）に対応させる。
    out.clip_pos = vec4<f32>(x * 2.0 - 1.0, 1.0 - y * 2.0, 0.0, 1.0);
    return out;
}
