// ============================================================
// velocity_math.wgsl — 速度バッファ（モーションベクタ）の純関数
//
// ## 役割（単一責任）
// 「2 本のクリップ座標からスクリーンスペース速度を作る」純関数と定数だけを持つ。
// **バインディングを一切宣言しない**（前フレーム行列のバインディングは
// velocity_common.wgsl 側）。どの MRT へ書くか（ロケーション）は各 G-Buffer
// 書き込みシェーダの責務。
//
// ## なぜバインディングと分けているのか
// プロシージャル草（grass_gbuffer.wgsl）は前フレームのインスタンス行列を必要と
// しない（静的扱い＝カメラ由来の速度のみ）。バインディング付きのファイルを
// 連結させると、草のパイプラインに使わない group 4 が生えてしまう。
// pbr_common.wgsl を shader_common.wgsl から分離したのと同じ理由・同じ流儀。
//
// ## 速度の定義（**このファイルが正典**）
//   velocity = curr_uv - prev_uv
// すなわち「**前フレーム → 今フレーム** のピクセル移動量」を
// **ビューポート正規化 UV**（左上 (0,0) / 右下 (1,1)）で表したもの。
// ピクセル単位が要るときは消費側がビューポートの幅・高さを掛ける。
//
// TAA が前フレームの色を引くときは符号を反転して使う
// （`prev_uv = curr_uv - velocity`）。モーションブラーは velocity 方向へ
// そのままサンプルを伸ばせばよい。
//
// ## なぜ NDC ではなく UV なのか
// NDC は Y 軸が上向き、テクスチャ UV は下向きで、消費側が必ずどこかで
// 反転を入れることになる。生成時に一度だけ UV 系へ揃えておけば、
// 消費側（TAA / モーションブラー / L3 合成）は反転を意識せずに済む。
// ============================================================

// ============================================================
//  速度の計算（純関数）
// ============================================================

/// クリップ座標を「ビューポート正規化 UV」へ落とす。
///
/// 透視除算はフラグメント段（＝補間後）で行う必要があるため、本関数は
/// **フラグメントシェーダからのみ**呼ぶこと。
///
/// NDC の Y は上向き・UV の Y は下向きなので Y だけ符号を反転する。
fn clip_to_screen_uv(clip: vec4<f32>) -> vec2<f32> {
    // w が 0 近傍（カメラ平面上）だと 0 除算になるため下駄を履かせる。
    // 実際にラスタライズされるフラグメントの w は必ず near 以上で、
    // この下駄が結果に効くことはない（NaN/Inf をバッファへ焼かないための保険）。
    let w = max(abs(clip.w), CLIP_W_EPSILON) * sign_or_one(clip.w);
    let ndc = clip.xy / w;
    return vec2<f32>(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
}

/// 0 を +1 として扱う符号関数（`sign()` は 0 のとき 0 を返してしまうため）。
fn sign_or_one(x: f32) -> f32 {
    return select(-1.0, 1.0, x >= 0.0);
}

/// クリップ座標 2 本からスクリーンスペース速度（UV 移動量）を作る。
///
/// 戻り値は速度 MRT（`Rg16Float`）へそのまま書く値。
/// 移動量の絶対値は `VELOCITY_MAX_UV` でクランプする: 半精度浮動小数の
/// 表現範囲（±65504）自体は十分広いが、カメラのテレポートや極端な近接時に
/// 画面数十枚ぶんの値が出ると消費側（TAA の履歴参照）がキャッシュを暴れさせる。
/// 「画面 1 枚ぶんを超える移動は履歴が存在しないのと同義」なので、
/// 生成側で頭打ちにしておくのが安全側。
fn compute_velocity_uv(curr_clip: vec4<f32>, prev_clip: vec4<f32>) -> vec2<f32> {
    let v = clip_to_screen_uv(curr_clip) - clip_to_screen_uv(prev_clip);
    return clamp(v, vec2<f32>(-VELOCITY_MAX_UV), vec2<f32>(VELOCITY_MAX_UV));
}

/// クリップ w の 0 除算保護に使う下限値。
const CLIP_W_EPSILON: f32 = 1e-6;

/// 速度の絶対値クランプ（ビューポート正規化 UV）。1.0 = 画面 1 枚ぶんの移動。
const VELOCITY_MAX_UV: f32 = 1.0;
