// ============================================================
//  postfx_common.wgsl — ポストプロセス共通ヘルパー（バインディング無し）
//
//  ## 役割（単一責任）
//  ポストプロセスの各パスが共有する「値の健全化」ユーティリティだけを置く。
//  バインディング・エントリポイントは一切持たないため、どのパスにも安全に連結できる。
//
//  ## なぜ HDR の健全化が必要か
//  シーン HDR（Rgba16Float）には **非有限値（±Inf / NaN）が混入し得る**。
//  代表例は HDR パノラマ（.hdr / .exr）の太陽ディスクで、f32 では 1e5〜1e6 級の値が入る。
//  これが f16 の有限域（65504）を超えると Inf になり、
//
//    Inf → ブルームしきい値抽出の `Inf/Inf` → **NaN**
//        → ダウンサンプル 13-tap / アップサンプル tent で **矩形状に** ミップ鎖へ拡散
//        → 合成後のトーンマップが NaN を出力 → 表示は 0（＝**黒い矩形**）
//
//  という経路で「明るい空（太陽）の周りに黒い四角が出る」不具合になる。
//  発生源（テクスチャデコード側）でも潰すが、**発光マテリアル・強い点光源・
//  0 除算を含むカスタムシェーディング**など他の混入経路もあるため、
//  ブルームとトーンマップの入口で必ず健全化する（1 ピクセルあたり数命令で、
//  非有限値が「画面の広い領域を黒く塗り潰す」災害を構造的に防げる）。
// ============================================================

/// HDR 値として許容する有限の最大値。
///
/// f16（Rgba16Float）の有限最大 65504 に合わせる。これより大きな値は
/// 表現できず Inf になるため、シェーダ内でもここを上限として扱う。
const POSTFX_HDR_MAX_FINITE: f32 = 65504.0;

/// HDR 色を必ず有限な範囲へ落とす（NaN → 0 / ±Inf・域外 → ±有限最大）。
///
/// `x != x` は NaN 判定のイディオム（NaN は自分自身と等しくない）。WGSL の
/// `clamp` は NaN 入力の結果が未定義なので、**先に** NaN を除いてからクランプする。
fn postfx_sanitize_hdr(c: vec3<f32>) -> vec3<f32> {
    // NaN を 0 へ置換（select の第 3 引数が true のとき第 2 引数を採る）。
    let no_nan = select(c, vec3<f32>(0.0, 0.0, 0.0), c != c);
    // ±Inf・域外の巨大値を有限最大へクランプ。
    return clamp(
        no_nan,
        vec3<f32>(-POSTFX_HDR_MAX_FINITE, -POSTFX_HDR_MAX_FINITE, -POSTFX_HDR_MAX_FINITE),
        vec3<f32>( POSTFX_HDR_MAX_FINITE,  POSTFX_HDR_MAX_FINITE,  POSTFX_HDR_MAX_FINITE),
    );
}
