                "autoStart": "false",
                "cameraDirector": "MainCamera",
                "entries": "[{\"speaker\": \"\", \"text\": \"――水面が、ゆっくりと持ち上がっていく。\\r\\n釣り上げたそれは、小屋よりも大きかった。\", \"cameraTarget\": \"StoryCam_Kaiju\", \"cameraMode\": \"Lerp\", \"lerpDuration\": 1.2, \"onStart\": [], \"onEnd\": []}, {\"speaker\": \"テバ\", \"text\": \"……マジで釣りやがった。\", \"cameraTarget\": \"\", \"cameraMode\": \"Cut\", \"lerpDuration\": 0.0, \"onStart\": [], \"onEnd\": []}, {\"speaker\": \"ササミ\", \"text\": \"はぁ……はぁ……。\\r\\nな、なんですかこれ……！？\", \"cameraTarget\": \"StoryCam_Player\", \"cameraMode\": \"Lerp\", \"lerpDuration\": 0.9, \"onStart\": [], \"onEnd\": []}, {\"speaker\": \"テバ\", \"text\": \"俺が唯一釣れなかったアイツを……\\r\\nお前さん、たった今釣り上げやがったんだぞ。\", \"cameraTarget\": \"StoryCam_Owner\", \"cameraMode\": \"Lerp\", \"lerpDuration\": 0.9, \"onStart\": [], \"onEnd\": []}, {\"speaker\": \"テバ\", \"text\": \"こいつぁこの島のヌシだ。\\r\\n何十年も、誰にも釣らせやしなかった。\", \"cameraTarget\": \"\", \"cameraMode\": \"Cut\", \"lerpDuration\": 0.0, \"onStart\": [], \"onEnd\": []}, {\"speaker\": \"ササミ\", \"text\": \"……ヌシ。\\r\\nじゃあこれ、食べていいんですか？\", \"cameraTarget\": \"StoryCam_Player\", \"cameraMode\": \"Lerp\", \"lerpDuration\": 0.9, \"onStart\": [], \"onEnd\": []}]",
