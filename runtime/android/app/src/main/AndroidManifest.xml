<?xml version="1.0" encoding="utf-8"?>
<!--
  SEED ランタイム（段階0）の AndroidManifest。全体像は docs/android.md。

  ・Vulkan 1.1 必須（wgpu の Vulkan バックエンドを使う。0x401000 = Vulkan 1.1）
  ・Activity は 1 つだけ（GameActivity 派生の MainActivity）
  ・allowNativeHeapPointerTagging="false" … arm64 の Android 11 以降で bionic がヒープポインタの上位バイトに付けるタグ（TBI）を
    止める。同梱 .NET（CoreCLR / Mono）はタグ付きポインタで coreclr_initialize 中に SIGSEGV になる（実機 Pixel 6a で確認。
    docs/android.md §11.4・§17）。ランタイムも CLR の起動直前に mallopt で同じ無効化を行う（二重の対策）。
  ・android:label="${seedAppLabel}" … ランチャーに出る名前。プロジェクト設定の android.app_name（無ければプロジェクトの表示名）から
    ビルド時に決まる（app/build.gradle.kts。値が無ければ @string/app_name = SEED Runtime。docs/android.md §18）。
  ・android:icon="${seedAppIcon}" … ランチャーのアイコン。プロジェクト設定の android.icon があれば SeedAndroid が生成した
    @mipmap/ic_launcher（各密度の mipmap とアダプティブアイコン）、無ければシステムの既定のアイコン（docs/android.md §24）。
  ・android:enableOnBackInvokedCallback="false" … targetSdk 36（Android 16）で既定になった予測型の「戻る」を使わない。
    使うと Android 16 以降の端末で KEYCODE_BACK がアプリへ届かなくなり、戻るキー → Escape（スクリプトの
    Input.GetKeyDown(KeyCode.Escape)。docs/android.md §14.5）が効かなくなるため（公式の一時的な回避。§24）。
  ・android:appCategory="${seedAppCategory}" … アプリの分類。プロジェクト設定の android.app_category からビルド時に決まる
    （app/build.gradle.kts の語彙の表。無ければ game＝従来の固定値。W1-2・docs/android.md §25.10）。game は Android 16 の
    「大画面で向き・サイズ変更の制限を無視する」変更の対象外にもなる（それ以外の分類では大画面で制限が無視される）。
  ・PlatformProvider（android:process=":seed_platform"）… アプリのプラットフォーム機能（SEED.Platform）の Java だけの別プロセスの窓口
    （W1-1。docs/android.md §25）。W1-2 の決定で全プロジェクトに常設のまま: :seed_platform のプロセスは最初の接続（スクリプトが
    SEED.Platform を初めて呼んだとき）まで起動しないので、使わないゲームには影響せず、android.features が空でもスクリプトの
    Platform.IsSupported が実機で一貫する。権限・受信機・サービス・MainActivity の intent-filter は機能ごとの断片
    （android.features → SeedAndroid が生成する src/seedFeatures/AndroidManifest.xml。E-04）で出し入れする。
  ・activity-alias PlatformEntry（exported=false・targetActivity=MainActivity）… プラットフォーム層の PendingIntent だけが通る
    起動の入口（W1-4a。docs/android.md §25.12）。PlatformProvider と同じく常設。
  ・VIBRATE … 触感（SEED.Platform の Haptics.Tap / Vibrate。W1-6）と目覚ましの鳴動の振動（RingVibration。W1-4a）。normal 権限
    （インストール時に自動で許可され、利用者への確認も Google Play の申告も無い）で、ゲームの触感にも使うので機能（android.features）に
    よらず常設する（W1-6 で機能 alarm の権限から移した。docs/android.md §25.10・§25.15）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x401000"
        android:required="true" />

    <!-- 触感と鳴動の振動（W1-6 から常設。上の説明）。 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:allowNativeHeapPointerTagging="false"
        android:appCategory="${seedAppCategory}"
        android:enableOnBackInvokedCallback="false"
        android:icon="${seedAppIcon}"
        android:label="${seedAppLabel}"
        android:theme="@style/Theme.SeedRuntime">

        <!--
          screenOrientation … 画面の向き。プロジェクト設定の screen_orientation からビルド時に決まる
            （app/build.gradle.kts の変換表 → manifestPlaceholders の seedScreenOrientation）。
            both=fullSensor（縦横 4 方向に追従）/ portrait=sensorPortrait / landscape=sensorLandscape。
          configChanges … 回転・画面サイズ・キーボード等の構成変更で Activity を作り直させない。
            作り直されると onDestroy → プロセス終了（MainActivity のコメント参照）になってしまうため、
            起こり得る構成変更は広めに列挙してある。変更はネイティブ側へ Resized 等で通知される。
          launchMode="singleTask" … Activity を 1 インスタンスに保つ（起動し直しても既存を前面へ出す）。
            2 つ目のインスタンスができると android_main が同一プロセスで再度呼ばれ、winit の
            EventLoop を作り直せずに終了するため。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="${seedScreenOrientation}"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|fontWeightAdjustment|locale|layoutDirection|colorMode|touchscreen|mcc|mnc">

            <!-- GameActivity が onCreate で読み込むネイティブライブラリ名（libSEED.so）。 -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="SEED" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          PlatformEntry … 信頼できる起動の入口（W1-4a。docs/android.md §25.12）。:seed_platform が作る Activity 行きの PendingIntent
          （目覚ましのフルスクリーン通知・鳴動の通知のタップと「開く」・ステータスバーの目覚ましの印）はすべてこの別名を通る。
          exported=false なので他のアプリは起動できず、MainActivity（platform/LaunchReason）は起動の Intent の部品名がこの別名の
          ときだけ extras の起動理由を信用する（W1-P6。リリース版でも取れ、偽造できない）。W1-1 の PlatformProvider と同じく
          機能によらず常設（exported=false で intent-filter も無いので、使わないゲームには何も起きない）。
          meta-data の android.app.lib_name … GameActivity は起動の Intent の部品（＝この別名）の ActivityInfo から lib_name を読み、
          無ければ libmain.so を探して IllegalArgumentException で落ちる（games-activity 4.4.0 の GameActivity.onCreate を javap で
          確かめた）。別名は対象の meta-data を受け継がない見込み（推論）なので、MainActivity と同じ値をここにも置く。
        -->
        <activity-alias
            android:name=".platform.PlatformEntry"
            android:exported="false"
            android:targetActivity=".MainActivity">

            <meta-data
                android:name="android.app.lib_name"
                android:value="SEED" />
        </activity-alias>

        <!--
          プラットフォーム機能の同期の命令の窓口（Java だけの別プロセス :seed_platform。W1-1）。
          authorities はアプリ ID ごとに変わる（${applicationId} は Gradle が置き換える。Java の PlatformContract.authority と一致）。
          exported=false … 同じアプリのプロセスからだけ呼べる（メインプロセスの PlatformConnection が ContentProviderClient.call で呼ぶ）。
        -->
        <provider
            android:name=".platform.service.PlatformProvider"
            android:authorities="${applicationId}.seed_platform"
            android:exported="false"
            android:process=":seed_platform" />
    </application>

</manifest>
