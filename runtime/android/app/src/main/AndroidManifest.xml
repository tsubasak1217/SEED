<?xml version="1.0" encoding="utf-8"?>
<!--
  SEED ランタイム（段階0）の AndroidManifest。全体像は docs/android.md。

  ・Vulkan 1.1 必須（wgpu の Vulkan バックエンドを使う。0x401000 = Vulkan 1.1）
  ・Activity は 1 つだけ（GameActivity 派生の MainActivity）
  ・allowNativeHeapPointerTagging="false" … arm64 の Android 11 以降で bionic がヒープポインタの上位バイトに付けるタグ（TBI）を
    止める。同梱 .NET（CoreCLR / Mono）はタグ付きポインタで coreclr_initialize 中に SIGSEGV になる（実機 Pixel 6a で確認。
    docs/android.md §11.4・§17）。ランタイムも CLR の起動直前に mallopt で同じ無効化を行う（二重の対策）。
  ・android:label="${seedAppLabel}" … ランチャーに出る名前。プロジェクト設定の android.app_name（無ければプロジェクトの表示名）から
    ビルド時に決まる（app/build.gradle.kts。値が無ければ @string/app_name = SEED Runtime。docs/android.md §18）。
  ・android:icon="${seedAppIcon}" … ランチャーのアイコン。プロジェクト設定の android.icon があれば SeedAndroid が生成した
    @mipmap/ic_launcher（各密度の mipmap とアダプティブアイコン）、無ければシステムの既定のアイコン（docs/android.md §24）。
  ・android:enableOnBackInvokedCallback="false" … targetSdk 36（Android 16）で既定になった予測型の「戻る」を使わない。
    使うと Android 16 以降の端末で KEYCODE_BACK がアプリへ届かなくなり、戻るキー → Escape（スクリプトの
    Input.GetKeyDown(KeyCode.Escape)。docs/android.md §14.5）が効かなくなるため（公式の一時的な回避。§24）。
  ・android:appCategory="game" … ゲームとして分類する。Android 16 の「大画面で向き・サイズ変更の制限を無視する」変更の対象外にもなる。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x401000"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:allowNativeHeapPointerTagging="false"
        android:appCategory="game"
        android:enableOnBackInvokedCallback="false"
        android:icon="${seedAppIcon}"
        android:label="${seedAppLabel}"
        android:theme="@style/Theme.SeedRuntime">

        <!--
          screenOrientation … 画面の向き。プロジェクト設定の screen_orientation からビルド時に決まる
            （app/build.gradle.kts の変換表 → manifestPlaceholders の seedScreenOrientation）。
            both=fullSensor（縦横 4 方向に追従）/ portrait=sensorPortrait / landscape=sensorLandscape。
          configChanges … 回転・画面サイズ・キーボード等の構成変更で Activity を作り直させない。
            作り直されると onDestroy → プロセス終了（MainActivity のコメント参照）になってしまうため、
            起こり得る構成変更は広めに列挙してある。変更はネイティブ側へ Resized 等で通知される。
          launchMode="singleTask" … Activity を 1 インスタンスに保つ（起動し直しても既存を前面へ出す）。
            2 つ目のインスタンスができると android_main が同一プロセスで再度呼ばれ、winit の
            EventLoop を作り直せずに終了するため。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="${seedScreenOrientation}"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|fontWeightAdjustment|locale|layoutDirection|colorMode|touchscreen|mcc|mnc">

            <!-- GameActivity が onCreate で読み込むネイティブライブラリ名（libSEED.so）。 -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="SEED" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
