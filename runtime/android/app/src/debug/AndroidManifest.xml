<?xml version="1.0" encoding="utf-8"?>
<!--
  デバッグ版の APK だけに足すマニフェスト（Gradle が debug のビルドで src/main/AndroidManifest.xml と合わせる。段階D-1）。

  ・INTERNET … エディタとの IPC（一時停止・再開など）のため、ランタイムが 127.0.0.1:<ポート> で TCP を待ち受ける
    （runtime/src/engine/core/app_base/ipc_transport/tcp.rs）。Android はループバックでも AF_INET のソケットに
    この権限が要る（無いと bind が Permission denied）。待ち受けは 127.0.0.1 だけで、PC からは adb forward だけが届く。
    ポートはエディタ／SeedAndroid が起動オプション（am start の extra seed.ipc_port）で渡し、起動オプションは
    デバッグ版の APK でしかネイティブへ渡らない（MainActivity）。配布版（release）には入らない。
  詳細は docs/android.md §21。

  ・DebugPlatformReceiver … プラットフォーム機能（SEED.Platform）を adb から確かめる受信機（W1-1。docs/android.md §25）。
    adb の am broadcast から届くよう exported=true（intent-filter は持たせない。暗黙の放送は届かないので -n で部品を指定する）。
    メインプロセスで動き、ping の往復の計測と試験イベントの送出、目覚ましの予約・取り消し・鳴動の停止と照会（W1-4b。
    SCHEDULE / CANCEL_ALL / STOP_RINGING / GET_RINGING / LIST）を行う。配布版（release）には入らない。
    directBootAware ではないので、再起動の後の最初のロック解除の前は届かない。
    送り手に android.permission.DUMP を求める（W1-7）。DUMP は保護の段階が signature|privileged|development で、adb の shell
    （uid 2000）は持つが普通のアプリは持てない（development は adb の pm grant でしか与えられない）。exported=true のままでも、
    端末に入った他のアプリからは目覚ましの予約・停止を送れない（W1-4b の backlog「デバッグ受信機が他アプリから予約・停止できる」）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <receiver
            android:name="com.seedengine.runtime.platform.DebugPlatformReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>

</manifest>
